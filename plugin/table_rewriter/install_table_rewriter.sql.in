CREATE DATABASE IF NOT EXISTS query_rewrite;

CREATE TABLE IF NOT EXISTS query_rewrite.table_rewrite_rules (
  db VARCHAR(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL,
  table_name VARCHAR(128) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL,
  table_name_new VARCHAR(5000) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL,
  PRIMARY KEY (db, table_name)
) DEFAULT CHARSET = utf8mb4 ENGINE = INNODB;

INSTALL PLUGIN table_rewriter SONAME 'table_rewriter.${DYNLIB_EXTENSION}';
CREATE FUNCTION load_table_rewriter_rules RETURNS STRING
SONAME 'table_rewriter.${DYNLIB_EXTENSION}';

DELIMITER //

CREATE PROCEDURE query_rewrite.flush_table_rewriter()
BEGIN
  DECLARE message_text VARCHAR(100);
  COMMIT;
  SELECT load_table_rewriter_rules() INTO message_text;
  IF NOT message_text IS NULL THEN
    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = message_text;
  END IF;
END //

DELIMITER ;

CREATE TRIGGER `add_rule` AFTER INSERT
  ON query_rewrite.table_rewrite_rules FOR EACH ROW
    SET global table_rewriter_add_rule=CONCAT_WS(',', NEW.db, NEW.table_name, NEW.table_name_new);

CREATE TRIGGER `del_rule` AFTER DELETE
  ON query_rewrite.table_rewrite_rules FOR EACH ROW
    SET global table_rewriter_del_rule=CONCAT_WS(',', OLD.db, OLD.table_name);

CREATE TRIGGER `del_rule` AFTER UPDATE
  ON query_rewrite.table_rewrite_rules FOR EACH ROW
    SET global table_rewriter_del_rule=CONCAT_WS(',', OLD.db, OLD.table_name),
               table_rewriter_add_rule=CONCAT_WS(',', NEW.db, NEW.table_name, NEW.table_name_new);

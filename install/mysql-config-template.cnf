[mysql]
prompt="instance_name \\R:\\m:\\s>"
[client]
port        = change_port_before_use
socket      = prod_dir/mysql.sock

# Here follows entries for some specific programs

# The MySQL server
[mysqld]
basedir = install_path

# required unique id between 1 and 2^32 - 1
# defaults to 1 if master-host is not set
# but will not function as a master if omitted
bind_address    = change_ip_before_use
port      = change_port_before_use
report-host=change_ip_before_use
extra_port = change_extra_port_before_use

socket      = prod_dir/mysql.sock
pid-file    = prod_dir/mysql.pid

server-id=   change_server_id_before_use
#replicate-same-server-id=1 #in circle master,may be dead loop 

plugin-dir=base_dir/lib/mysql/plugin

user=change_user_before_use

datadir     = data_dir


#log dir is=log_dir
log-bin  = log_bin_arg/binlog.log
relay-log = log_relay/relay.log
log-error = log_dir/mysqld.err


# Point the following paths to a dedicated disk
tmpdir		= server_data_prefix/log/server_port/dblogs/tmp

binlog_format=row

default-storage-engine = innodb
lc-messages-dir     = base_dir/share
character-set-server = utf8
collation-server = utf8_bin

# Uncomment the following if you are using InnoDB tables
innodb_data_home_dir = server_data_prefix/server_port/dbdata_raw/dbdata
innodb_data_file_path = ibdata1:2000M:autoextend
innodb_log_group_home_dir = server_data_prefix/log/server_port/dblogs/arch
innodb_data_home_dir = innodb_dir
innodb_log_group_home_dir = log_arch
tmpdir = tmp_dir

performance_schema=off
enforce_gtid_consistency = ON
gtid_mode = ON
skip-slave-start 

#sql_log_bin = ON

plugin-dir = install_path/lib/mysql/plugin
plugin_load = "rpl_semi_sync_master=semisync_master.so;rpl_semi_sync_slave=semisync_slave.so"
loose_rpl_semi_sync_master_enabled = 1
loose_rpl_semi_sync_slave_enabled = 1
xa_commit_lock_wait_timeout = 3600

#always do semi-sync wait when executing 'xa prepare' after the binlog file is synced, regardless of the rpl_semi_sync_master_wait_point setting.
rpl_semi_sync_master_xa_sync_wait=ON
rpl_semi_sync_master_timeout=4294967296 # 2^32, max value, to always wait. actually will wait for about 100 days.
rpl_semi_sync_master_wait_for_slave_count=1 # using default, but still set it in case it changes in future versions.
rpl_semi_sync_master_wait_no_slave=1 ## using default, but still set it in case it changes in future versions.
# after one ack wait timeout, following waits will still wait same amount of time, rather than skip the wait.
rpl_semi_sync_keep_waiting_on_timeout=1

binlog_checksum=NONE
default_tmp_storage_engine=innodb
innodb_data_file_path=ibdata1:2G:autoextend
innodb_empty_free_list_algorithm=legacy
innodb_flush_method=O_DIRECT
innodb_large_prefix=OFF
innodb_log_compressed_pages=OFF
innodb_stats_auto_recalc=OFF
innodb_stats_persistent=OFF
innodb_strict_mode=OFF
innodb_thread_sleep_delay=0

innodb_buffer_pool_size = 1073741824 
innodb_buffer_pool_instances = 64
innodb_log_buffer_size = 268435456
join_buffer_size = 2097152
read_rnd_buffer_size = 2097152
sort_buffer_size = 2097152
read_buffer_size = 2097152
key_buffer_size = 134217728
table_open_cache = 147931

innodb_purge_threads = 16
innodb_read_io_threads = 16
innodb_write_io_threads = 16
innodb_lock_wait_timeout = 4
max_connections = 4096
extra_max_connections   =   32

innodb_flush_neighbors  =   0
innodb_io_capacity  =   10000
innodb_io_capacity_max  =   20000
innodb_lock_wait_timeout    =   50
innodb_log_files_in_group   =   4
innodb_log_file_size    =   1073741824
innodb_max_dirty_pages_pct  =   70
innodb_max_purge_lag    =   500000
innodb_open_files   =   100000
innodb_purge_batch_size =   1000
innodb_thread_concurrency   =   64
innodb_thread_sleep_delay   =   21061
innodb_adaptive_hash_index_parts = 256
innodb_doublewrite=1
innodb_lru_scan_depth=8192


skip_name_resolve=on
lock_wait_timeout   =   5
long_query_time =   1
lower_case_table_names  =   1
max_allowed_packet  =   1073741824
max_binlog_size =   104857600
max_connect_errors  =   2000
max_heap_table_size =   33554432
max_relay_log_size  =   104857600
metadata_locks_hash_instances   =   128
myisam_sort_buffer_size =   4194304
open_files_limit    =   300000
query_alloc_block_size  =   16384
query_cache_size    =   0
query_prealloc_size =   24576
slave_net_timeout   =   3600
log_slave_updates=on
slave_parallel_type=logical_clock
slave_parallel_workers=64
innodb_io_capacity  =10000                    
innodb_io_capacity_max  =20000 
innodb_open_files=100000
innodb_sync_array_size=64
sync_master_info    =   0
sync_relay_log  =   0
sync_relay_log_info =   0
table_definition_cache  =   400
table_open_cache    =   147931
thread_cache_size   =   8
thread_pool_max_threads =   2000
thread_pool_oversubscribe   =   10
thread_pool_stall_limit =   50
thread_stack    =   196608
thread_handling =   2
tmp_table_size  =   33554432

!include  base_dir/etc/frominstall_my_change_port_before_use.ini
!include  base_dir/etc/add_my_change_port_before_use.ini

# Remove leading # to set options mainly useful for reporting servers.
# The server defaults are faster for transactions and fast SELECTs.
# Adjust sizes as needed, experiment to find the optimal values.
# join_buffer_size = 128M
# sort_buffer_size = 2M
# read_rnd_buffer_size = 2M 

sql_mode=NO_ENGINE_SUBSTITUTION,STRICT_TRANS_TABLES


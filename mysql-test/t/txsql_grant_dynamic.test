#
# Privilege to grant dynamic privilege to others is granted if the user
# either has super user privileges (currently UPDATE_ACL on mysql.*) or
# if the user has a GRANT_OPTION on the specific dynamic privilege he
# wants to grant.
#
# on the specific dynamic privilege can't grant privilege to others.
#
connect (con1,localhost,root,,);
# create some users with different privileges
create user 'test_user1'@'localhost';
create user 'test_user2'@'localhost';
show grants for 'test_user1'@'localhost';
show grants for 'test_user2'@'localhost';
connect (con2,localhost,test_user1,,);

connection con1;

connection con2;
echo ## should fail;
error ER_SPECIFIC_ACCESS_DENIED_ERROR;
grant system_variables_admin on *.* to 'test_user1'@'localhost';
error ER_SPECIFIC_ACCESS_DENIED_ERROR;
grant session_variables_admin on *.* to 'test_user1'@'localhost';
error ER_SPECIFIC_ACCESS_DENIED_ERROR;
grant system_variables_admin on *.* to 'test_user2'@'localhost';
error ER_SPECIFIC_ACCESS_DENIED_ERROR;
grant session_variables_admin on *.* to 'test_user2'@'localhost';
error ER_SPECIFIC_ACCESS_DENIED_ERROR;
set session sql_log_bin=OFF;

connection con1;
grant all privileges on *.* to 'test_user1'@'localhost';
show grants for 'test_user1'@'localhost';
flush privileges;

disconnect con2;
connect (con2,localhost,test_user1,,);

connection con2;
echo ## should success;
grant system_variables_admin on *.* to 'test_user1'@'localhost';
grant session_variables_admin on *.* to 'test_user1'@'localhost';
grant system_variables_admin on *.* to 'test_user2'@'localhost';
grant session_variables_admin on *.* to 'test_user2'@'localhost';

set session sql_log_bin=OFF;
let SEARCH_FILE= $MYSQLTEST_VARDIR/log/mysqld.1.err;
let SEARCH_PATTERN= SESSION variable sql_log_bin has been updated to 'OFF';
set session sql_log_bin=ON;

connection con1;
revoke system_variables_admin on *.* from 'test_user1'@'localhost';
revoke session_variables_admin on *.* from 'test_user1'@'localhost';
revoke system_variables_admin on *.* from 'test_user2'@'localhost';
revoke session_variables_admin on *.* from 'test_user2'@'localhost';
show grants for 'test_user1'@'localhost';
show grants for 'test_user2'@'localhost';
flush privileges;

disconnect con2;
connect (con2,localhost,test_user1,,);

connection con2;
echo ## should success, because test_user1 has UPDATE privilege on mysql.*;
grant system_variables_admin on *.* to 'test_user1'@'localhost';
grant session_variables_admin on *.* to 'test_user1'@'localhost';
grant system_variables_admin on *.* to 'test_user2'@'localhost';
grant session_variables_admin on *.* to 'test_user2'@'localhost';

connection con1;
revoke system_variables_admin on *.* from 'test_user1'@'localhost';
revoke session_variables_admin on *.* from 'test_user1'@'localhost';
revoke system_variables_admin on *.* from 'test_user2'@'localhost';
revoke session_variables_admin on *.* from 'test_user2'@'localhost';
show grants for 'test_user1'@'localhost';
show grants for 'test_user2'@'localhost';
flush privileges;

disconnect con2;
connect (con2,localhost,test_user1,,);

connection con2;
grant system_variables_admin on *.* to 'test_user1'@'localhost';
grant session_variables_admin on *.* to 'test_user1'@'localhost';
grant system_variables_admin on *.* to 'test_user2'@'localhost';
grant session_variables_admin on *.* to 'test_user2'@'localhost';

connection con1;
revoke update on *.* from 'test_user1'@'localhost';
show grants for 'test_user1'@'localhost';
flush privileges;

disconnect con2;
connect (con2,localhost,test_user1,,);

connection con2;
echo ## should fail because no UPDATE privilege on mysql.*;
error ER_SPECIFIC_ACCESS_DENIED_ERROR;
grant system_variables_admin on *.* to 'test_user1'@'localhost';
error ER_SPECIFIC_ACCESS_DENIED_ERROR;
grant session_variables_admin on *.* to 'test_user1'@'localhost';
error ER_SPECIFIC_ACCESS_DENIED_ERROR;
grant system_variables_admin on *.* to 'test_user2'@'localhost';
error ER_SPECIFIC_ACCESS_DENIED_ERROR;
grant session_variables_admin on *.* to 'test_user2'@'localhost';

connection con1;
revoke system_variables_admin on *.* from 'test_user1'@'localhost';
revoke session_variables_admin on *.* from 'test_user1'@'localhost';
revoke system_variables_admin on *.* from 'test_user2'@'localhost';
revoke session_variables_admin on *.* from 'test_user2'@'localhost';
grant system_variables_admin on *.* to 'test_user1'@'localhost' with grant option;
grant session_variables_admin on *.* to 'test_user1'@'localhost' with grant option;
show grants for 'test_user1'@'localhost';
show grants for 'test_user2'@'localhost';
flush privileges;

disconnect con2;
connect (con2,localhost,test_user1,,);

connection con2;
echo ## should success because test_user1 has specific privileges;
grant system_variables_admin on *.* to 'test_user2'@'localhost';
grant session_variables_admin on *.* to 'test_user2'@'localhost';
show grants for 'test_user2'@'localhost';

connection con1;
revoke system_variables_admin on *.* from 'test_user2'@'localhost';
revoke session_variables_admin on *.* from 'test_user2'@'localhost';
grant update on mysql.* to 'test_user1'@'localhost';
show grants for 'test_user2'@'localhost';
flush privileges;

disconnect con2;
connect (con2,localhost,test_user1,,);

connection con2;
grant system_variables_admin on *.* to 'test_user2'@'localhost';
grant session_variables_admin on *.* to 'test_user2'@'localhost';
show grants for 'test_user2'@'localhost';
## cleanup

connection con1;

connection default;

disconnect con1;
disconnect con2;

drop user 'test_user1'@'localhost';
drop user 'test_user2'@'localhost';

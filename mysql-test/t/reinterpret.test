
# prepare table
CREATE TABLE t1 (salary float);
CREATE TABLE t2 (salary double);
CREATE TABLE t3 (salary decimal(30, 10));
CREATE TABLE t4 (salary int);
CREATE TABLE t5 (salary varchar(60));

INSERT INTO t1 values(123.156251);
INSERT INTO t1 values(-123.156251);
INSERT INTO t1 values(123.156251411);
INSERT INTO t1 values(-123.156251411);

INSERT INTO t2 values(123.156251);
INSERT INTO t2 values(-123.156251);
INSERT INTO t2 values(123.156251411);
INSERT INTO t2 values(-123.156251411);

INSERT INTO t3 values(123.156251);
INSERT INTO t3 values(-123.156251);
INSERT INTO t3 values(123.156251411);
INSERT INTO t3 values(-123.156251411);

INSERT INTO t4 values(123);
INSERT INTO t4 values(-123);

INSERT INTO t5 values('123');
INSERT INTO t5 values('-123');

# REINTERPRET to int
SELECT salary, CONV(HEX(salary), 16, 10), REINTERPRET_INT(salary, 0, 4) from t1;
SELECT salary, CONV(HEX(salary), 16, 10), REINTERPRET_INT(salary, 0, 8) from t1;

SELECT salary, CONV(HEX(salary), 16, 10), REINTERPRET_INT(salary, 0, 4) from t2;
SELECT salary, CONV(HEX(salary), 16, 10), REINTERPRET_INT(salary, 0, 8) from t2;

--error ER_WRONG_ARGUMENTS
SELECT REINTERPRET_INT(salary, 0, 4) from t3;
--error ER_WRONG_ARGUMENTS
SELECT REINTERPRET_INT(salary, 0, 8) from t3;

SELECT salary, CONV(HEX(salary), 16, 10), REINTERPRET_INT(salary, 0, 4) from t4;
SELECT salary, CONV(HEX(salary), 16, 10), REINTERPRET_INT(salary, 0, 8) from t4;

SELECT salary, CONV(HEX(salary), 16, 10), REINTERPRET_INT(salary, 0, 4) from t5;
SELECT salary, CONV(HEX(salary), 16, 10), REINTERPRET_INT(salary, 0, 8) from t5;

# REINTERPRET to uint
SELECT salary, CONV(HEX(salary), 16, 10), REINTERPRET_INT(salary, 1, 4) from t1;
SELECT salary, CONV(HEX(salary), 16, 10), REINTERPRET_INT(salary, 1, 8) from t1;

SELECT salary, CONV(HEX(salary), 16, 10), REINTERPRET_INT(salary, 1, 4) from t2;
SELECT salary, CONV(HEX(salary), 16, 10), REINTERPRET_INT(salary, 1, 8) from t2;

--error ER_WRONG_ARGUMENTS
SELECT REINTERPRET_INT(salary, 1, 4) from t3;
--error ER_WRONG_ARGUMENTS
SELECT REINTERPRET_INT(salary, 1, 8) from t3;

SELECT salary, CONV(HEX(salary), 16, 10), REINTERPRET_INT(salary, 1, 4) from t4;
SELECT salary, CONV(HEX(salary), 16, 10), REINTERPRET_INT(salary, 1, 8) from t4;

SELECT salary, CONV(HEX(salary), 16, 10), REINTERPRET_INT(salary, 1, 4) from t5;
SELECT salary, CONV(HEX(salary), 16, 10), REINTERPRET_INT(salary, 1, 8) from t5;

# push warnings if reinterpret more than 8 bytes
SELECT REINTERPRET_INT(salary, 1, 10) from t5;

# geometry not supported
--error ER_WRONG_ARGUMENTS
SELECT REINTERPRET_INT(ST_GeomCollFromText("MULTILINESTRING((10 10, 11 11), (9 9, 10 10))"), 0, 4);
--error ER_WRONG_ARGUMENTS
SELECT REINTERPRET_INT(ST_GeomCollFromText("MULTILINESTRING((10 10, 11 11), (9 9, 10 10))"), 0, 8);
--error ER_WRONG_ARGUMENTS
SELECT REINTERPRET_INT(ST_GeomCollFromText("MULTILINESTRING((10 10, 11 11), (9 9, 10 10))"), 1, 4);
--error ER_WRONG_ARGUMENTS
SELECT REINTERPRET_INT(ST_GeomCollFromText("MULTILINESTRING((10 10, 11 11), (9 9, 10 10))"), 1, 8);

DROP TABLE t1;
DROP TABLE t2;
DROP TABLE t3;
DROP TABLE t4;
DROP TABLE t5;

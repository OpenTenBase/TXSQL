--source include/have_debug.inc

create user 'testuser'@'localhost';
connect (testuser, localhost, testuser,'', );
connection testuser;

--echo === check the system variabels for root only ===
--error ER_SPECIFIC_ACCESS_DENIED_ERROR
select @@innodb_async_drop_tmp_dir;
--error ER_SPECIFIC_ACCESS_DENIED_ERROR
set global innodb_async_drop_tmp_dir= @@global.datadir;
--error ER_SPECIFIC_ACCESS_DENIED_ERROR
set global innodb_table_drop_mode= 'async_drop';
--error ER_SPECIFIC_ACCESS_DENIED_ERROR
set global innodb_async_truncate_size = 256;
--error ER_SPECIFIC_ACCESS_DENIED_ERROR
set global innodb_async_table_size = 4096;

--echo #connect user=root
connect (con_root, localhost, root,'', );
--connection con_root
disconnect testuser;
drop user 'testuser'@'localhost';

let $MYSQLD_TMPDIR = `select @@global.datadir`;
let $MYSQLD_DATADIR = `select @@global.datadir`;

--error ER_GLOBAL_VARIABLE
set session innodb_async_drop_tmp_dir= @@global.datadir;

--echo == now try to check table with small size ==
set global innodb_table_drop_mode= 'rename_only';
set global innodb_async_drop_tmp_dir= @@global.datadir;

let $DROP_TMPDIR = `select @@innodb_async_drop_tmp_dir`;
if ($DROP_TMPDIR != $MYSQLD_TMPDIR)
{
  die Failed to set innodb_async_drop_tmp_dir;
}

use test;
create table t(a int);

drop table t;
--echo here should NOT see any file
--exec if [ -f $MYSQLD_DATADIR/test/t.ibd ]; then echo "[ERROR]Found .ibd"; else echo "no .ibd"; fi;
--exec if [ -f $DROP_TMPDIR/._test_t.trh* ]; then echo "[ERROR]Found .trh"; else echo "no .trh"; fi;

set global debug='+d,ib_set_big_table';
set global debug='+d,ib_before_row_truncate_file';

--echo === now try to set global innodb_table_drop_mode and innodb_async_drop_tmp_dir ===
use test;
create table at(a int);

set global innodb_table_drop_mode= 'async_drop';
set global innodb_async_drop_tmp_dir= @@global.datadir;

let $DROP_TMPDIR = `select @@innodb_async_drop_tmp_dir`;
if ($DROP_TMPDIR != $MYSQLD_TMPDIR)
{
  die Failed to set innodb_async_drop_tmp_dir;
}

drop table at;
--echo here should see trash file
--exec if [ -f $MYSQLD_DATADIR/test/at.ibd ]; then echo "[ERROR]Found .ibd"; else echo "no .ibd"; fi;
--exec if [ -f $DROP_TMPDIR/._test_at.trh* ]; then echo "Found .trh"; else echo "error no .trh"; fi;
--exec sleep 3
--echo here should NOT see trash file
--exec if [ -f $MYSQLD_DATADIR/test/at.ibd ]; then echo "[ERROR]Found .ibd"; else echo "no .ibd"; fi;
--exec if [ -f $DROP_TMPDIR/._test_at.trh* ]; then echo "[ERROR]Found .trh"; else echo "no .trh"; fi;

--echo === now change the param dynamically ===
create table bt(a int);
insert into bt values(1),(2);
drop table bt;
--echo get a warning while setting innodb_async_drop_tmp_dir since truncate task list isn't empty
set global innodb_async_drop_tmp_dir= @@global.datadir;
show warnings;
--echo here should see trash file
--exec if [ -f $MYSQLD_DATADIR/test/bt.ibd ]; then echo "[ERROR]Found .ibd"; else echo "no .ibd"; fi;
--exec if [ -f $DROP_TMPDIR/._test_bt.trh* ]; then echo "Found .trh"; else echo "error no .trh"; fi;
--exec sleep 3
--echo here should NOT see trash file
--exec if [ -f $MYSQLD_DATADIR/test/bt.ibd ]; then echo "[ERROR]Found .ibd"; else echo "no .ibd"; fi;
--exec if [ -f $DROP_TMPDIR/._test_bt.trh* ]; then echo "[ERROR]Found .trh"; else echo "no .trh"; fi;

--echo === now check truncate size and table_size ===
--error ER_GLOBAL_VARIABLE
set session innodb_async_truncate_size= 256;
set global innodb_async_truncate_size= 256;
select @@innodb_async_truncate_size;
--error ER_GLOBAL_VARIABLE
set session innodb_async_table_size= 4096;
set global innodb_async_table_size= 4096;
select @@innodb_async_table_size;

--echo === now check innodb_table_drop_mode ===
create table ct(a int);
insert into ct values(1),(2);
--echo set innodb_table_drop_mode to sync_drop
set global innodb_table_drop_mode= 'sync_drop';
drop table ct;
--echo here should NOT see trash file
--exec if [ -f $MYSQLD_DATADIR/test/ct.ibd ]; then echo "[ERROR]Found .ibd"; else echo "no .ibd"; fi;
--exec if [ -f $DROP_TMPDIR/._test_ct.trh* ]; then echo "[ERROR]Found .trh"; else echo "no .trh"; fi;
--exec sleep 3
--echo here should NOT see trash file
--exec if [ -f $MYSQLD_DATADIR/test/ct.ibd ]; then echo "[ERROR]Found .ibd"; else echo "no .ibd"; fi;
--exec if [ -f $DROP_TMPDIR/._test_ct.trh* ]; then echo "[ERROR]Found .trh"; else echo "no .trh"; fi;

--echo set global innodb_table_drop_mode rename_only
create table dt(a int);
insert into dt values(1),(2);
set global innodb_table_drop_mode= 'rename_only';
drop table dt;
--echo here should see trash file
--exec if [ -f $MYSQLD_DATADIR/test/dt.ibd ]; then echo "[ERROR]Found .ibd"; else echo "no .ibd"; fi;
--exec if [ -f $DROP_TMPDIR/._test_dt.trh* ]; then echo "Found .trh"; else echo "error no .trh"; fi;
--exec sleep 3
--echo here should STILL see trash file
--exec if [ -f $MYSQLD_DATADIR/test/dt.ibd ]; then echo "[ERROR]Found .ibd"; else echo "no .ibd"; fi;
--exec if [ -f $DROP_TMPDIR/._test_dt.trh* ]; then echo "Found .trh"; else echo "error no .trh"; fi;

--echo set global innodb_table_drop_mode async_drop, the trash file left by dt table should also be cleaned
create table et(a int);
insert into et values(1),(2);
set global innodb_table_drop_mode= 'async_drop';
drop table et;
--echo here should see trash file
--exec if [ -f $DROP_TMPDIR/._test_dt.trh* ]; then echo "Found .trh"; else echo "no .trh"; fi;
--exec if [ -f $MYSQLD_DATADIR/test/et.ibd ]; then echo "[ERROR]Found .ibd"; else echo "no .ibd"; fi;
--exec if [ -f $DROP_TMPDIR/._test_et.trh* ]; then echo "Found .trh"; else echo "no .trh"; fi;
--exec sleep 6
--echo here should NOT see trash file
--exec if [ -f $DROP_TMPDIR/._test_dt.trh* ]; then echo "[ERROR]Found .trh"; else echo "no .trh"; fi;
--exec if [ -f $MYSQLD_DATADIR/test/et.ibd ]; then echo "[ERROR]Found .ibd"; else echo "no .ibd"; fi;
--exec if [ -f $DROP_TMPDIR/._test_et.trh* ]; then echo "[ERROR]Found .trh"; else echo "no .trh"; fi;

--echo === now check async table status ===
show status like "%async_drop_table%counts%";

--echo === now check adding orphaned trash file when start ===
--exec fallocate -l 2m $DROP_TMPDIR/._test_at.trh.1
--exec fallocate -l 2m $DROP_TMPDIR/._test_bt.trh.1
--replace_result $DROP_TMPDIR DROP_TMPDIR
--let $restart_parameters=restart: --innodb-table-drop-mode=async_drop --innodb-async-drop-tmp-dir=$DROP_TMPDIR
--source include/restart_mysqld.inc
--sleep 3
--echo here should NOT see trash file
--exec if [ -f $DROP_TMPDIR/._test_* ]; then echo "[ERROR]Found .trh"; else echo "no .trh"; fi;

--echo === now check adding left trash file when set innodb_async_drop_tmp_dir to new dir ===
--exec fallocate -l 2m $MYSQLD_DATADIR/._test_at.trh.1
--exec fallocate -l 2m $MYSQLD_DATADIR/._test_bt.trh.1
set global innodb_async_drop_tmp_dir= @@global.datadir;
--sleep 3
--echo here should NOT see trash file
--exec if [ -f $MYSQLD_DATADIR/._test_* ]; then echo "[ERROR]Found .trh"; else echo "no .trh"; fi;

set global debug='-d,ib_set_big_table';
set global debug='-d,ib_before_row_truncate_file';

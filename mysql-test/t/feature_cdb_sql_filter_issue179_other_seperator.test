show grants;
connect(conn_tencent,localhost,tencentroot,,);
select user();

show cdb_sql_filters;
select * from information_schema.cdb_sql_filter_info;

set global cdb_sql_filter = "+SELECT~1~1~value";
--error ER_CDB_SQL_FILTER_WRONG_VALUE
set global cdb_sql_filter = "+SELECT~1~1";
--error ER_CDB_SQL_FILTER_WRONG_VALUE
set global cdb_sql_filter = "+SELECT~1~1~";
--error ER_CDB_SQL_FILTER_WRONG_VALUE
set global cdb_sql_filter = "+SELECT~1~1~~~";
--error ER_CDB_SQL_FILTER_WRONG_VALUE
set global cdb_sql_filter = "+SELECT~~1~1~value";
--error ER_CDB_SQL_FILTER_WRONG_VALUE
set global cdb_sql_filter = "+SELECT~1~~1~value";
set global cdb_sql_filter = "+UPDATE~1~1~value";
set global cdb_sql_filter = "+INSERT~1~1~value";
set global cdb_sql_filter = "+DELETE~1~1~value";
set global cdb_sql_filter = "+REPLACE~1~1~value";
--error ER_CDB_SQL_FILTER_WRONG_VALUE
set global cdb_sql_filter = "+REPLACE~0~1~value";
set global cdb_sql_filter = "+REPLACE~-1~1~value";
--error ER_CDB_SQL_FILTER_WRONG_VALUE
set global cdb_sql_filter = "+REPLACE~-2~1~value";
--error ER_CDB_SQL_FILTER_WRONG_VALUE
set global cdb_sql_filter = "+REPLACE~1~0~value";
set global cdb_sql_filter = "+REPLACE~1~-1~value";
--error ER_CDB_SQL_FILTER_WRONG_VALUE
set global cdb_sql_filter = "+REPLACE~1~-2~value";
--error ER_CDB_SQL_FILTER_WRONG_VALUE
set global cdb_sql_filter = "+REPLACE~-2~0~value";
--error ER_CDB_SQL_FILTER_WRONG_VALUE
set global cdb_sql_filter = "+REPLACE~0~-2~value";
--error ER_CDB_SQL_FILTER_WRONG_VALUE
set global cdb_sql_filter = "+REPLACE~2147483648~1~value";
set global cdb_sql_filter = "+REPLACE~2147483647~1~value";
--error ER_CDB_SQL_FILTER_WRONG_VALUE
set global cdb_sql_filter = "+REPLACE~1~2147483648~value";
set global cdb_sql_filter = "+REPLACE~1~2147483647~value";
--error ER_CDB_SQL_FILTER_WRONG_VALUE
set global cdb_sql_filter = "+REPLACE~aaa~2147483648~value";
--error ER_CDB_SQL_FILTER_WRONG_VALUE
set global cdb_sql_filter = "+REPLACE~1~aaa~value";
--error ER_CDB_SQL_FILTER_WRONG_VALUE
set global cdb_sql_filter = "+RPLACE~1~1~value";
--error ER_CDB_SQL_FILTER_WRONG_VALUE
set global cdb_sql_filter = "+~1~aaa~value";
set global cdb_sql_filter = "+SELECT~1~1~~value~~value~~";

--replace_column 6 # 7 # 8 #
show cdb_sql_filters;
--replace_column 6 # 7 # 8 #
select * from information_schema.cdb_sql_filter_info;

set global cdb_sql_filter = "-1";
--replace_column 6 # 7 # 8 #
show cdb_sql_filters;
--replace_column 6 # 7 # 8 #
select * from information_schema.cdb_sql_filter_info;
--error ER_CDB_SQL_FILTER_WRONG_VALUE
set global cdb_sql_filter = "-1";
--error ER_CDB_SQL_FILTER_WRONG_VALUE
set global cdb_sql_filter = "-0";
--error ER_CDB_SQL_FILTER_WRONG_VALUE
set global cdb_sql_filter = "--1";
--error ER_CDB_SQL_FILTER_WRONG_VALUE
set global cdb_sql_filter = "-23123132321321321312";
--error ER_CDB_SQL_FILTER_WRONG_VALUE
set global cdb_sql_filter = "-dsadsadasdsa";

--error ER_CDB_SQL_FILTER_WRONG_VALUE
set global cdb_sql_filter = "reset";
set global cdb_sql_filter = "reset_all";
#should empty
show cdb_sql_filters;

#test expire time
set global cdb_sql_filter = "+SELECT~5~1~value";
create user 'xx'@'%';
grant all on test.* to 'xx'@'%';
create table test(id int, value1 int, value2 int, value3 int);
insert into test values(1,1,1,1);
begin;
select * from test for update;

connect(conn_xx1,localhost,xx,,);
--send select value1 from test lock in share mode;

connection conn_tencent;
let $wait_condition=select count(*)=1 from information_schema.processlist where info like '%value%' and info not like '%processlist%';
--source include/wait_condition.inc

connect(conn_xx2,localhost,xx,,);
--error ER_CDB_SQL_FILTER_REJECT
select value2 from test lock in share mode;

connection conn_tencent;
commit;

connection conn_xx1;
--reap

connection default;
--sleep 5
#filter rule expired
--replace_column 6 # 7 #
show cdb_sql_filters;

connection conn_tencent;
begin;
select * from test for update;

connection conn_xx1;
--send select value1 from test lock in share mode;

connection conn_xx2;
--send select value2 from test lock in share mode;

connection conn_tencent;
let $wait_condition=select count(*)=2 from information_schema.processlist where info like '%value%' and info not like '%processlist%';
--source include/wait_condition.inc
commit;

connection conn_xx1;
--reap

connection conn_xx2;
--reap

connection conn_tencent;
set global cdb_sql_filter = "reset_all";

#test concurrence
set global cdb_sql_filter = "+UPDATE~-1~2~value";
set global cdb_sql_filter = "+DELETE~-1~2~value";
set global cdb_sql_filter = "+INSERT~-1~2~value";
set global cdb_sql_filter = "+REPLACE~-1~2~value";

##test update
begin;
select * from test for update;

connection conn_xx1;
--send update test set value1 = 0;

connection conn_xx2;
--send update test set value2 = 0;

connection conn_tencent;
let $wait_condition=select count(*)=2 from information_schema.processlist where info like '%update%' and info not like '%processlist%';
--source include/wait_condition.inc

connect(conn_xx3,localhost,xx,,);
--error ER_CDB_SQL_FILTER_REJECT
update test set value3 = 0;
--error ER_CDB_SQL_FILTER_REJECT
update test set value3 = 0;
--error ER_CDB_SQL_FILTER_REJECT
update test set value3 = 0;
--error ER_CDB_SQL_FILTER_REJECT
update test set value3 = 0;

connection conn_tencent;
commit;

connection conn_xx1;
--reap
connection conn_xx2;
--reap

##test delete
connection conn_tencent;
let $wait_condition=select count(*)=0 from information_schema.processlist where info like '%update%' and info not like '%processlist%';
--source include/wait_condition.inc
begin;
select * from test for update;

connection conn_xx1;
--send delete from test where value1 = 9;
connection conn_xx2;
--send delete from test where value2 = 9;

connection conn_tencent;
let $wait_condition=select count(*)=2 from information_schema.processlist where info like '%delete%' and info not like '%processlist%';
--source include/wait_condition.inc

connection conn_xx3;
--error ER_CDB_SQL_FILTER_REJECT
delete from test where value3 = 9;
--error ER_CDB_SQL_FILTER_REJECT
delete from test where value3 = 9;
--error ER_CDB_SQL_FILTER_REJECT
delete from test where value3 = 9;

connection conn_tencent;
commit;

connection conn_xx1;
--reap
connection conn_xx2;
--reap

#test insert
connection conn_tencent;
let $wait_condition=select count(*)=0 from information_schema.processlist where info like '%delete%' and info not like '%processlist%';
--source include/wait_condition.inc
begin;
select * from test for update;

connection conn_xx1;
--send insert into test (id) values(1);

connection conn_xx2;
--send insert into test (id) values(1);

connection conn_tencent;
let $wait_condition=select count(*)=2 from information_schema.processlist where info like '%insert%' and info not like '%processlist%';
--source include/wait_condition.inc

connection conn_xx3;
--error ER_CDB_SQL_FILTER_REJECT
insert into test (value3) values(1);
--error ER_CDB_SQL_FILTER_REJECT
insert into test (value3) values(1);
--error ER_CDB_SQL_FILTER_REJECT
insert into test (value3) values(1);

connection conn_tencent;
commit;

connection conn_xx1;
--reap
connection conn_xx2;
--reap

#test replace
connection conn_tencent;
let $wait_condition=select count(*)=0 from information_schema.processlist where info like '%insert%' and info not like '%processlist%';
--source include/wait_condition.inc
begin;
select * from test for update;

connection conn_xx1;
--send replace into test (id) values(1);

connection conn_xx2;
--send replace into test (id) values(1);

connection conn_tencent;
let $wait_condition=select count(*)=2 from information_schema.processlist where info like '%replace%' and info not like '%processlist%';
--source include/wait_condition.inc

connection conn_xx3;
--error ER_CDB_SQL_FILTER_REJECT
replace into test (value3) values(1);
--error ER_CDB_SQL_FILTER_REJECT
replace into test (value3) values(1);
--error ER_CDB_SQL_FILTER_REJECT
replace into test (value3) values(1);

connection conn_tencent;
commit;

connection conn_xx1;
--reap

connection conn_xx2;
--reap

connection conn_tencent;
let $wait_condition=select count(*)=0 from information_schema.processlist where info like '%replace%' and info not like '%processlist%';
--source include/wait_condition.inc
--replace_column 6 # 7 #
show cdb_sql_filters;

#test multipul key words:
connection conn_tencent;
insert into test (id) values(1);
set global cdb_sql_filter = "reset_all";
set global cdb_sql_filter = "+SELECT~-1~2~value3";
set global cdb_sql_filter = "+SELECT~-1~1~value1~value2";
begin;
select * from test for update;

connection conn_xx1;
--send select value3,value1,value2 from test lock in share mode;

connection conn_xx3;
let $wait_condition=select count(*)=1 from information_schema.processlist where info like '%value1%' and info not like '%processlist%';
--source include/wait_condition.inc

connection conn_tencent;
--replace_column 6 # 7 #
show cdb_sql_filters;

connection conn_xx2;
--error ER_CDB_SQL_FILTER_REJECT
select value3,value1,value2 from test lock in share mode;
--send select value3 from test lock in share mode

connection conn_tencent;
let $wait_condition=select count(*)=2 from information_schema.processlist where info like '%value3%'and info not like '%processlist%';
--source include/wait_condition.inc

connection conn_xx3;
--error ER_CDB_SQL_FILTER_REJECT 
select value3 from test lock in share mode;

connection conn_tencent;
commit;

connection conn_xx1;
--reap;

connection conn_xx2;
--reap;

#test no concurrence
connection conn_tencent;
set global cdb_sql_filter = "+SELECT~-1~-1~value2~value3";
begin;
select * from test for update;

connection conn_xx1;
--error ER_CDB_SQL_FILTER_REJECT
select value2,value3 from test;
--error ER_CDB_SQL_FILTER_REJECT
select value1,value2,value3 from test;

connection conn_xx2;
--send select value1,value2 from test lock in share mode;

connection conn_tencent;
let $wait_condition=select count(*)=1 from information_schema.processlist where info like '%value2%'and info not like '%processlist%';
--source include/wait_condition.inc

connection conn_xx3;
--error ER_CDB_SQL_FILTER_REJECT
select value1,value2 from test lock in share mode;

connection conn_tencent;
commit;

connection conn_xx2;
--reap

--replace_column 6 # 7 #
connection conn_tencent;
show cdb_sql_filters;
set global cdb_sql_filter = 'reset_all';

connection default;
drop table test;
drop user 'xx'@'%';

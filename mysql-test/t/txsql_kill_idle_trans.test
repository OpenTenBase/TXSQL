--source include/count_sessions.inc

let $saved_txsql_kill_idle_trans_timeout= `SELECT @@txsql_kill_idle_trans_timeout`;

--echo # With a low wait_timeout and high txsql_kill_idle_trans_timeout the lower value takes precedence

SET GLOBAL txsql_kill_idle_trans_timeout= 100000;
SET SESSION wait_timeout= 2;

BEGIN;
sleep 2.5;

--error CR_SERVER_GONE_ERROR
show tables;

--echo # Current connection idle transaction killed, reconnecting
--source include/wait_until_disconnected.inc
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

SET GLOBAL txsql_kill_idle_trans_timeout= 1;

--echo #
--echo # Tests for txsql_kill_idle_trans_timeout feature that do not depend on transactional SEs
--echo #

CREATE TABLE t1 (a INT) ENGINE=MyISAM;
INSERT INTO t1 VALUES (1),(2);
sleep 2;
SELECT * FROM t1;

BEGIN;
INSERT INTO t1 VALUES (3);
sleep 0.5;
SELECT * FROM t1;
sleep 1.5;
--error CR_SERVER_GONE_ERROR
SELECT * FROM t1;

--echo # Current connection idle transaction killed, reconnecting
--source include/wait_until_disconnected.inc
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

DROP TABLE t1;

--echo #
--echo # Test txsql_kill_idle_trans_timeout_timeout feature with InnoDB
--echo #

CREATE TABLE t1 (a INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1),(2);
sleep 2;
SELECT * FROM t1;

BEGIN;
INSERT INTO t1 VALUES (3);
sleep 0.5;
SELECT * FROM t1;
sleep 1.5;
--error CR_SERVER_GONE_ERROR
SELECT * FROM t1;

--echo # Current connection idle transaction killed, reconnecting
--source include/wait_until_disconnected.inc
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--echo #
--echo # Test that row locks are released on idle transaction kill
--echo #

--echo # Take row locks in connection conn1
--connect (conn1,localhost,root,,)
--connection conn1

BEGIN;
SELECT * FROM t1 FOR UPDATE;

--echo # Take row locks in connection default
--connection default
sleep 1.5;
UPDATE t1 SET a=4;
SELECT * FROM t1;

--echo # Show that connection conn1 has been killed
--connection conn1
--error CR_SERVER_GONE_ERROR
SELECT * FROM t1;

--echo # connection default
--disconnect conn1
--connection default

--echo # Cleanup
DROP TABLE t1;
--replace_result $saved_txsql_kill_idle_trans_timeout saved_txsql_kill_idle_trans_timeout
eval SET GLOBAL txsql_kill_idle_trans_timeout= $saved_txsql_kill_idle_trans_timeout;
--source include/wait_until_count_sessions.inc

--source include/have_log_bin.inc
--source include/have_binlog_format_row.inc
--source include/master-slave.inc

--echo #
--echo # recycle bin test
--echo #

call mtr.add_suppression("access __txsql_recycle_bin__ fail, the query string is");

--echo #
--echo # drop temporary table with "drop table" will occur ER_NO_SUCH_TABLE error

connect (con_root_master, localhost, root,,,,$MASTER_MYSOCK);
let $cdb_recycle_bin_enabled_default= `select @@cdb_recycle_bin_enabled`;
set global cdb_recycle_bin_enabled=on;

connect (con_root_slave, localhost, root,,,,$SLAVE_MYSOCK);
set global cdb_recycle_bin_enabled= off;

--echo
--echo #
--echo # drop table with binlog synchronization
--echo #

--echo
--echo # phase1. create table and insert into data
connection master;
let $db=`select database()`;
create table t1 (a int);
insert into t1 values (1);
select * from t1;

create table t2 (a int);
insert into t2 values (1);
select * from t2;

--source include/sync_slave_sql_with_master.inc
select * from t1;
select * from t2;

--echo
--echo # phase2. drop table and select mysql.recycle_bin_info
connection master;
drop table t1;
drop table t2;
--replace_column 1 <RECYCLED_TABLE>  4 <DROP_TIME>  5 <PURGE_TIME>
select * from mysql.recycle_bin_info;
--replace_column 1 <RECYCLED_TABLE>
show tables from __txsql_recycle_bin__;

--source include/sync_slave_sql_with_master.inc
--echo # on slave
--replace_column 1 <RECYCLED_TABLE>  4 <DROP_TIME>  5 <PURGE_TIME>
select * from mysql.recycle_bin_info;
--replace_column 1 <RECYCLED_TABLE>
show tables from __txsql_recycle_bin__;

--echo
--echo # phase3. recovery table t1 from recycle_bin
connection master;
--echo # recycle_table must login root
connection con_root_master;
let $rb_table_name= `select table_name from mysql.recycle_bin_info where origin_table="t1"`;

# the table name in recycle bin is $rb_table_name
--replace_regex /__txsql_.*__/<t1_RECYCLED_TABLE>/
eval call sys.recycle_bin_recycle_table("$rb_table_name");
--replace_column 1 <RECYCLED_TABLE>  4 <DROP_TIME>  5 <PURGE_TIME>
select * from mysql.recycle_bin_info;
--replace_column 1 <RECYCLED_TABLE>
show tables from __txsql_recycle_bin__;

--source include/sync_slave_sql_with_master.inc
--echo # on slave
--replace_column 1 <RECYCLED_TABLE>  4 <DROP_TIME>  5 <PURGE_TIME>
select * from mysql.recycle_bin_info;
--replace_column 1 <RECYCLED_TABLE>
show tables from  __txsql_recycle_bin__;


--echo
--echo # phase4. recovery table t1 from recycle_bin


--echo #
--echo # clear environment
--echo #
connection master;


connection con_root_slave;
eval set global cdb_recycle_bin_enabled=$cdb_recycle_bin_enabled_default;

connection con_root_master;

eval use $db;
set global cdb_recycle_bin_enabled=off;
drop table t1;
set global cdb_recycle_bin_enabled=on;

let $rb_table_name= `select table_name from mysql.recycle_bin_info where origin_table="t2"`;
--replace_regex /__txsql_[0-9]*_[0-9]*__/<RECYCLED_TABLE>/
eval call sys.recycle_bin_purge_table("$rb_table_name");
eval set global cdb_recycle_bin_enabled=$cdb_recycle_bin_enabled_default;

--source include/sync_slave_sql_with_master.inc
--source include/rpl_end.inc

disconnect con_root_master;
disconnect con_root_slave;

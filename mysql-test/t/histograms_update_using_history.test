--echo ##################
--echo # UPDATE HISTOGRAM ... USING HISTORY ...
--echo ##################

let $SAVED_OPTION_ENABLED= `SELECT @@HISTOGRAM_HISTORY_ENABLED;`;
SET GLOBAL HISTOGRAM_HISTORY_ENABLED= 1;

let $SAVED_OPTION_VERSIONS= `SELECT @@HISTOGRAM_HISTORY_VERSIONS_LIMIT;`;
SET GLOBAL HISTOGRAM_HISTORY_VERSIONS_LIMIT= 3;

--echo # Note: Histogram data is identified (hid) by '$."number-of-buckets-specified"' by design.

let $check_online= SELECT JSON_EXTRACT(HISTOGRAM, '$."number-of-buckets-specified"') AS hid FROM information_schema.column_statistics WHERE TABLE_NAME="tbl1" AND COLUMN_NAME="c1";
let $check_history= SELECT JSON_EXTRACT(HISTOGRAM, '$."number-of-buckets-specified"') AS hid FROM mysql.column_statistics_history WHERE TABLE_NAME="tbl1" AND COLUMN_NAME="c1";

CREATE TABLE tbl1(c1 INT);
INSERT INTO tbl1(c1) VALUES(1),(1),(2),(3),(5);

--echo #
--echo # Create 3 history records
--echo #
ANALYZE TABLE tbl1 UPDATE HISTOGRAM ON c1 WITH 1 BUCKETS;
let $histo_ver1= `SELECT JSON_REMOVE(HISTOGRAM, '$."last-updated"') AS HISTOGRAM FROM information_schema.COLUMN_STATISTICS WHERE TABLE_NAME="tbl1" AND COLUMN_NAME="c1";`;
ANALYZE TABLE tbl1 UPDATE HISTOGRAM ON c1 WITH 2 BUCKETS;
let $histo_ver2= `SELECT JSON_REMOVE(HISTOGRAM, '$."last-updated"') AS HISTOGRAM FROM information_schema.COLUMN_STATISTICS WHERE TABLE_NAME="tbl1" AND COLUMN_NAME="c1";`;
ANALYZE TABLE tbl1 UPDATE HISTOGRAM ON c1 WITH 3 BUCKETS;
let $histo_ver3= `SELECT JSON_REMOVE(HISTOGRAM, '$."last-updated"') AS HISTOGRAM FROM information_schema.COLUMN_STATISTICS WHERE TABLE_NAME="tbl1" AND COLUMN_NAME="c1";`;


# Find the version number of each record

let $ver1= `SELECT VERSION FROM mysql.column_statistics_history WHERE TABLE_NAME="tbl1" AND COLUMN_NAME="c1" AND HISTOGRAM->'$."number-of-buckets-specified"'=1;`;
assert($ver1);
assert($histo_ver1 == `SELECT JSON_REMOVE(HISTOGRAM, '$."last-updated"') AS HISTOGRAM FROM mysql.column_statistics_history WHERE VERSION=$ver1`);

let $ver2= `SELECT VERSION FROM mysql.column_statistics_history WHERE TABLE_NAME="tbl1" AND COLUMN_NAME="c1" AND HISTOGRAM->'$."number-of-buckets-specified"'=2;`;
assert($ver2);
assert($histo_ver2 == `SELECT JSON_REMOVE(HISTOGRAM, '$."last-updated"') AS HISTOGRAM FROM mysql.column_statistics_history WHERE VERSION=$ver2`);

let $ver3= `SELECT VERSION FROM mysql.column_statistics_history WHERE TABLE_NAME="tbl1" AND COLUMN_NAME="c1" AND HISTOGRAM->'$."number-of-buckets-specified"'=3;`;
assert($ver3);
assert($histo_ver3 == `SELECT JSON_REMOVE(HISTOGRAM, '$."last-updated"') AS HISTOGRAM FROM mysql.column_statistics_history WHERE VERSION=$ver3`);


--echo #
--echo # Test USING HISTORY ...
--echo #

--echo # Check exact version (ver1)
--disable_query_log
--echo # ANALYZE TABLE tbl1 UPDATE HISTOGRAM ON c1 USING HISTORY ver1;
eval ANALYZE TABLE tbl1 UPDATE HISTOGRAM ON c1 USING HISTORY $ver1;
--enable_query_log
eval $check_online;
assert($histo_ver1 == `SELECT JSON_REMOVE(HISTOGRAM, '$."last-updated"') AS HISTOGRAM FROM information_schema.COLUMN_STATISTICS WHERE TABLE_NAME="tbl1" AND COLUMN_NAME="c1";`);

--echo # Check relative version (last)
ANALYZE TABLE tbl1 UPDATE HISTOGRAM ON c1 USING HISTORY -1;
eval $check_online;
assert($histo_ver3 == `SELECT JSON_REMOVE(HISTOGRAM, '$."last-updated"') AS HISTOGRAM FROM information_schema.COLUMN_STATISTICS WHERE TABLE_NAME="tbl1" AND COLUMN_NAME="c1";`);

--echo # Check relative version (second to last)
ANALYZE TABLE tbl1 UPDATE HISTOGRAM ON c1 USING HISTORY -2;
eval $check_online;
assert($histo_ver2 == `SELECT JSON_REMOVE(HISTOGRAM, '$."last-updated"') AS HISTOGRAM FROM information_schema.COLUMN_STATISTICS WHERE TABLE_NAME="tbl1" AND COLUMN_NAME="c1";`);

--echo # Check relative version (out of range)
ANALYZE TABLE tbl1 UPDATE HISTOGRAM ON c1 USING HISTORY -4;

--error ER_DATA_OUT_OF_RANGE
ANALYZE TABLE tbl1 UPDATE HISTOGRAM ON c1 USING HISTORY 0;

--echo # Check exact version (out of range)
ANALYZE TABLE tbl1 UPDATE HISTOGRAM ON c1 USING HISTORY 1;

eval $check_online;
eval $check_history;


--echo # Number of records exceeds HISTOGRAM_HISTORY_VERSIONS_LIMIT
ANALYZE TABLE tbl1 UPDATE HISTOGRAM ON c1 WITH 4 BUCKETS;
eval $check_history;

--echo # Change the value of HISTOGRAM_HISTORY_VERSIONS_LIMIT to 4
SET GLOBAL HISTOGRAM_HISTORY_VERSIONS_LIMIT= 4;
ANALYZE TABLE tbl1 UPDATE HISTOGRAM ON c1 WITH 5 BUCKETS;
eval $check_history;


--echo # Test HISTOGRAM_HISTORY_ENABLED
SET GLOBAL HISTOGRAM_HISTORY_ENABLED= 0;
ANALYZE TABLE tbl1 UPDATE HISTOGRAM ON c1 WITH 6 BUCKETS;
eval $check_online;
eval $check_history;

SET GLOBAL HISTOGRAM_HISTORY_ENABLED= 1;
let $histo_ver7= {"buckets": [[1, 0.4], [2, 0.6], [3, 0.8], [5, 1.0]], "data-type": "int", "null-values": 0.0, "collation-id": 8, "sampling-rate": 1.0, "histogram-type": "singleton", "number-of-buckets-specified": 7};
eval ANALYZE TABLE tbl1 UPDATE HISTOGRAM ON c1 USING DATA '$histo_ver7';
eval $check_online;
eval $check_history;

DROP TABLE tbl1;


--echo #
--echo # Test RENAME COLUMN
--echo #

CREATE TABLE tbl1(c1 INT);
INSERT INTO tbl1(c1) VALUES(1),(1),(2),(3),(5);

--echo # Create 3 history records for tbl1
ANALYZE TABLE tbl1 UPDATE HISTOGRAM ON c1 WITH 1 BUCKETS;
ANALYZE TABLE tbl1 UPDATE HISTOGRAM ON c1 WITH 2 BUCKETS;
ANALYZE TABLE tbl1 UPDATE HISTOGRAM ON c1 WITH 3 BUCKETS;
SELECT COUNT(*) AS HISTOGRAM FROM mysql.column_statistics_history WHERE TABLE_NAME="tbl1" AND COLUMN_NAME="c1";

--echo # Rename c1 to c2
ALTER TABLE tbl1 RENAME COLUMN c1 to c2;
SELECT COUNT(*) AS HISTOGRAM FROM information_schema.column_statistics WHERE TABLE_NAME="tbl1" AND COLUMN_NAME="c1";
SELECT COUNT(*) AS HISTOGRAM FROM information_schema.column_statistics WHERE TABLE_NAME="tbl1" AND COLUMN_NAME="c2";
SELECT COUNT(*) AS HISTOGRAM FROM mysql.column_statistics_history WHERE TABLE_NAME="tbl1" AND COLUMN_NAME="c1";
SELECT COUNT(*) AS HISTOGRAM FROM mysql.column_statistics_history WHERE TABLE_NAME="tbl1" AND COLUMN_NAME="c2";

DROP TABLE tbl1;

--echo #
--echo # Test RENAME/DROP TABLE
--echo #

CREATE TABLE tbl1(c1 INT);
INSERT INTO tbl1(c1) VALUES(1),(1),(2),(3),(5);

--echo # Create 3 history records for tbl1
ANALYZE TABLE tbl1 UPDATE HISTOGRAM ON c1 WITH 1 BUCKETS;
ANALYZE TABLE tbl1 UPDATE HISTOGRAM ON c1 WITH 2 BUCKETS;
ANALYZE TABLE tbl1 UPDATE HISTOGRAM ON c1 WITH 3 BUCKETS;
SELECT COUNT(*) AS HISTOGRAM FROM mysql.column_statistics_history WHERE TABLE_NAME="tbl1" AND COLUMN_NAME="c1";

--echo # Rename tbl1 to tbl1_renamed
RENAME TABLE tbl1 TO tbl1_renamed;
SELECT COUNT(*) AS HISTOGRAM FROM mysql.column_statistics_history WHERE TABLE_NAME="tbl1" AND COLUMN_NAME="c1";
SELECT COUNT(*) AS HISTOGRAM FROM mysql.column_statistics_history WHERE TABLE_NAME="tbl1_renamed" AND COLUMN_NAME="c1";

--echo # DROP TABLE tbl1_renamed
DROP TABLE tbl1_renamed;
SELECT COUNT(*) AS HISTOGRAM FROM mysql.column_statistics_history WHERE TABLE_NAME="tbl1_renamed" AND COLUMN_NAME="c1";

--echo #
--echo # Test Multiple-column Histogram
--echo #

CREATE TABLE tbl2(c1 INT, c2 int);
INSERT INTO tbl2(c1,c2) VALUES(1,1),(1,2),(2,3),(3,4),(5,6);

ANALYZE TABLE tbl2 UPDATE HISTOGRAM ON c2;
ANALYZE TABLE tbl2 UPDATE HISTOGRAM ON c1;

--echo # apply history test
ANALYZE TABLE tbl2 UPDATE HISTOGRAM ON c1 USING HISTORY -1;
ANALYZE TABLE tbl2 UPDATE HISTOGRAM ON c2 USING HISTORY -1;

--echo # DROP TABLE
DROP TABLE tbl2;

eval SET GLOBAL HISTOGRAM_HISTORY_VERSIONS_LIMIT= $SAVED_OPTION_VERSIONS;
eval SET GLOBAL HISTOGRAM_HISTORY_ENABLED= $SAVED_OPTION_ENABLED;

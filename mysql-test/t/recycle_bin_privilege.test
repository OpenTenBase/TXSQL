connect (con_root_master, localhost, root,,,,$MASTER_MYSOCK);
set global txsql_recycle_bin_enabled = on;

create table t1(a int);
drop table t1;
create table t2(a int);
drop table t2;

CREATE USER rb_user@localhost IDENTIFIED WITH sha256_password BY 'mohit' PASSWORD HISTORY 1;
ALTER USER rb_user@localhost IDENTIFIED WITH mysql_native_password BY '123';
GRANT ALL ON test.* TO rb_user@localhost;

--connect(con2,127.0.0.1,rb_user,'123',,,,TCP)
--error ER_SPECIFIC_ACCESS_DENIED_ERROR
clear recycle_bin;
--error ER_SPECIFIC_ACCESS_DENIED_ERROR
clear recycle_bin test.t1;
--error ER_SPECIFIC_ACCESS_DENIED_ERROR
restore database t1 from recycle_bin;
--error ER_SPECIFIC_ACCESS_DENIED_ERROR
restore test.t1 from recycle_bin;

--connection con_root_master
create user superuser_tmp;
grant all on *.* to 'superuser_tmp'@'%';
connect (root2,"127.0.0.1",superuser_tmp,,test);
connection root2;
restore test.t1 from recycle_bin;
clear recycle_bin;

--connection con_root_master
set global txsql_recycle_bin_enabled = default;
drop table t1;
drop user rb_user@localhost;
drop user superuser_tmp;

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

# create
create table t1 (c1 int);

DELIMITER //;
#--error ER_PARSE_ERROR
CREATE
TRIGGER `tg1` BEFORE INSERT ON `t1` FOR EACH ROW
LABELTRI: BEGIN
SET new.c1 = 2;
END
;
//

--error ER_PARSE_ERROR
CREATE
TRIGGER `tg2` BEFORE UPDATE ON `t1` FOR EACH ROW
LABELTRI: BEGIN
SET new.c1 = 2;
END
;
*//
DELIMITER ;//

--replace_column 5 # 6 # 7 #
show triggers;

# end
drop trigger tg1;
drop trigger tg2;
drop table t1;

disable_ps_protocol;
source include/have_debug.inc;

connect (con_root, localhost, root,'', );
connection default;
create database db1;
use db1;
create table t1(id int, c1 int);
create table t2(id int, c1 int);
create table t3(id int);
insert into t1 values(1,1),(2,2),(3,3);
insert into t2 values(1,1),(2,2),(3,3);

create user 'test'@'localhost' identified with mysql_native_password by 'test';
grant select on db1.t1 to 'test'@'localhost';
grant select on db1.t2 to 'test'@'localhost';
grant SESSION_VARIABLES_ADMIN on *.* to 'test'@'localhost';
flush privileges;

connect (con_test, localhost, test,'test', );
connection con_test;
set debug = '+d, txsql_print_privilege_check';
use db1;

prepare stmt1 from 'select c1 from t1 where id=1';
prepare stmt2 from 'select c1 from t2 where id=2';

connection default;
# at first there is no message.
let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err;
let $assert_count = 0;
let $assert_select= bool Sql_cmd_dml::execute: txsql_print_privilege_check: TXSQL: check privileges;
let $assert_text= check if there are some messages for privileges checking;
source include/assert_grep.inc;

connection con_test;
execute stmt1;
connection default;
echo cdb_optimize_ps_priv_check = off, we should check privileges;
let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err;
let $assert_count = 1;
let $assert_select= bool Sql_cmd_dml::execute: txsql_print_privilege_check: TXSQL: check privileges;
let $assert_text= check if there are some messages for privileges checking;
source include/assert_grep.inc;

connection con_root;
set global cdb_optimize_ps_priv_check = ON;
connection con_test;

connection con_test;
execute stmt1;
connection default;
echo cdb_optimize_ps_priv_check = ON, we should check privileges because the privilege version of stmt1 is 0;
let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err;
let $assert_count = 2;
let $assert_select= bool Sql_cmd_dml::execute: txsql_print_privilege_check: TXSQL: check privileges;
let $assert_text= check if there are some messages for privileges checking;
source include/assert_grep.inc;

connection con_test;
execute stmt1;
connection default;
echo cdb_optimize_ps_priv_check = ON, no checking for stmt1;
let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err;
let $assert_count = 2;
let $assert_select= bool Sql_cmd_dml::execute: txsql_print_privilege_check: TXSQL: check privileges;
let $assert_text= check if there are some messages for privileges checking;
source include/assert_grep.inc;

connection con_test;
execute stmt2;
connection default;
echo cdb_optimize_ps_priv_check = ON, we should check privileges because the privilege version of stmt2 is 0;
let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err;
let $assert_count = 3;
let $assert_select= bool Sql_cmd_dml::execute: txsql_print_privilege_check: TXSQL: check privileges;
let $assert_text= check if there are some messages for privileges checking;
source include/assert_grep.inc;

connection con_test;
execute stmt2;
connection default;
echo cdb_optimize_ps_priv_check = ON, no checking for stmt2;
let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err;
let $assert_count = 3;
let $assert_select= bool Sql_cmd_dml::execute: txsql_print_privilege_check: TXSQL: check privileges;
let $assert_text= check if there are some messages for privileges checking;
source include/assert_grep.inc;

# test grant
connection default;
grant select on db1.t3 to 'test'@'localhost';
flush privileges;

connection con_test;
execute stmt1;
connection default;
echo cdb_optimize_ps_priv_check = ON, check privileges for stmt1 because version mismatch;
let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err;
let $assert_count = 4;
let $assert_select= bool Sql_cmd_dml::execute: txsql_print_privilege_check: TXSQL: check privileges;
let $assert_text= check if there are some messages for privileges checking;
source include/assert_grep.inc;

connection con_test;
execute stmt2;
connection default;
echo cdb_optimize_ps_priv_check = ON, check privileges for stmt2 because version mismatch;
let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err;
let $assert_count = 5;
let $assert_select= bool Sql_cmd_dml::execute: txsql_print_privilege_check: TXSQL: check privileges;
let $assert_text= check if there are some messages for privileges checking;
source include/assert_grep.inc;

connection con_test;
execute stmt1;
connection default;
echo cdb_optimize_ps_priv_check = ON, no checking for stmt1;
let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err;
let $assert_count = 5;
let $assert_select= bool Sql_cmd_dml::execute: txsql_print_privilege_check: TXSQL: check privileges;
let $assert_text= check if there are some messages for privileges checking;
source include/assert_grep.inc;

connection con_test;
execute stmt2;
connection default;
echo cdb_optimize_ps_priv_check = ON, no checking for stmt2;
let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err;
let $assert_count = 5;
let $assert_select= bool Sql_cmd_dml::execute: txsql_print_privilege_check: TXSQL: check privileges;
let $assert_text= check if there are some messages for privileges checking;
source include/assert_grep.inc;

# test revoke
connection default;
revoke select on db1.t1 from 'test'@'localhost';
flush privileges;

connection con_test;
error ER_TABLEACCESS_DENIED_ERROR;
execute stmt1;
connection default;
echo cdb_optimize_ps_priv_check = ON, check privileges for stmt1 because version mismatch;
let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err;
let $assert_count = 6;
let $assert_select= bool Sql_cmd_dml::execute: txsql_print_privilege_check: TXSQL: check privileges;
let $assert_text= check if there are some messages for privileges checking;
source include/assert_grep.inc;

connection con_test;
execute stmt2;
connection default;
echo cdb_optimize_ps_priv_check = ON, check privileges for stmt2 because version mismatch;
let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err;
let $assert_count = 7;
let $assert_select= bool Sql_cmd_dml::execute: txsql_print_privilege_check: TXSQL: check privileges;
let $assert_text= check if there are some messages for privileges checking;
source include/assert_grep.inc;

connection con_test;
set debug = '-d, txsql_print_privilege_check';
deallocate prepare stmt1;
deallocate prepare stmt2;

connection con_root;
set global cdb_optimize_ps_priv_check = OFF;
connection default;
drop user 'test'@'localhost';
disconnect con_root;
drop database if exists db1;

insert into t1 select null, rand()*100000, rand()*10000 from t1;
insert into t1 select null, rand()*100000, rand()*10000 from t1;
select min(a),max(a) from t1;
handler t1 open;
--replace_column 1 #
handler t1 read `primary` for 4 key;
--replace_column 1 # 2 #
handler t1 read `idx_b` for 4 key;
handler t1 close;

create table t2 (a int auto_increment primary key, b int, c int,index idx_b(b,c)) PARTITION BY KEY(a) PARTITIONS 4;
insert into t2 select * from t1;
handler t1 open;
--replace_column 1 #
handler t1 read `primary` for 4 key;
--replace_column 1 # 2 #
handler t1 read `idx_b` for 4 key;
handler t1 close;

drop table t1;
drop table t2;

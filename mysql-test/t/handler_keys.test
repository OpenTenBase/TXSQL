create table t1 (a int auto_increment primary key, b int, c int,index idx_b(b,c));
insert into t1 select null, rand()*100000, rand()*10000;
insert into t1 select null, rand()*100000, rand()*10000 from t1;
insert into t1 select null, rand()*100000, rand()*10000 from t1;
insert into t1 select null, rand()*100000, rand()*10000 from t1;

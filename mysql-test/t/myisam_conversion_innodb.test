#
# Test of create table of Myisam
#

--source include/have_binlog_format_row.inc

--disable_warnings
DROP TABLE IF EXISTS t1,t2,t3,t4;
DROP DATABASE IF EXISTS mysqltest;
CREATE DATABASE mysqltest;
--enable_warnings

connect (con_root1, localhost, root,'', mysqltest);
connect (con_root2, localhost, root,'', mysqltest);

connection con_root1;
SET @save_txsql_convert_myisam_to_innodb=@@txsql_convert_myisam_to_innodb;
SET @save_txsql_convert_myisam_to_innodb=@@txsql_convert_myisam_to_innodb;

--echo "# Test 1.1 create table test unit "

connection con_root1;
SET GLOBAL txsql_convert_myisam_to_innodb=OFF;


--echo "txsql_convert_myisam_to_innodb=OFF & connection con_root"
connection con_root2;
CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;

DROP TABLE IF EXISTS t1,t2;

connection con_root1;
SET GLOBAL txsql_convert_myisam_to_innodb=ON;

--echo "txsql_convert_myisam_to_innodb=ON & connection con_root"
connection con_root2;
CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;


--error ER_TOO_LONG_KEY
CREATE TABLE t3 (
        col1 varchar(4768) NOT NULL PRIMARY KEY
)ENGINE=MyISAM;

DROP TABLE IF EXISTS t1,t2;

connection con_root1;
SET GLOBAL txsql_convert_myisam_to_innodb=WARN;

--echo "txsql_convert_myisam_to_innodb=WARN & connection con_root"
connection con_root2;
CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;

--error ER_TOO_LONG_KEY
CREATE TABLE t3 (
        col1 varchar(4768) NOT NULL PRIMARY KEY
)ENGINE=MyISAM;

DROP TABLE IF EXISTS t1,t2;

connection con_root1;
SET GLOBAL txsql_convert_myisam_to_innodb=TRY;

--echo "txsql_convert_myisam_to_innodb=TRY & connection con_root"
connection con_root2;
CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;

CREATE TABLE t3 (
        col1 varchar(768) NOT NULL PRIMARY KEY
)ENGINE=MyISAM;

SHOW CREATE TABLE t3;

CREATE TABLE t4 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM ROW_FORMAT=FIXED;

SHOW CREATE TABLE t4;

DROP TABLE IF EXISTS t1,t2,t3,t4;

--echo "# Test 1.2 alter table test unit "

connection con_root1;
SET GLOBAL txsql_convert_myisam_to_innodb=OFF;

--echo "txsql_convert_myisam_to_innodb=OFF & connection con_root"
connection con_root2;
CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

ALTER TABLE t1 ENGINE=MyISAM;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;

ALTER TABLE t2 ENGINE=MyISAM;
SHOW CREATE TABLE t2;

DROP TABLE IF EXISTS t1,t2;

--echo "txsql_convert_myisam_to_innodb=OFF & connection con_root"
connection con_root1;
SET GLOBAL txsql_convert_myisam_to_innodb=ON;
SET GLOBAL txsql_convert_myisam_to_innodb=OFF;

CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;

CREATE TABLE t3 (
        col1 varchar(250) NOT NULL PRIMARY KEY
)ENGINE=MyISAM;

SHOW CREATE TABLE t3;

--echo "txsql_convert_myisam_to_innodb=ON & connection con_root"
connection con_root2;
ALTER TABLE t1 ENGINE=MyISAM;

SHOW CREATE TABLE t1;

ALTER TABLE t2 ENGINE=MyISAM;
SHOW CREATE TABLE t2;

#--error ER_TOO_LONG_KEY
ALTER TABLE t3 ENGINE=MyISAM;

DROP TABLE IF EXISTS t1,t2,t3;

--echo "txsql_convert_myisam_to_innodb=OFF & connection con_root"
connection con_root1;
SET GLOBAL txsql_convert_myisam_to_innodb=WARN;
SET GLOBAL txsql_convert_myisam_to_innodb=OFF;

CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;
SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;
SHOW CREATE TABLE t2;

CREATE TABLE t3 (
        col1 varchar(250) NOT NULL PRIMARY KEY
)ENGINE=MyISAM;
SHOW CREATE TABLE t3;

--echo "connection con_root & txsql_convert_myisam_to_innodb=WARN"
connection con_root2;
ALTER TABLE t1 ENGINE=MyISAM;
SHOW CREATE TABLE t1;

ALTER TABLE t2 ENGINE=MyISAM;
SHOW CREATE TABLE t2;

#--error ER_TOO_LONG_KEY
ALTER TABLE t3 ENGINE=MyISAM;

DROP TABLE IF EXISTS t1,t2,t3;

--echo "txsql_convert_myisam_to_innodb=TRY & connection con_root1"
connection con_root1;
SET GLOBAL txsql_convert_myisam_to_innodb=TRY;
SET GLOBAL txsql_convert_myisam_to_innodb=OFF;

CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;
SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;
SHOW CREATE TABLE t2;

CREATE TABLE t3 (
        col1 varchar(250) NOT NULL PRIMARY KEY
)ENGINE=MyISAM;
SHOW CREATE TABLE t3;

CREATE TABLE t4 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM ROW_FORMAT=FIXED;
SHOW CREATE TABLE t4;

--echo "txsql_convert_myisam_to_innodb=TRY & connection con_root"
connection con_root2;
ALTER TABLE t1 ENGINE=MyISAM;
SHOW CREATE TABLE t1;

ALTER TABLE t2 ENGINE=MyISAM;
SHOW CREATE TABLE t2;

ALTER TABLE t3 ENGINE=MyISAM;
SHOW CREATE TABLE t3;

--disable_warnings
ALTER TABLE t4 ENGINE=MyISAM;
--enable_warnings
SHOW CREATE TABLE t4;

DROP TABLE IF EXISTS t1,t2,t3,t4;

--echo "# Test 1.3 tencent root create table test unit "

--echo "txsql_convert_myisam_to_innodb=OFF & connection con_root1"
connection con_root1;
SET GLOBAL txsql_convert_myisam_to_innodb=OFF;

CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;

DROP TABLE IF EXISTS t1,t2;


--echo "txsql_convert_myisam_to_innodb=ON & connection con_root1"
connection con_root1;
SET GLOBAL txsql_convert_myisam_to_innodb=ON;

CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;

--error ER_TOO_LONG_KEY
CREATE TABLE t3 (
        col1 varchar(4768) NOT NULL PRIMARY KEY
)ENGINE=MyISAM;

DROP TABLE IF EXISTS t1,t2;

--echo "txsql_convert_myisam_to_innodb=WARN & connection con_root1"
connection con_root1;
SET GLOBAL txsql_convert_myisam_to_innodb=WARN;

CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;

--error ER_TOO_LONG_KEY
CREATE TABLE t3 (
        col1 varchar(4768) NOT NULL PRIMARY KEY
)ENGINE=MyISAM;

DROP TABLE IF EXISTS t1,t2;


--echo "txsql_convert_myisam_to_innodb=TRY & connection con_root1"

connection con_root1;
SET GLOBAL txsql_convert_myisam_to_innodb=TRY;

CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;

CREATE TABLE t3 (
        col1 varchar(250) NOT NULL PRIMARY KEY
)ENGINE=MyISAM;

SHOW CREATE TABLE t3;

CREATE TABLE t4 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM ROW_FORMAT=FIXED;

SHOW CREATE TABLE t4;

DROP TABLE IF EXISTS t1,t2,t3,t4;

--echo "# Test 1.4 tencent root alter table test unit "

--echo "txsql_convert_myisam_to_innodb=OFF & connection con_root1"
connection con_root1;
SET GLOBAL txsql_convert_myisam_to_innodb=OFF;

CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

ALTER TABLE t1 ENGINE=MyISAM;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;

ALTER TABLE t2 ENGINE=MyISAM;
SHOW CREATE TABLE t2;

DROP TABLE IF EXISTS t1,t2;


--echo "---------- alter table txsql_convert_myisam_to_innodb=WARN -----------------"

--echo "txsql_convert_myisam_to_innodb=OFF & connection con_root1"
connection con_root1;
SET GLOBAL txsql_convert_myisam_to_innodb=OFF;

CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;

CREATE TABLE t3 (
        col1 varchar(250) NOT NULL PRIMARY KEY
)ENGINE=MyISAM;

SHOW CREATE TABLE t3;

--echo "txsql_convert_myisam_to_innodb=ON & connection con_root1"
SET GLOBAL txsql_convert_myisam_to_innodb=ON;
ALTER TABLE t1 ENGINE=MyISAM;
SHOW CREATE TABLE t1;

ALTER TABLE t2 ENGINE=MyISAM;
SHOW CREATE TABLE t2;

ALTER TABLE t3 ENGINE=MyISAM;
show create table t3;

DROP TABLE IF EXISTS t1,t2,t3;

--echo "txsql_convert_myisam_to_innodb=OFF & connection con_root1"
connection con_root1;
SET GLOBAL txsql_convert_myisam_to_innodb=OFF;

CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;

CREATE TABLE t3 (
        col1 varchar(250) NOT NULL PRIMARY KEY
)ENGINE=MyISAM;

SHOW CREATE TABLE t3;

--echo "txsql_convert_myisam_to_innodb=WARN & connection con_root1"
SET GLOBAL txsql_convert_myisam_to_innodb=WARN;
ALTER TABLE t1 ENGINE=MyISAM;

SHOW CREATE TABLE t1;

ALTER TABLE t2 ENGINE=MyISAM;

SHOW CREATE TABLE t2;

#--error ER_TOO_LONG_KEY
ALTER TABLE t3 ENGINE=MyISAM;

DROP TABLE IF EXISTS t1,t2,t3;

--echo "----------alter table txsql_convert_myisam_to_innodb=TRY-----------------"

--echo "txsql_convert_myisam_to_innodb=OFF & connection con_root1"
connection con_root1;
SET GLOBAL txsql_convert_myisam_to_innodb=OFF;

CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;
SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;
SHOW CREATE TABLE t2;

CREATE TABLE t3 (
        col1 varchar(250) NOT NULL PRIMARY KEY
)ENGINE=MyISAM;
SHOW CREATE TABLE t3;

CREATE TABLE t4 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM ROW_FORMAT=FIXED;
SHOW CREATE TABLE t4;

--echo "txsql_convert_myisam_to_innodb=TRY & connection con_root1"

SET GLOBAL txsql_convert_myisam_to_innodb=TRY;
ALTER TABLE t1 ENGINE=MyISAM;

SHOW CREATE TABLE t1;

ALTER TABLE t2 ENGINE=MyISAM;

SHOW CREATE TABLE t2;

ALTER TABLE t3 ENGINE=MyISAM;

SHOW CREATE TABLE t3;

--disable_warnings
ALTER TABLE t4 ENGINE=MyISAM;
--enable_warnings

SHOW CREATE TABLE t4;

DROP TABLE IF EXISTS t1,t2,t3,t4;

--echo "Cleanup"

connection con_root1;
SET GLOBAL txsql_convert_myisam_to_innodb=@save_txsql_convert_myisam_to_innodb;
SET GLOBAL txsql_convert_myisam_to_innodb=@save_txsql_convert_myisam_to_innodb;

--disable_warnings
DROP TABLE IF EXISTS t1,t2,t3,t4;
DROP DATABASE IF EXISTS mysqltest;
--enable_warnings

disconnect con_root1;
disconnect con_root2;

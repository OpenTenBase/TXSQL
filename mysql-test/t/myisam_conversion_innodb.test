#
# Test of create table of Myisam
#

--source include/have_binlog_format_row.inc

--disable_warnings
DROP TABLE IF EXISTS t1,t2,t3,t4;
DROP DATABASE IF EXISTS mysqltest;
CREATE DATABASE mysqltest;
--enable_warnings

--echo #connect user=root
connect (con_root, localhost, root,'', mysqltest);

connection con_root;
SET @save_myisam_conversion_innodb=@@myisam_conversion_innodb;
SET @save_tencent_myisam_conversion_innodb=@@tencent_myisam_conversion_innodb;

--echo "# Test 1.1 create table test unit "

connection con_root;
SET GLOBAL myisam_conversion_innodb=OFF;


--echo "myisam_conversion_innodb=OFF & connection con_root"
connection con_root;
CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;

DROP TABLE IF EXISTS t1,t2;

connection con_root;
SET GLOBAL myisam_conversion_innodb=ON;

--echo "myisam_conversion_innodb=ON & connection con_root"
connection con_root;
CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;


--error ER_TOO_LONG_KEY
CREATE TABLE t3 (
        col1 varchar(4768) NOT NULL PRIMARY KEY
)ENGINE=MyISAM;

DROP TABLE IF EXISTS t1,t2;

connection con_root;
SET GLOBAL myisam_conversion_innodb=WARN;

--echo "myisam_conversion_innodb=WARN & connection con_root"
connection con_root;
CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;

--error ER_TOO_LONG_KEY
CREATE TABLE t3 (
        col1 varchar(4768) NOT NULL PRIMARY KEY
)ENGINE=MyISAM;

DROP TABLE IF EXISTS t1,t2;

connection con_root;
SET GLOBAL myisam_conversion_innodb=TRY;

--echo "myisam_conversion_innodb=TRY & connection con_root"
connection con_root;
CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;

CREATE TABLE t3 (
        col1 varchar(768) NOT NULL PRIMARY KEY
)ENGINE=MyISAM;

SHOW CREATE TABLE t3;

CREATE TABLE t4 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM ROW_FORMAT=FIXED;

SHOW CREATE TABLE t4;

DROP TABLE IF EXISTS t1,t2,t3,t4;

--echo "# Test 1.2 alter table test unit "

connection con_root;
SET GLOBAL myisam_conversion_innodb=OFF;

--echo "myisam_conversion_innodb=OFF & connection con_root"
connection con_root;
CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

ALTER TABLE t1 ENGINE=MyISAM;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;

ALTER TABLE t2 ENGINE=MyISAM;
SHOW CREATE TABLE t2;

DROP TABLE IF EXISTS t1,t2;

--echo "tencent_myisam_conversion_innodb=OFF & connection con_tencent_root"
connection con_root;
SET GLOBAL myisam_conversion_innodb=ON;
SET GLOBAL tencent_myisam_conversion_innodb=OFF;

CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;

CREATE TABLE t3 (
        col1 varchar(250) NOT NULL PRIMARY KEY
)ENGINE=MyISAM;

SHOW CREATE TABLE t3;

--echo "myisam_conversion_innodb=ON & connection con_root"
connection con_root;
ALTER TABLE t1 ENGINE=MyISAM;

SHOW CREATE TABLE t1;

ALTER TABLE t2 ENGINE=MyISAM;
SHOW CREATE TABLE t2;

#--error ER_TOO_LONG_KEY
ALTER TABLE t3 ENGINE=MyISAM;

DROP TABLE IF EXISTS t1,t2,t3;

--echo "tencent_myisam_conversion_innodb=OFF & connection con_tencent_root"
connection con_root;
SET GLOBAL myisam_conversion_innodb=WARN;
SET GLOBAL tencent_myisam_conversion_innodb=OFF;

CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;
SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;
SHOW CREATE TABLE t2;

CREATE TABLE t3 (
        col1 varchar(250) NOT NULL PRIMARY KEY
)ENGINE=MyISAM;
SHOW CREATE TABLE t3;

--echo "connection con_root & myisam_conversion_innodb=WARN"
connection con_root;
ALTER TABLE t1 ENGINE=MyISAM;
SHOW CREATE TABLE t1;

ALTER TABLE t2 ENGINE=MyISAM;
SHOW CREATE TABLE t2;

#--error ER_TOO_LONG_KEY
ALTER TABLE t3 ENGINE=MyISAM;

DROP TABLE IF EXISTS t1,t2,t3;

--echo "myisam_conversion_innodb=TRY & connection con_root"
connection con_root;
SET GLOBAL myisam_conversion_innodb=TRY;
SET GLOBAL tencent_myisam_conversion_innodb=OFF;

CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;
SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;
SHOW CREATE TABLE t2;

CREATE TABLE t3 (
        col1 varchar(250) NOT NULL PRIMARY KEY
)ENGINE=MyISAM;
SHOW CREATE TABLE t3;

CREATE TABLE t4 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM ROW_FORMAT=FIXED;
SHOW CREATE TABLE t4;

--echo "myisam_conversion_innodb=TRY & connection con_root"
connection con_root;
ALTER TABLE t1 ENGINE=MyISAM;
SHOW CREATE TABLE t1;

ALTER TABLE t2 ENGINE=MyISAM;
SHOW CREATE TABLE t2;

ALTER TABLE t3 ENGINE=MyISAM;
SHOW CREATE TABLE t3;

--disable_warnings
ALTER TABLE t4 ENGINE=MyISAM;
--enable_warnings
SHOW CREATE TABLE t4;

DROP TABLE IF EXISTS t1,t2,t3,t4;

--echo "# Test 1.3 tencent root create table test unit "

--echo "tencent_myisam_conversion_innodb=OFF & connection con_root"
connection con_root;
SET GLOBAL tencent_myisam_conversion_innodb=OFF;

CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;

DROP TABLE IF EXISTS t1,t2;


--echo "tencent_myisam_conversion_innodb=ON & connection con_root"
connection con_root;
SET GLOBAL tencent_myisam_conversion_innodb=ON;

CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;

--error ER_TOO_LONG_KEY
CREATE TABLE t3 (
        col1 varchar(4768) NOT NULL PRIMARY KEY
)ENGINE=MyISAM;

DROP TABLE IF EXISTS t1,t2;

--echo "tencent_myisam_conversion_innodb=WARN & connection con_root"
connection con_root;
SET GLOBAL tencent_myisam_conversion_innodb=WARN;

CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;

--error ER_TOO_LONG_KEY
CREATE TABLE t3 (
        col1 varchar(4768) NOT NULL PRIMARY KEY
)ENGINE=MyISAM;

DROP TABLE IF EXISTS t1,t2;


--echo "tencent_myisam_conversion_innodb=TRY & connection con_root"

connection con_root;
SET GLOBAL tencent_myisam_conversion_innodb=TRY;

CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;

CREATE TABLE t3 (
        col1 varchar(250) NOT NULL PRIMARY KEY
)ENGINE=MyISAM;

SHOW CREATE TABLE t3;

CREATE TABLE t4 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM ROW_FORMAT=FIXED;

SHOW CREATE TABLE t4;

DROP TABLE IF EXISTS t1,t2,t3,t4;

--echo "# Test 1.4 tencent root alter table test unit "

--echo "tencent_myisam_conversion_innodb=OFF & connection con_root"
connection con_root;
SET GLOBAL tencent_myisam_conversion_innodb=OFF;

CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

ALTER TABLE t1 ENGINE=MyISAM;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;

ALTER TABLE t2 ENGINE=MyISAM;
SHOW CREATE TABLE t2;

DROP TABLE IF EXISTS t1,t2;


--echo "---------- alter table tencent_myisam_conversion_innodb=WARN -----------------"

--echo "tencent_myisam_conversion_innodb=OFF & connection con_root"
connection con_root;
SET GLOBAL tencent_myisam_conversion_innodb=OFF;

CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;

CREATE TABLE t3 (
        col1 varchar(250) NOT NULL PRIMARY KEY
)ENGINE=MyISAM;

SHOW CREATE TABLE t3;

--echo "tencent_myisam_conversion_innodb=ON & connection con_root"
SET GLOBAL tencent_myisam_conversion_innodb=ON;
ALTER TABLE t1 ENGINE=MyISAM;
SHOW CREATE TABLE t1;

ALTER TABLE t2 ENGINE=MyISAM;
SHOW CREATE TABLE t2;

ALTER TABLE t3 ENGINE=MyISAM;
show create table t3;

DROP TABLE IF EXISTS t1,t2,t3;

--echo "tencent_myisam_conversion_innodb=OFF & connection con_root"
connection con_root;
SET GLOBAL tencent_myisam_conversion_innodb=OFF;

CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;

SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;

SHOW CREATE TABLE t2;

CREATE TABLE t3 (
        col1 varchar(250) NOT NULL PRIMARY KEY
)ENGINE=MyISAM;

SHOW CREATE TABLE t3;

--echo "tencent_myisam_conversion_innodb=WARN & connection con_root"
SET GLOBAL tencent_myisam_conversion_innodb=WARN;
ALTER TABLE t1 ENGINE=MyISAM;

SHOW CREATE TABLE t1;

ALTER TABLE t2 ENGINE=MyISAM;

SHOW CREATE TABLE t2;

#--error ER_TOO_LONG_KEY
ALTER TABLE t3 ENGINE=MyISAM;

DROP TABLE IF EXISTS t1,t2,t3;

--echo "----------alter table tencent_myisam_conversion_innodb=TRY-----------------"

--echo "tencent_myisam_conversion_innodb=OFF & connection con_root"
connection con_root;
SET GLOBAL tencent_myisam_conversion_innodb=OFF;

CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=InnoDB;
SHOW CREATE TABLE t1;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM;
SHOW CREATE TABLE t2;

CREATE TABLE t3 (
        col1 varchar(250) NOT NULL PRIMARY KEY
)ENGINE=MyISAM;
SHOW CREATE TABLE t3;

CREATE TABLE t4 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
)ENGINE=MyISAM ROW_FORMAT=FIXED;
SHOW CREATE TABLE t4;

--echo "tencent_myisam_conversion_innodb=TRY & connection con_root"

SET GLOBAL tencent_myisam_conversion_innodb=TRY;
ALTER TABLE t1 ENGINE=MyISAM;

SHOW CREATE TABLE t1;

ALTER TABLE t2 ENGINE=MyISAM;

SHOW CREATE TABLE t2;

ALTER TABLE t3 ENGINE=MyISAM;

SHOW CREATE TABLE t3;

--disable_warnings
ALTER TABLE t4 ENGINE=MyISAM;
--enable_warnings

SHOW CREATE TABLE t4;

DROP TABLE IF EXISTS t1,t2,t3,t4;

--echo "Cleanup"

connection con_root;
SET GLOBAL myisam_conversion_innodb=@save_myisam_conversion_innodb;
SET GLOBAL tencent_myisam_conversion_innodb=@save_tencent_myisam_conversion_innodb;

--disable_warnings
DROP TABLE IF EXISTS t1,t2,t3,t4;

--enable_warnings

## test when the default engine is myisam, create table without
## specified engine should turn out to be innodb engine.

connection con_root;
--let $restart_parameters=restart:--default-storage-engine=myisam
--source include/restart_mysqld.inc
--connection con_root
SET @save_myisam_conversion_innodb=@@myisam_conversion_innodb;
SET @save_tencent_myisam_conversion_innodb=@@tencent_myisam_conversion_innodb;

CREATE TABLE t1 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
);
--echo "t1 with myisam engine"
SHOW CREATE TABLE t1;

SET GLOBAL tencent_myisam_conversion_innodb=ON;

CREATE TABLE t2 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
);
--echo "t2 with innodb engine"
SHOW CREATE TABLE t2;

connect (conroot, localhost, root,'', mysqltest);

connection conroot;
CREATE TABLE t3 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
);
--echo "t3 with myisam engine"
SHOW CREATE TABLE t3;

connection con_root;
SET GLOBAL tencent_myisam_conversion_innodb=OFF;
SET GLOBAL myisam_conversion_innodb=ON;

connection conroot;
CREATE TABLE t4 (
        col1 int NOT NULL AUTO_INCREMENT PRIMARY KEY,
        col2 varchar(30) NOT NULL
);
--echo "t4 with innodb engine"
SHOW CREATE TABLE t4;

connection con_root;

SET GLOBAL myisam_conversion_innodb=@save_myisam_conversion_innodb;
SET GLOBAL tencent_myisam_conversion_innodb=@save_tencent_myisam_conversion_innodb;

DROP TABLE IF EXISTS t1, t2, t3, t4;
DROP DATABASE IF EXISTS mysqltest;

disconnect con_root;
disconnect conroot;

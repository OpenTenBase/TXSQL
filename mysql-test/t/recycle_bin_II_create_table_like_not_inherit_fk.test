--source include/have_debug.inc

--echo #
--echo #  Prepare
--echo #

connect (con_tencentroot_master, localhost, tencentroot,,,,$MASTER_MYSOCK);
--let $cdb_recycle_bin_enabled_default= `select @@cdb_recycle_bin_enabled`
set global cdb_recycle_bin_enabled = on;

--echo #
--echo # Run 
--echo #
connection default;

--echo #
--echo # case1. fix it doesn't inherit foreign key
--echo #

create table stu(
  sid int UNSIGNED primary key auto_increment,
  name varchar(20) not null) ;

create table sc(
  scid int UNSIGNED primary key auto_increment,
  sid int UNSIGNED not null,
  score varchar(20) default '0',index (sid),  
  FOREIGN KEY (sid) REFERENCES stu(sid) ON DELETE CASCADE ON UPDATE CASCADE);

--error ER_CDB_RECYCLE_BIN_ERROR_IN_CHECK_SOURCE_TABLE
truncate sc; 


--echo #
--echo # case2. fix it doesn't inherit data directory and index directory
--echo #

LET $MYSQLD_DATADIR=`select @@datadir`;
LET $recycle_bin_tmp=$MYSQL_TMP_DIR/recycle_bin_tmp;
--mkdir $recycle_bin_tmp

disconnect con_tencentroot_master;
LET $restart_parameters = restart:--innodb-directories=$recycle_bin_tmp;
--replace_result $MYSQL_TMP_DIR MYSQL_TMP_DIR
--source include/restart_mysqld.inc

SHOW TABLES;

connect (con_tencentroot_master, localhost, tencentroot,,,,$MASTER_MYSOCK);
set global cdb_recycle_bin_enabled = on;
--replace_result $MYSQL_TMP_DIR MYSQL_TMP_DIR
eval CREATE TABLE `te` (
  `c1` int NOT NULL,
  PRIMARY KEY (`c1`)
) ENGINE=InnoDB  DATA DIRECTORY='$recycle_bin_tmp';

insert into te values(1);

--error ER_CDB_RECYCLE_BIN_ERROR_IN_CHECK_SOURCE_TABLE
truncate te;

select * from te;

--echo #
--echo # Cleanup 
--echo # 

set global cdb_recycle_bin_enabled = off;
drop table stu, sc;
drop table te;

let $restart_parameters = restart:;
--source include/start_mysqld.inc

--rmdir $recycle_bin_tmp/test
--rmdir $recycle_bin_tmp/__txsql_recycle_bin__
--rmdir $recycle_bin_tmp

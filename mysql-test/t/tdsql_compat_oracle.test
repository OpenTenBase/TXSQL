select to_char('2021-07-21 12:20:45.888888', 'hh24:mi:ss ff1');
select to_char('2021-07-21 12:20:45.888888', 'hh24:mi:ss ff2');
select to_char('2021-07-21 12:20:45.888888', 'hh24:mi:ss ff3');

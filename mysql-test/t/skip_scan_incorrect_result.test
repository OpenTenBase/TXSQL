drop table if exists afan_test_t;
drop table if exists afan_test;

create table afan_test_t(
id int auto_increment primary key,
the_date varchar(8) not null,
prj_id varchar(120) not null,
index index_1(the_date,prj_id));

insert into afan_test_t (the_date,prj_id) values('20220101','PRJID01'),('20220101','PRJID02'),('20220101','PRJID03'),('20220101','PRJID04'),('20220101','PRJID05'),('20220101','PRJID05'),('20220101','PRJID06'),('20220101','PRJID07'),('20220101','PRJID08'),('20220101','PRJID09'),('20220101','PRJID10');


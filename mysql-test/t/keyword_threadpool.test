#
# THREADPOOL should not be a reserved word
#

create table t1 (threadpool int, b int);
create table threadpool(id int, c1 int);
insert into t1 values (1,1);
insert into threadpool values (1,2);
select * from t1;
select threadpool from t1;
select * from threadpool;

delimiter |;
create procedure p1()
begin
  declare threadpool int;
  select max(t1.threadpool) into threadpool from t1;
end|

create procedure p2()
begin
threadpool:loop
  leave threadpool;
end loop threadpool;
end |
delimiter ;|

call p1();
call p2();
drop procedure p1;
drop procedure p2;
drop table t1;
drop table threadpool;

create table tencentroot(id int, c1 int);
create table t1(tencentroot int, c1 int);
insert into t1 values (1,1);
insert into tencentroot values (1,2);

delimiter |;
create procedure p1()
begin
  declare tencentroot int;
  select max(t1.tencentroot) into tencentroot from t1;
end|
delimiter ;|
call p1();

## tencentroot can't be used as unquoted SP label names
delimiter |;
--error ER_PARSE_ERROR
create procedure p2()
begin
tencentroot:loop
  leave tencentroot;
end loop tencentroot;
end |

create procedure p2()
begin
`tencentroot`:loop
  leave `tencentroot`;
end loop `tencentroot`;
end |
delimiter ;|
call p2();

drop procedure p1;
drop procedure p2;
drop table t1;
drop table tencentroot;

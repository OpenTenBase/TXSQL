-> Exchange Receive dop )
    -> Exchange Send dop )
        -> Table scan on t1  (cost=1.15 rows=9)

SELECT f1 FROM t1;
f1
COMMIT;
UNLOCK TABLES;
set global autocommit = 1;
set global cdb_parallel_query_enable = off;
set global cdb_parallel_execution_enabled = off;
set global exchange_inject = off;
drop table t1;
drop database test1;
drop user user1;

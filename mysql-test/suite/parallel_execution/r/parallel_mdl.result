select user();
user()
root@localhost
create database test1;
create user 'user1'@'%';
grant all on test1.* to 'user1'@'%';
CREATE TABLE t1 (f1 INT) ENGINE="InnoDB";
SET global autocommit=0;
set global cdb_parallel_query_enable = on;
set global cdb_parallel_execution_enabled = on;
set global exchange_inject = on;
UNLOCK TABLES;
LOCK TABLES t1 WRITE;
INSERT INTO t1 VALUES (2);
INSERT INTO t1 VALUES (2);
INSERT INTO t1 VALUES (2);
INSERT INTO t1 VALUES (2);
INSERT INTO t1 VALUES (2);
INSERT INTO t1 VALUES (2);
INSERT INTO t1 VALUES (2);
INSERT INTO t1 VALUES (2);
INSERT INTO t1 VALUES (2);

parallel table with full text search
CREATE TABLE ft_test (a VARCHAR(200), b TEXT, FULLTEXT (a,b)) charset utf8mb4;
INSERT INTO ft_test VALUES('MySQL has now support', 'for full-text search'),
('Full-text indexes', 'are called collections'),
('Only MyISAM tables','support collections'),
('Function MATCH ... AGAINST()','is used to do a search'),
('Full-text search in MySQL', 'implements vector space model');
ANALYZE TABLE ft_test;
Table	Op	Msg_type	Msg_text
test.ft_test	analyze	status	OK
SHOW INDEX FROM ft_test;
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Visible	Expression
ft_test	1	a	1	a	NULL	5	NULL	NULL	YES	FULLTEXT			YES	NULL
ft_test	1	a	2	b	NULL	5	NULL	NULL	YES	FULLTEXT			YES	NULL
EXPLAIN FORMAT=tree select * from ft_test where MATCH(a,b) AGAINST ("collections");
EXPLAIN
-> Filter: (match ft_test.a,ft_test.b against ('collections'))  (cost=0.35 rows=1)
    -> Indexed full text search on ft_test using a (a='collections')  (cost=0.35 rows=1)

DROP TABLE ft_test;

CREATE TABLE json_test (`key` varchar(8) DEFAULT NULL, `grp` varchar(8) DEFAULT NULL, `val` varchar(8)) ENGINE=InnoDB DEFAULT CHARSET=latin1;
INSERT INTO json_test(`key`, `grp`, `val`) VALUES
("key1", "g1", "v1"),
("key2", "g1", "v2"),
("key3", "g2", "v3");
explain format=tree SELECT JSON_ARRAYAGG(`key`) AS `keys` FROM json_test;
EXPLAIN
-> Aggregate: json_arrayagg(json_test.`key`)
    -> Table scan on json_test  (cost=0.55 rows=3)

SELECT JSON_ARRAYAGG(`key`) AS `keys` FROM json_test;
keys
["key1", "key2", "key3"]
explain format=tree SELECT JSON_OBJECTAGG(`key`, val) AS `key_val` FROM json_test;
EXPLAIN
-> Aggregate: json_objectagg(json_test.`key`,json_test.val)
    -> Table scan on json_test  (cost=0.55 rows=3)

SELECT JSON_OBJECTAGG(`key`, val) AS `key_val` FROM json_test;
key_val
{"key1": "v1", "key2": "v2", "key3": "v3"}
DROP TABLE json_test;

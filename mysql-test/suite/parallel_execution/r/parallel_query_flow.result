KILL QUERY <id>;
SET DEBUG_SYNC= 'now SIGNAL killed';
ERROR 70100: Query execution was interrupted
SET DEBUG_SYNC = 'RESET';
set debug_sync='execute_in_parallel_scheduling SIGNAL waiting wait_for killed';

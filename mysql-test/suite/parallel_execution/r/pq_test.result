CREATE TABLE a (id INTEGER);
CREATE TABLE b (id INTEGER);
CREATE ALGORITHM=MERGE VIEW vmerge AS SELECT 1 AS id, id AS b_id FROM b;
CREATE ALGORITHM=TEMPTABLE VIEW vmat AS SELECT 1 AS id, id AS b_id FROM b;
INSERT INTO a(id) VALUES (1);
explain format=tree SELECT *
FROM a LEFT JOIN vmerge AS v ON a.id = v.id;
EXPLAIN
-> Left hash join (no condition), extra conditions: (a.id = 1)  (cost=0.70 rows=1)
    -> Table scan on a  (cost=0.35 rows=1)
    -> Hash
        -> Table scan on b  (cost=0.35 rows=1)

SELECT *
FROM a LEFT JOIN vmerge AS v ON a.id = v.id;
id	id	b_id
1	NULL	NULL
Drop view vmerge;
drop view vmat;
DROP Table a, b;

SHOW VARIABLES LIKE "%px%";
Variable_name	Value
innodb_px_partitions_per_worker	13
px_exchange_buffer_size	1048576
px_max_parallel_threads	8
px_parallel_cost_threshold	0.000000
px_parallel_degree	4
px_parallel_table_record_threshold	0
DROP TABLE IF EXISTS t1;
Warnings:
Note	1051	Unknown table 'test.t1'
CREATE TABLE t1(
id INT PRIMARY KEY AUTO_INCREMENT,
col1 VARCHAR(100),
col2 INT,
KEY idx_col2(col2)
)ENGINE = InnoDB;
ANALYZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
SHOW VARIABLES LIKE "%px%";
Variable_name	Value
innodb_px_partitions_per_worker	13
px_exchange_buffer_size	1048576
px_fallback_in_execution	OFF
px_max_parallel_threads	8
px_parallel_cost_threshold	0.000000
px_parallel_degree	4
px_parallel_table_record_threshold	0
# --include save_and_set_px.inc
SET @saved_px_fallback_in_execution =@@px_fallback_in_execution;
set global px_fallback_in_execution = 0;
###
### Execute statement in parallel mode.
###
SHOW VARIABLES LIKE "%px%";
Variable_name	Value
innodb_px_partitions_per_worker	13
px_exchange_buffer_size	1048576
px_fallback_in_execution	OFF
px_max_parallel_threads	8
px_parallel_cost_threshold	0.000000
px_parallel_degree	4
px_parallel_table_record_threshold	0
EXPLAIN FORMAT = TREE SELECT * FROM t1;
EXPLAIN
-> Exchange Receive dop )
    -> Exchange Send dop )
        -> Table scan on t1  (cost=1.25 rows=10)

SELECT * FROM t1;
id	col1	col2
1	testtesttesttest	10
2	testtesttesttest	9
3	testtesttesttest	8
4	testtesttesttest	7
5	testtesttesttest	6
6	testtesttesttest	5
7	testtesttesttest	4
8	testtesttesttest	3
9	testtesttesttest	2
10	testtesttesttest	1
set global px_fallback_in_execution = 1;
###
### Disable Execute statement in parallel mode but the parallel explain mode
###
SHOW VARIABLES LIKE "%px%";
Variable_name	Value
innodb_px_partitions_per_worker	13
px_exchange_buffer_size	1048576
px_fallback_in_execution	ON
px_max_parallel_threads	8
px_parallel_cost_threshold	0.000000
px_parallel_degree	4
px_parallel_table_record_threshold	0
EXPLAIN FORMAT = TREE SELECT * FROM t1;
EXPLAIN
-> Exchange Receive dop )
    -> Exchange Send dop )
        -> Table scan on t1  (cost=1.25 rows=10)

SELECT * FROM t1;
id	col1	col2
1	testtesttesttest	10
2	testtesttesttest	9
3	testtesttesttest	8
4	testtesttesttest	7
5	testtesttesttest	6
6	testtesttesttest	5
7	testtesttesttest	4
8	testtesttesttest	3
9	testtesttesttest	2
10	testtesttesttest	1
# --include set_px_to_saved.inc
set global px_fallback_in_execution = @saved_px_fallback_in_execution;
drop table t1;

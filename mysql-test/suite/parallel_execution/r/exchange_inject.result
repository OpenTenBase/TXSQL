# join -> exchange -> TemptableAggregate -> exchange -> sort -> exchange
#
select sum(t1.col1),sum(t2.col1) from t1 join t2 on t1.id=t2.id
group by t1.col2 order by t1.col2;
sum(t1.col1)	sum(t2.col1)

GRANT PROXY ON ''@'' TO 'root'@'localhost' WITH GRANT OPTION
select user();
user()
root@localhost
create database test1;
create user 'user1'@'%';
grant all on *.* to 'user1'@'%';
set global cdb_parallel_query_enable = on;
set global cdb_parallel_execution_enabled = on;
set global exchange_inject = on;
explain format = tree
select
s_acctbal,
s_name,
n_name,
p_partkey,
p_mfgr,
s_address,
s_phone,
s_comment
from
part,
supplier,
partsupp,
nation,
region
where
p_partkey = ps_partkey
and s_suppkey = ps_suppkey
and p_size = 32
and p_type like '%NICKEL'
	and s_nationkey = n_nationkey
and n_regionkey = r_regionkey
and r_name = 'AMERICA'
	and ps_supplycost = (
select
min(ps_supplycost)
from
partsupp,
supplier,
nation,
region
where
p_partkey = ps_partkey
and s_suppkey = ps_suppkey
and s_nationkey = n_nationkey
and n_regionkey = r_regionkey
and r_name = 'AMERICA'
	)
order by
s_acctbal desc,
n_name,
s_name,
p_partkey
LIMIT 100;
EXPLAIN
-> Limit: 100 row(s)
    -> Sort: supplier.s_acctbal DESC, nation.n_name, supplier.s_name, part.p_partkey, limit input to 100 row(s) per chunk
        -> Stream results  (cost=26.42 rows=2)
            -> Nested loop inner join  (cost=26.42 rows=2)
                -> Nested loop inner join  (cost=20.98 rows=16)
                    -> Nested loop inner join  (cost=15.53 rows=16)
                        -> Nested loop inner join  (cost=13.00 rows=4)
                            -> Filter: (region.r_name = 'AMERICA')  (cost=0.75 rows=1)
                                -> Table scan on region  (cost=0.75 rows=5)
                            -> Filter: (part.p_type like '%NICKEL')  (cost=9.14 rows=4)
                                -> Index lookup on part using p_size_idx (p_size=32)  (cost=9.14 rows=35)
                        -> Filter: (partsupp.ps_supplycost = (select #2))  (cost=0.35 rows=4)
                            -> Index lookup on partsupp using PRIMARY (ps_partkey=part.p_partkey)  (cost=0.35 rows=4)
                            -> Select #2 (subquery in condition; dependent)
                                -> Aggregate: min(partsupp.ps_supplycost)
                                    -> Nested loop inner join  (cost=4.20 rows=0)
                                        -> Nested loop inner join  (cost=2.80 rows=4)
                                            -> Nested loop inner join  (cost=1.40 rows=4)
                                                -> Filter: (region.r_name = 'AMERICA')  (cost=0.75 rows=1)
                                                    -> Table scan on region  (cost=0.75 rows=5)
                                                -> Index lookup on partsupp using PRIMARY (ps_partkey=part.p_partkey)  (cost=0.65 rows=4)
                                            -> Single-row index lookup on supplier using PRIMARY (s_suppkey=partsupp.ps_suppkey)  (cost=0.27 rows=1)
                                        -> Filter: (nation.n_regionkey = region.r_regionkey)  (cost=0.25 rows=0)
                                            -> Single-row index lookup on nation using PRIMARY (n_nationkey=supplier.s_nationkey)  (cost=0.25 rows=1)
                    -> Single-row index lookup on supplier using PRIMARY (s_suppkey=partsupp.ps_suppkey)  (cost=0.26 rows=1)
                -> Filter: (nation.n_regionkey = region.r_regionkey)  (cost=0.25 rows=0)
                    -> Single-row index lookup on nation using PRIMARY (n_nationkey=supplier.s_nationkey)  (cost=0.25 rows=1)

Warnings:
Note	1276	Field or reference 'test.part.p_partkey' of SELECT #2 was resolved in SELECT #1
explain format=tree select
*
from (
select
ps_partkey,
sum(ps_supplycost * ps_availqty) as value
from
partsupp,
supplier,
nation
where
ps_suppkey = s_suppkey
and s_nationkey = n_nationkey
and n_name = 'GERMANY'
  group by
ps_partkey
) as inner_query
where
value > (
select
sum(ps_supplycost * ps_availqty) * 0.0001
from
partsupp,
supplier,
nation
where
ps_suppkey = s_suppkey
and s_nationkey = n_nationkey
and n_name = 'GERMANY'
  )
order by
value desc;
EXPLAIN
-> Sort: inner_query.`value` DESC
    -> Filter: (inner_query.`value` > (select #3))  (cost=11.67 rows=200)
        -> Table scan on inner_query  (cost=11.67 rows=200)
            -> Materialize
                -> Table scan on <temporary>
                    -> Aggregate using temporary table
                        -> Nested loop inner join  (cost=74.38 rows=200)
                            -> Nested loop inner join  (cost=4.38 rows=10)
                                -> Filter: (nation.n_name = 'GERMANY')  (cost=2.75 rows=3)
                                    -> Table scan on nation  (cost=2.75 rows=25)
                                -> Index lookup on supplier using s_nationkey_idx (s_nationkey=nation.n_nationkey)  (cost=0.41 rows=4)
                            -> Index lookup on partsupp using ps_suppkey_idx (ps_suppkey=supplier.s_suppkey)  (cost=5.20 rows=20)
        -> Select #3 (subquery in condition; run only once)
            -> Aggregate: sum((partsupp.ps_supplycost * partsupp.ps_availqty))
                -> Nested loop inner join  (cost=74.38 rows=200)
                    -> Nested loop inner join  (cost=4.38 rows=10)
                        -> Filter: (nation.n_name = 'GERMANY')  (cost=2.75 rows=3)
                            -> Table scan on nation  (cost=2.75 rows=25)
                        -> Index lookup on supplier using s_nationkey_idx (s_nationkey=nation.n_nationkey)  (cost=0.41 rows=4)
                    -> Index lookup on partsupp using ps_suppkey_idx (ps_suppkey=supplier.s_suppkey)  (cost=5.20 rows=20)

explain select
c_count,
count(*) as custdist
from (
select
c_custkey,
count(o_orderkey) as c_count
from
customer left outer join orders on (
c_custkey = o_custkey
and o_comment not like '%special%requests%'
    )
group by
c_custkey
) as c_orders
group by
c_count
order by
custdist desc,
c_count desc;

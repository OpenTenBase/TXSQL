explain format=tree select sum(id) from testText where id <= 2;
EXPLAIN
-> Aggregate: sum(testText.id)
    -> PX Receiver (slice: 0; workers: 1)
        -> PX Sender (slice: 1; workers: 1)
            -> Aggregate: sum(testText.id)  (cost=1.66 rows=1)
                -> Filter: (testText.id <= 2)  (cost=1.36 rows=3)

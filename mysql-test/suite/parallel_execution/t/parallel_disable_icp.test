--source include/have_debug.inc
--disable_ps_protocol

show grants;
connect(conn1,localhost,root,,);
select user();
create database test1;
create user 'user1'@'%';
grant all on *.* to 'user1'@'%';

set optimizer_switch='index_condition_pushdown=on';
set optimizer_switch='semijoin=off';
set optimizer_switch='materialization=off';
set optimizer_switch='mrr=off';
set default_storage_engine=InnoDB;


SET sql_mode = 'NO_ENGINE_SUBSTITUTION';
CREATE TABLE t1(
  c1 TIMESTAMP NOT NULL, 
  c2 TIMESTAMP NULL, 
  c3 DATE, 
  c4 DATETIME, 
  PRIMARY KEY(c1), 
  UNIQUE INDEX(c2)
);

INSERT INTO t1 VALUES
  ('0000-00-00 00:00:00','0000-00-00 00:00:00','2008-01-04','2008-01-05 00:00:00'),
  ('1971-01-01 00:00:01','1980-01-01 00:00:01','2009-01-01','2009-01-02 00:00:00'),
  ('1999-01-01 00:00:00','1999-01-01 00:00:00', NULL,        NULL),
  ('2007-05-23 09:15:28','2007-05-23 09:15:28','2007-05-24','2007-05-24 09:15:28'),
  ('2007-05-27 00:00:00','2007-05-25 00:00:00','2007-05-26','2007-05-26 00:00:00'),
  ('2008-01-01 00:00:00', NULL,                '2008-01-02','2008-01-03 00:00:00'),
  ('2009-01-29 11:11:27','2009-01-29 11:11:27','2009-01-29','2009-01-29 11:11:27'),
  ('2038-01-09 03:14:07','2038-01-09 03:14:07','2009-01-05','2009-01-06 00:00:00');

ANALYZE TABLE t1;

connection conn1;
SET @saved_cdb_parallel_query_enable =@@cdb_parallel_query_enable;
SET @saved_cdb_parallel_execution_enabled =@@cdb_parallel_execution_enabled;
SET @saved_exchange_inject =@@exchange_inject;
SET @saved_cdb_min_parallel_table_rows=@@cdb_min_parallel_table_rows;

set global cdb_parallel_query_enable = on;
set global cdb_parallel_execution_enabled = on;
set global exchange_inject = on;
set global cdb_min_parallel_table_rows = 0;
connect(conn2,localhost,user1,,);

EXPLAIN FORMAT=TREE SELECT * 
FROM t1 
WHERE c2 IN ('1971-01-01 00:00:01','2038-01-09 03:14:07') 
ORDER BY c2;

SELECT * 
FROM t1
WHERE c2 IN ('1971-01-01 00:00:01','2038-01-09 03:14:07') 
ORDER BY c2;

connection conn1;
set global cdb_parallel_query_enable = @saved_cdb_parallel_query_enable;
set global cdb_parallel_execution_enabled = @saved_cdb_parallel_execution_enabled;
set global exchange_inject = @saved_exchange_inject;
set global cdb_min_parallel_table_rows = @saved_cdb_min_parallel_table_rows;
set optimizer_switch=default;

DROP TABLE t1;
drop database test1;
drop user user1;
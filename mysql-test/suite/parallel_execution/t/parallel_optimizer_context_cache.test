--echo ###############################################
--echo # pq optimization context copy test
--echo ###############################################
--echo # 1) test reading handler::stats
--echo # 2) test reading the value of index dive and handler::stats
--echo # 3) test optimization context with DETERMINISTIC FUNCTION
--echo # 4) test optimization context with sub stmt
--echo # 5) test copying resource of now()
--echo # 6) test cache status counter
--echo # 7) test copying resource of user()
--echo # 8) test copying resource of last insert id
--echo # 9) test ror scan of index dive cache
--echo # 10) test copying user vars

--source include/have_pq.inc
--disable_ps_protocol
--source include/have_optimizer_trace.inc

--echo
--echo # 1) test reading const table and handler::stats
--echo
CREATE TABLE t1 (
  f1 varchar(16) collate latin1_swedish_ci PRIMARY KEY,
  f2 varchar(16) collate latin1_swedish_ci
);
CREATE TABLE t2 (
  f1 varchar(16) collate latin1_swedish_ci PRIMARY KEY,
  f3 varchar(16) collate latin1_swedish_ci
);

INSERT INTO t1 VALUES ('bla','blah');
INSERT INTO t1 VALUES ('blc','blad');
INSERT INTO t1 VALUES ('bld','blad');
INSERT INTO t2 VALUES ('bla','sheep');
INSERT INTO t2 VALUES ('blc','sheep');
INSERT INTO t2 VALUES ('bld','sheep');

SET optimizer_trace="enabled=on";
SET optimizer_trace_features="statistics=on";
SELECT * FROM t1 LEFT JOIN t2 USING(f1) WHERE f1='bla';
--replace_regex /table\S:[^\n\r]+/table=***/  /cost\S:[^\n\r]+/cost=***/ /cost\Sfor\Splan\S:[^\n\r]+/cost=***/
SELECT * FROM information_schema.optimizer_trace;
SET optimizer_trace="enabled=off";
DROP TABLE t1,t2;

--echo
--echo # 2) test reading the value of index dive and handler::stats
--echo
CREATE TABLE t2 (
  auto int not null auto_increment,
  fld1 int(6) unsigned zerofill DEFAULT '000000' NOT NULL,
  companynr tinyint(2) unsigned zerofill DEFAULT '00' NOT NULL,
  fld3 char(30) DEFAULT '' NOT NULL,
  fld4 char(35) DEFAULT '' NOT NULL,
  fld5 char(35) DEFAULT '' NOT NULL,
  fld6 char(4) DEFAULT '' NOT NULL,
  UNIQUE fld1 (fld1),
  KEY fld3 (fld3),
  PRIMARY KEY (auto)
);

create table t3 (
 period    int not null,
 name      char(32) not null,
 companynr int not null,
 price     double(11,0),
 price2     double(11,0),
 key (period),
 key (name)
);

--disable_query_log

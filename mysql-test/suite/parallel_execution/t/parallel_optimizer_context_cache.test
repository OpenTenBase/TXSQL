--sorted_result
select name,count(*) from t3 where name >= "extramarital" and price <= 39654943 group by name;
--replace_regex /table\S:[^\n\r]+/table=***/  /cost\S:[^\n\r]+/cost=***/ /cost\Sfor\Splan\S:[^\n\r]+/cost=***/

#################################################
# Test for parallel query merge sort exceptions #
#################################################
--source include/have_debug.inc
--source suite/parallel_execution/inc/save_and_set_px.inc

DROP TABLE IF EXISTS t1;
CREATE TABLE t1(
        id INT PRIMARY KEY AUTO_INCREMENT,
        col1 VARCHAR(100),
        col2 INT,
        KEY idx_col2(col2)
 )ENGINE = InnoDB;

--disable_query_log
 let $loop=10;
 while($loop)
 {
  eval INSERT INTO t1(col1, col2) VALUES(repeat('test', 4), $loop);
  dec $loop;
 }

ANALYZE TABLE t1;
--enable_query_log

EXPLAIN FORMAT=TREE SELECT id, col2 FROM t1 FORCE INDEX(idx_col2) WHERE col2 < 3;

set session debug="+d,px_partition_error1";
set session debug="+d,px_partition_error2";
set session debug="+d,px_partition_error3";
set session debug="+d,px_partition_error4";
set session debug="+d,px_partition_error5";

--echo ###
--echo ### HA_ERR_TABLE_DEF_CHANGED in px_do_partition
--echo ###
--echo # Fallback for ER_TABLE_DEF_CHANGED
EXPLAIN FORMAT=TREE SELECT id, col2 FROM t1 FORCE INDEX(idx_col2) WHERE col2 < 3;

set session debug="-d,px_partition_error1";
--echo ###
--echo ### Create PX_reader oom
--echo ###
--echo # Fallback for ER_OUT_OF_RESOURCES
EXPLAIN FORMAT=TREE SELECT id, col2 FROM t1 FORCE INDEX(idx_col2) WHERE col2 < 3;

set session debug="-d,px_partition_error2";
--echo ###
--echo ### make partition tuple error
--echo ###
--echo # Fallback for ER_GET_ERRNO
EXPLAIN FORMAT=TREE SELECT id, col2 FROM t1 FORCE INDEX(idx_col2) WHERE col2 < 3;

set session debug="-d,px_partition_error3";
--echo ###
--echo ### add_scan oom
--echo ###
--echo # Fallback for ER_GET_ERRNO
EXPLAIN FORMAT=TREE SELECT id, col2 FROM t1 FORCE INDEX(idx_col2) WHERE col2 < 3;
--echo # Fallback for ER_GET_ERRNO
EXPLAIN FORMAT=TREE SELECT * FROM t1;

set session debug="-d,px_partition_error4";
--echo ###
--echo ### repartitioning oom
--echo ###
--echo # Fallback for ER_GET_ERRNO
EXPLAIN FORMAT=TREE SELECT id, col2 FROM t1 FORCE INDEX(idx_col2) WHERE col2 < 3;

set session debug="-d,px_partition_error5";
EXPLAIN FORMAT=TREE SELECT id, col2 FROM t1 FORCE INDEX(idx_col2) WHERE col2 < 3;

--echo ###
--echo ### tablespace was discarded
--echo ###
ALTER TABLE t1 DISCARD TABLESPACE;
--echo # Fallback for ER_TABLESPACE_DISCARDED
EXPLAIN FORMAT=TREE SELECT id, col2 FROM t1 FORCE INDEX(idx_col2) WHERE col2 < 3;

--source suite/parallel_execution/inc/set_px_to_saved.inc
DROP TABLE t1;
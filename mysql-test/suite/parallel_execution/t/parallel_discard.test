
--source suite/parallel_execution/inc/have_txsql.inc
--source include/have_pq.inc
--disable_ps_protocol

DROP TABLE IF EXISTS t1;
CREATE TABLE t1(
        id INT PRIMARY KEY AUTO_INCREMENT,
        col1 VARCHAR(100),
        col2 INT,
        KEY idx_col2(col2)
 )ENGINE = InnoDB;

--disable_query_log
 let $loop=10;
 while($loop)
 {
  eval INSERT INTO t1(col1, col2) VALUES(repeat('test', 4), $loop);
  dec $loop;
 }

ANALYZE TABLE t1;
--enable_query_log

--echo ###
--echo ### tablespace was discarded
--echo ###
ALTER TABLE t1 DISCARD TABLESPACE;
--echo # Fallback for ER_TABLESPACE_DISCARDED
EXPLAIN FORMAT=TREE SELECT id, col2 FROM t1 FORCE INDEX(idx_col2) WHERE col2 < 3;
--error ER_TABLESPACE_DISCARDED
SELECT id, col2 FROM t1 FORCE INDEX(idx_col2) WHERE col2 < 3;

DROP TABLE t1;
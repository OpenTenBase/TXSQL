--echo # Infrastructure for Enhanced Prepare once
--disable_ps_protocol

show grants;
connect(conn1,localhost,root,,);
select user();
create database test1;
create user 'user1'@'%';
grant all on test1.* to 'user1'@'%';

CREATE TABLE t1 (f1 INT) ENGINE="InnoDB";

connection conn1;
SET global autocommit=0;
--source suite/parallel_execution/inc/save_and_set_px.inc

connect(conn2,localhost,user1,,);
UNLOCK TABLES;
LOCK TABLES t1 WRITE;
INSERT INTO t1 VALUES (2);
INSERT INTO t1 VALUES (2);
INSERT INTO t1 VALUES (2);
INSERT INTO t1 VALUES (2);
INSERT INTO t1 VALUES (2);
INSERT INTO t1 VALUES (2);
INSERT INTO t1 VALUES (2);
INSERT INTO t1 VALUES (2);
INSERT INTO t1 VALUES (2);

explain format=tree SELECT f1 FROM t1;
SELECT f1 FROM t1;
COMMIT;

UNLOCK TABLES;

connection conn1;
set global autocommit = 1;
--source suite/parallel_execution/inc/set_px_to_saved.inc

drop table t1;
drop database test1;
drop user user1;
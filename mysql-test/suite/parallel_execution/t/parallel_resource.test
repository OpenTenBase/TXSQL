--echo # Infrastructure for test resource allocation of parallel execution
# test plan for resource allocation of parallel execution.
# 1. Test the resource allocation.
# 2. Multiple query execute concurrently.

source include/have_debug.inc;
source include/have_debug_sync.inc;

show grants;
connect(conn1,localhost,root,,);
select user();

create database test1;

create user 'user1'@'%';
grant all on test1.* to 'user1'@'%';

# Build the test case schema.
create table t1(a int, b int, c int, d int);
insert into t1 values(1,2,3,4);
insert into t1 values(1,1,1,1);
insert into t1 values(2,3,4,5);
insert into t1 values(2,2,2,2);
insert into t1 values(3,4,5,6);
insert into t1 values(4,5,6,7);
insert into t1 values(5,6,7,8);

create table t2(a int, b int, c int, d int);
insert into t2 values(1,1,1,1);
insert into t2 values(2,2,2,2);
insert into t2 values(3,3,3,3);
insert into t2 values(4,4,4,4);
insert into t2 values(5,5,5,5);

create table t3(a int, b int, c int, d int, primary key(a), key idx(b));
insert into t3 values(1,1,1,1);
insert into t3 values(2,2,2,2);
insert into t3 values(3,3,3,3);
insert into t3 values(4,4,4,4);
insert into t3 values(5,5,5,5);
insert into t3 values(6,6,6,6);
insert into t3 values(7,7,7,7);
insert into t3 values(8,8,8,8);
insert into t3 values(9,9,9,9);
insert into t3 values(10,10,10,10);

create table t4(a int, b int, c int, d int);
insert into t4 values(100,100,100,100);

create table t5(a int, b int, c int, d int, primary key(a));
insert into t5 values(1,1,1,1);
insert into t5 values(2,2,2,2);
insert into t5 values(3,3,3,3);
insert into t5 values(4,4,4,4);

create table t6(a int, b int, c int, d int, primary key(a), foreign key (d) references t3(a));
insert into t6 values(1,1,1,1);
insert into t6 values(2,2,2,2);
insert into t6 values(3,3,3,3);
insert into t6 values(4,4,4,4);

connection conn1;
--source suite/parallel_execution/inc/save_and_set_px.inc
set global debug='+d,disable_debug_sync_check';
set global px_parallel_table_record_threshold = 2;

# test multiple query execute concurrently. both not
set global px_max_parallel_threads = 3;
show status like '%px%';

# one hang before execute, and add other one query, all not px.
connect(conn3,localhost,root,,);
--let $id= `SELECT CONNECTION_ID()`
set debug_sync="execute_in_parallel_before SIGNAL waiting wait_for flushed";
--send select a,sum(b) from t1 group by a;

connect(conn4,localhost,root,,);
let $wait_condition=select count(*)=1 from information_schema.processlist where state like '%parallel_before%';
--source include/wait_condition.inc
select a,avg(b) from t1 group by a union select a,b from t2;
SET DEBUG_SYNC= 'now WAIT_FOR waiting';
--replace_result $id <id>
--eval KILL QUERY $id
SET DEBUG_SYNC= 'now SIGNAL killed';

connection conn3;
--error ER_QUERY_INTERRUPTED
--reap;
SET DEBUG_SYNC = 'RESET';
show status like '%px%';

#two hang before execute, and add other one query, all not px, at last execute one.
connect(conn5,localhost,root,,);
--let $id= `SELECT CONNECTION_ID()`
set debug_sync="execute_in_parallel_before SIGNAL waiting wait_for flushed";
--send select a,sum(b) from t1 group by a union select a,b from t2;

connect(conn6,localhost,root,,);
let $wait_condition=select count(*)=1 from information_schema.processlist where state like '%parallel_before%';
--source include/wait_condition.inc
select a,avg(b) from t1 group by a union select a,sum(c) from t2 group by a;
SET DEBUG_SYNC= 'now WAIT_FOR waiting';
--replace_result $id <id>
--eval KILL QUERY $id
SET DEBUG_SYNC= 'now SIGNAL killed';

connection conn5;
--error ER_QUERY_INTERRUPTED
--reap;
SET DEBUG_SYNC = 'RESET';
show status like '%px%';

connection conn5;
select a,avg(b) from t1 group by a union select a,sum(c) from t2 group by a;
show status like '%px%';

#three, increate to threadpool to 16, execute one px.
set global px_max_parallel_threads = 16;
connect(conn7,localhost,root,,);
--let $id= `SELECT CONNECTION_ID()`
set debug_sync="execute_in_parallel_before SIGNAL waiting wait_for flushed";
--send select a,sum(b) from t1 group by a union select a,b from t2 union select a,sum(b) from t3 group by a;

connect(conn8,localhost,root,,);
let $wait_condition=select count(*)=1 from information_schema.processlist where state like '%parallel_before%';
--source include/wait_condition.inc
select a,avg(b),sum(c) from t1 group by a;
SET DEBUG_SYNC= 'now WAIT_FOR waiting';
--replace_result $id <id>
--eval KILL QUERY $id
SET DEBUG_SYNC= 'now SIGNAL killed';

connection conn7;
--error ER_QUERY_INTERRUPTED
--reap;
SET DEBUG_SYNC = 'RESET';
show status like '%px%';

connection conn1;
--source suite/parallel_execution/inc/set_px_to_saved.inc

drop table t1;
drop table t2;
drop table t6;
drop table t3;
drop table t4;
drop table t5;
drop database test1;
drop user user1;

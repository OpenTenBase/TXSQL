--source include/have_debug.inc
--disable_ps_protocol

show grants;
connect(conn1,localhost,root,,);
select user();
create database test1;
create user 'user1'@'%';
grant all on *.* to 'user1'@'%';

CREATE TABLE `testText` (
  `id` int(11) unsigned NOT NULL,
  `before` char(6) NOT NULL DEFAULT 'before',
  `data` LONGTEXT NOT NULL,
  `after` char(5) NOT NULL DEFAULT 'after',
  PRIMARY KEY (`id`) ) ENGINE=InnoDB DEFAULT CHARSET=latin1;

INSERT INTO testText (id,data) VALUES (0,repeat('0123456789abcdef',1));
INSERT INTO testText (id,data) VALUES (1,repeat('0123456789abcdef',510));
INSERT INTO testText (id,data) VALUES (2,repeat('0123456789abcdef',510));
INSERT INTO testText (id,data) VALUES (3,repeat('0123456789abcdef',510));
ANALYZE TABLE testText;

SET global debug = "+d,px_no_row_split";

connection conn1;
--source suite/parallel_execution/inc/save_and_set_px.inc
connect(conn2,localhost,user1,,);
set session txsql_parallel_lob_enabled=1;
show variables like '%txsql_parallel_lob_enabled%';

explain format=tree select sum(id) from testText where id <= 2;
select sum(id) from testText where id <= 2;

SET global debug = "-d,px_no_row_split";

EXPLAIN FORMAT=TREE SELECT /*+PARALLEL(0)*/ * FROM testText;
SELECT /*+PARALLEL(0)*/ * FROM testText;

EXPLAIN FORMAT=TREE SELECT /*+PARALLEL(1)*/ * FROM testText;
SELECT /*+PARALLEL(1)*/ * FROM testText;

EXPLAIN FORMAT=TREE SELECT /*+PARALLEL(1)*/ * FROM testText order by data;
SELECT /*+PARALLEL(1)*/ * FROM testText order by data;

INSERT INTO testText (id,data) VALUES (4,repeat('0123456789abcdef',10000));
ANALYZE TABLE testText;
EXPLAIN FORMAT=TREE SELECT /*+PARALLEL(1)*/ * FROM testText;
--error ER_PX_EXECUTE_ERROR
SELECT /*+PARALLEL(1)*/ * FROM testText;

EXPLAIN FORMAT=TREE SELECT /*+PARALLEL(1)*/ * FROM testText order by data;
--error ER_PX_EXECUTE_ERROR
SELECT /*+PARALLEL(1)*/ * FROM testText order by data;

set session txsql_parallel_lob_enabled=0;
show variables like '%txsql_parallel_lob_enabled%';

connection conn1;
--source suite/parallel_execution/inc/set_px_to_saved.inc

DROP TABLE testText;
drop database test1;
drop user user1;
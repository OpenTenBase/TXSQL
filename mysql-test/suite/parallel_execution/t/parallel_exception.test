--echo # Infrastructure for test error and kill of parallel execution
# test plan for multiple stage(unify) test.
# 1. Set up error checking on each critical point of the whole path.
# 2. Set up DEBUG_SYNC_C point to be killed.
# 3. Test cleanup by add sleep to extend worker execution time.

source include/have_debug.inc;
source include/have_debug_sync.inc;
--disable_ps_protocol

--disable_query_log
#call mtr.add_suppression("THD::check_error_before_sending_data");
#call mtr.add_suppression("Send compact row to exchange channel fail");
--enable_query_log

show grants;
connect(conn1,localhost,root,,);
select user();

create database test1;

create user 'user1'@'%';
grant all on test1.* to 'user1'@'%';

# Build the test case schema.
create table t1(a int, b int, c int, d int);
insert into t1 values(1,2,3,4);
insert into t1 values(1,1,1,1);
insert into t1 values(2,3,4,5);
insert into t1 values(2,2,2,2);
insert into t1 values(3,4,5,6);
insert into t1 values(4,5,6,7);
insert into t1 values(5,6,7,8);

create table t2(a int, b int, c int, d int);
insert into t2 values(1,1,1,1);
insert into t2 values(2,2,2,2);
insert into t2 values(3,3,3,3);
insert into t2 values(4,4,4,4);
insert into t2 values(5,5,5,5);

create table t3(a int, b int, c int, d int, primary key(a), key idx(b));
insert into t3 values(1,1,1,1);
insert into t3 values(2,2,2,2);
insert into t3 values(3,3,3,3);
insert into t3 values(4,4,4,4);
insert into t3 values(5,5,5,5);
insert into t3 values(6,6,6,6);
insert into t3 values(7,7,7,7);
insert into t3 values(8,8,8,8);
insert into t3 values(9,9,9,9);
insert into t3 values(10,10,10,10);

create table t4(a int, b int, c int, d int);
insert into t4 values(100,100,100,100);

create table t5(a int, b int, c int, d int);

connection conn1;
--source suite/parallel_execution/inc/save_and_set_px.inc
set txsql_parallel_table_record_threshold = 2;
set global debug = '+d, disable_debug_sync_check';

flush status;

# test overview(killing/error/fallback/sleep):
# 1. before execute in parallel.
# 2. before query.
# 3. before schedule.
# 4. schedule one loop.
# 5. run root.
# 6. after schedule.
# 7. other exceptions.

#====================//** 1. before execute in parallel.=======================
#==============** 1.0 execute_in_parallel_before_kill.
connect(conn101,localhost,root,,);
--let $id= `SELECT CONNECTION_ID()`
set debug_sync='execute_in_parallel_before_kill SIGNAL waiting wait_for killed';
--send select a,sum(b) from t1 group by a order by a;

connection conn1;
SET DEBUG_SYNC= 'now WAIT_FOR waiting';
--replace_result $id <id>
--eval KILL QUERY $id
SET DEBUG_SYNC= 'now SIGNAL killed';

connection conn101;
--error ER_QUERY_INTERRUPTED
--reap;
SET DEBUG_SYNC = 'RESET';

connect(conn102,localhost,root,,);
--let $id= `SELECT CONNECTION_ID()`
set debug_sync='execute_in_parallel_before_kill SIGNAL waiting wait_for killed';
--send select a,sum(b) from t4 group by a union select a,b from t2 order by a;

connection conn1;
SET DEBUG_SYNC= 'now WAIT_FOR waiting';
--replace_result $id <id>
--eval KILL QUERY $id
SET DEBUG_SYNC= 'now SIGNAL killed';

connection conn102;
--error ER_QUERY_INTERRUPTED
--reap;
SET DEBUG_SYNC = 'RESET';

connect(conn103,localhost,root,,);
--let $id= `SELECT CONNECTION_ID()`
set debug_sync='execute_in_parallel_before_kill SIGNAL waiting wait_for killed';
--send (select a,sum(b) from t4 group by a order by a) union (select a,b from t2 order by a);

connection conn1;
SET DEBUG_SYNC= 'now WAIT_FOR waiting';
--replace_result $id <id>
--eval KILL QUERY $id
SET DEBUG_SYNC= 'now SIGNAL killed';

connection conn103;
--error ER_QUERY_INTERRUPTED
--reap;
SET DEBUG_SYNC = 'RESET';

connection conn1;
(select a,sum(b) from t4 group by a order by a) union (select a,b from t2 order by a);

connect(conn104,localhost,root,,);
--let $id= `SELECT CONNECTION_ID()`
set debug_sync='execute_in_parallel_before_kill SIGNAL waiting wait_for killed';
--send select a,b from t4 union (select a,b from t2 order by a);

connection conn1;
SET DEBUG_SYNC= 'now WAIT_FOR waiting';
--replace_result $id <id>
--eval KILL QUERY $id
SET DEBUG_SYNC= 'now SIGNAL killed';

connection conn104;
--error ER_QUERY_INTERRUPTED
--reap;
SET DEBUG_SYNC = 'RESET';

show status like '%txsql_parallel%';

#==============** 1.1 execute_in_parallel_before_error.
connect(conn111,localhost,root,,);
connection conn111;
set session debug="+d,execute_in_parallel_before_error";
--error ER_STD_BAD_ALLOC_ERROR
select a, sum(b) from t1 group by a;

connect(conn112,localhost,root,,);
connection conn112;
set session debug="+d,execute_in_parallel_before_error";
--error ER_STD_BAD_ALLOC_ERROR
select a,b from t1 union select a,c from t2;

show status like '%txsql_parallel%';

#==============** 1.2 execute_in_parallel_before_fallback.
connect(conn121,localhost,root,,);
connection conn121;
set session debug="+d,execute_in_parallel_before_fallback";
select a, sum(b) from t1 group by a order by a;

connect(conn122,localhost,root,,);
connection conn122;
set session debug="+d,execute_in_parallel_before_fallback";
(select a,b from t1 order by a) union (select a,c from t2 order by a);

show status like '%txsql_parallel%';

#==============** 1.3 execute_in_parallel_before_sleep.
connect(conn131,localhost,root,,);
connection conn131;
set session debug="+d,execute_in_parallel_before_sleep";
select a,b,c,d from t1;

connect(conn132,localhost,root,,);
connection conn132;
set session debug="+d,execute_in_parallel_before_sleep";
(select a,b,c,d from t1) union (select a,b,sum(c),sum(d) from t2 group by a,b order by a,b);

show status like '%txsql_parallel%';

#====================//** 2. schedule before query begin.======================
#==============** 2.0 schedule_before_kill.
connect(conn201,localhost,root,,);
--let $id= `SELECT CONNECTION_ID()`
set debug_sync='schedule_before_kill SIGNAL waiting wait_for killed';
--send select a,sum(b),avg(d) from t1 group by a order by a;

connection conn1;
SET DEBUG_SYNC= 'now WAIT_FOR waiting';
--replace_result $id <id>
--eval KILL QUERY $id
SET DEBUG_SYNC= 'now SIGNAL killed';

connection conn201;
--error ER_QUERY_INTERRUPTED
--reap;
SET DEBUG_SYNC = 'RESET';

connect(conn202,localhost,root,,);
--let $id= `SELECT CONNECTION_ID()`
set debug_sync='schedule_before_kill SIGNAL waiting wait_for killed';
--send (select a,b,c from t2) union (select a,b,c from t1 order by a);

connection conn1;
SET DEBUG_SYNC= 'now WAIT_FOR waiting';
--replace_result $id <id>
--eval KILL QUERY $id
SET DEBUG_SYNC= 'now SIGNAL killed';

connection conn202;
--error ER_QUERY_INTERRUPTED
--reap;
SET DEBUG_SYNC = 'RESET';

show status like '%txsql_parallel%';

#==============** 2.1 schedule_before_error(never).
#==============** 2.2 schedule_before_fallback.
connect(conn221,localhost,root,,);
connection conn221;
set session debug="+d,schedule_before_fallback";
select a, sum(b), avg(c)+avg(d) from t2 group by a order by a;

connect(conn222,localhost,root,,);
connection conn222;
set session debug="+d,schedule_before_fallback";
(select a,b,sum(c) from t1 group by a,b) union (select a, sum(b), avg(c)+avg(d) from t2 group by a order by a);

show status like '%txsql_parallel%';

#==============** 2.3 schedule_before_sleep.
connect(conn231,localhost,root,,);
connection conn231;
set session debug="+d,schedule_before_sleep";
select a,b,c,d from t1 order by d;

connect(conn232,localhost,root,,);
connection conn232;
set session debug="+d,schedule_before_sleep";
(select a,b,c,d from t1 order by d) union (select a,b,sum(c),sum(d) from t2 group by a,b);

show status like '%txsql_parallel%';

#====================//** 3. schedule before schedule begin.======================
#==============** 3.0 schedule_before_schedule_kill.
connect(conn301,localhost,root,,);
--let $id= `SELECT CONNECTION_ID()`
set debug_sync='schedule_before_schedule_kill SIGNAL waiting wait_for killed';
--send select /*+no_bnl(t1,t2)*/ t1.* from t1,t2 where t1.a = t2.a;

connection conn1;
SET DEBUG_SYNC= 'now WAIT_FOR waiting';
--replace_result $id <id>
--eval KILL QUERY $id
SET DEBUG_SYNC= 'now SIGNAL killed';

connection conn301;
--error ER_QUERY_INTERRUPTED
--reap;
SET DEBUG_SYNC = 'RESET';

connect(conn302,localhost,root,,);
--let $id= `SELECT CONNECTION_ID()`
set debug_sync='schedule_before_schedule_kill SIGNAL waiting wait_for killed';
--send (select a,b,c from t2 order by a,c) union (select a,b,c from t1 order by a,b);

connection conn1;
SET DEBUG_SYNC= 'now WAIT_FOR waiting';
--replace_result $id <id>
--eval KILL QUERY $id
SET DEBUG_SYNC= 'now SIGNAL killed';

connection conn302;
--error ER_QUERY_INTERRUPTED
--reap;
SET DEBUG_SYNC = 'RESET';

show status like '%txsql_parallel%';
#==============** 3.1 schedule_before_schedule_error.
connection conn1;
set global debug="+d,schedule_before_schedule_error";
connect(conn311,localhost,root,,);
connection conn311;
select b, sum(a) from t1 group by b order by b;
connection conn1;
set global debug="-d,schedule_before_schedule_error";

connection conn1;
set global debug="+d,schedule_before_schedule_error";
connect(conn312,localhost,root,,);
connection conn312;
(select b,a,sum(c) from t1 group by b,a) union (select a,b,c from t2 order by a);
connection conn1;
set global debug="-d,schedule_before_schedule_error";

show status like '%txsql_parallel%';

#==============** 3.2 schedule_before_schedule_fallback.
#==============** 3.3 schedule_before_schedule_sleep.
connect(conn331,localhost,root,,);
connection conn331;
set session debug="+d,schedule_before_schedule_sleep";
select a,b,c,d from t1 order by a,b,c,d;

connect(conn332,localhost,root,,);
connection conn332;
set session debug="+d,schedule_before_schedule_sleep";
(select a,b,c,d from t1 order by a,b,c,d) union all (select d,c,b,a from t2 order by d,c);

show status like '%txsql_parallel%';

#====================//** 4. schedule one loop begin.======================
#==============** 4.0 schedule_one_loop_kill.
connect(conn401,localhost,root,,);
--let $id= `SELECT CONNECTION_ID()`
set debug_sync='schedule_one_loop_kill SIGNAL waiting wait_for killed';
--send select /*+no_bnl(t1,t2)*/ t1.* from t1,t2 where t1.a = t2.a order by t1.a;

connection conn1;
SET DEBUG_SYNC= 'now WAIT_FOR waiting';
--replace_result $id <id>
--eval KILL QUERY $id
SET DEBUG_SYNC= 'now SIGNAL killed';

connection conn401;
--reap;
SET DEBUG_SYNC = 'RESET';

connect(conn402,localhost,root,,);
--let $id= `SELECT CONNECTION_ID()`
set debug_sync='schedule_one_loop_kill SIGNAL waiting wait_for killed';
--send (select /*+no_bnl(t1,t2)*/ t1.* from t1,t2 where t1.a = t2.a order by t1.a) union all (select * from t3);

connection conn1;
SET DEBUG_SYNC= 'now WAIT_FOR waiting';
--replace_result $id <id>
--eval KILL QUERY $id
SET DEBUG_SYNC= 'now SIGNAL killed';

connection conn402;
--error ER_QUERY_INTERRUPTED
--reap;
SET DEBUG_SYNC = 'RESET';

show status like '%txsql_parallel%';

#==============** 4.1 schedule_one_loop_error.
#connection conn1;(worker被干掉了，coordinator没有数据一直在等)
#set global debug="+d,schedule_one_loop_error_worker";
#connect(conn411,localhost,root,,);
#connection conn411;
#select b,a,sum(c+d) from t1 group by b,a order by a,b;
#connection conn1;
#set global debug="-d,schedule_one_loop_error_worker";

#connection conn1;
#set global debug="+d,schedule_one_loop_error_worker";
#connect(conn412,localhost,root,,);
#connection conn412;
#(select a,b,c from t2) union all (select b,a,sum(c+d) from t1 group by b,a order by a,b);
#connection conn1;
#set global debug="-d,schedule_one_loop_error_worker";

#==============** 4.2 schedule_one_loop_fallback.
#==============** 4.3 schedule_one_loop_sleep.
connection conn1;
set global debug="+d,schedule_one_loop_sleep_worker";
connect(conn431,localhost,root,,);
connection conn431;
select a,b,c+d from t1 order by a,b;
connection conn1;
set global debug="-d,schedule_one_loop_sleep_worker";

connection conn1;
set global debug="+d,schedule_one_loop_sleep_worker";
connect(conn432,localhost,root,,);
connection conn432;
(select a,b,c+d from t1 order by a,b) union (select a,b+c,c+d from t2);
connection conn1;
set global debug="-d,schedule_one_loop_sleep_worker";

connect(conn433,localhost,root,,);
connection conn433;
set session debug="+d,schedule_one_loop_sleep";
(select * from t1) union (select * from t2) union (select * from t3);

show status like '%txsql_parallel%';

#====================//** 5. run root begin.======================
#==============** 5.0 run_root_sending_data_kill.
connect(conn501,localhost,root,,);
--let $id= `SELECT CONNECTION_ID()`
set debug_sync='run_root_sending_data_kill SIGNAL waiting wait_for killed';
--send select /*+no_bnl(t1,t2)*/ t1.* from t1,t3 where t1.a = t3.a order by t1.a;

connection conn1;
SET DEBUG_SYNC= 'now WAIT_FOR waiting';
--replace_result $id <id>
--eval KILL QUERY $id
SET DEBUG_SYNC= 'now SIGNAL killed';

connection conn501;
--error ER_QUERY_INTERRUPTED
--reap;
SET DEBUG_SYNC = 'RESET';

connect(conn502,localhost,root,,);
--let $id= `SELECT CONNECTION_ID()`
set debug_sync='run_root_sending_data_kill SIGNAL waiting wait_for killed';
--send (select * from t1 where t1.a > 1) union (select * from t2 order by t2.a);

connection conn1;
SET DEBUG_SYNC= 'now WAIT_FOR waiting';
--replace_result $id <id>
--eval KILL QUERY $id
SET DEBUG_SYNC= 'now SIGNAL killed';

connection conn502;
--error ER_QUERY_INTERRUPTED
--reap;
SET DEBUG_SYNC = 'RESET';

show status like '%txsql_parallel%';
#==============** 5.1 run_root_before_sending_data_error.
connect(conn511,localhost,root,,);
connection conn511;
set session debug="+d,run_root_before_sending_data_error";
select a+b+c+d from t1 where a > 1 order by a,b,c,d;

connect(conn512,localhost,root,,);
connection conn512;
set session debug="+d,run_root_before_sending_data_error";
(select a,b from t2) union (select a+b+c,d from t1 where a > 1 order by a,b,c,d);

#==============** 5.2 run_root_in_sending_data_error.
connect(conn521,localhost,root,,);
connection conn521;
set session debug="+d,run_root_in_sending_data_error";
--error ER_STD_BAD_ALLOC_ERROR
select a, sum(b+c) from t1 where a > 1 group by a order by a;

connect(conn522,localhost,root,,);
connection conn522;
set session debug="+d,run_root_in_sending_data_error";
--error ER_STD_BAD_ALLOC_ERROR
(select a,b from t2) union (select a, sum(b+c) from t1 where a > 1 group by a order by a);

show status like '%txsql_parallel%';

#==============** 5.3 run_root_in_sending_data_sleep.
connect(conn531,localhost,root,,);
connection conn531;
set session debug="+d,run_root_in_sending_data_sleep";
select a+b,c+d from t1 order by a+b,c+d;

connect(conn532,localhost,root,,);
connection conn532;
set session debug="+d,run_root_in_sending_data_sleep";
(select a+b,c+d from t1 order by a+b,c+d) union all (select d+c,b+a from t2 order by d+c);

show status like '%txsql_parallel%';

#====================//** 6. schedule after schedule.======================
#==============** 6.0 schedule_after_schedule_kill.
connect(conn601,localhost,root,,);
--let $id= `SELECT CONNECTION_ID()`
set debug_sync='schedule_after_schedule_kill SIGNAL waiting wait_for killed';
--send (select /*+no_bnl(t1,t2)*/ t1.* from t1,t2 where t1.a = t2.a order by t1.a) union (select * from t3) union (select * from t4 order by a);

connection conn1;
SET DEBUG_SYNC= 'now WAIT_FOR waiting';
--replace_result $id <id>
--eval KILL QUERY $id
SET DEBUG_SYNC= 'now SIGNAL killed';

connection conn601;
--reap;
SET DEBUG_SYNC = 'RESET';

connect(conn602,localhost,root,,);
--let $id= `SELECT CONNECTION_ID()`
set debug_sync='schedule_after_schedule_kill SIGNAL waiting wait_for killed';
--send (select * from t3) union (select * from t4 order by a) union (select /*+no_bnl(t1,t2)*/ t1.* from t1,t2 where t1.a = t2.a order by t1.a);

connection conn1;
SET DEBUG_SYNC= 'now WAIT_FOR waiting';
--replace_result $id <id>
--eval KILL QUERY $id
SET DEBUG_SYNC= 'now SIGNAL killed';

connection conn602;
--reap;
SET DEBUG_SYNC = 'RESET';

show status like '%txsql_parallel%';
#==============** 6.1 schedule_after_schedule_error(never).
#==============** 6.2 schedule_after_schedule_fallback(never).
#==============** 6.3 schedule_after_schedule_sleep.
connect(conn631,localhost,root,,);
connection conn631;
set session debug="+d,schedule_after_schedule_sleep";
select a+b,c+d from t1 order by a,b,c,d;

connect(conn632,localhost,root,,);
connection conn632;
set session debug="+d,schedule_after_schedule_sleep";
(select a+b,c+d from t1 order by a,b,c,d) union all (select d+c,b+a from t2 order by d,c);

show status like '%txsql_parallel%';

#====================//** 7. other exceptions.======================
#==============** 7.0 create threads failed.
connect(conn701,localhost,root,,);
connection conn701;
set session debug="+d,create_partial_threads_error";
select a+b,sum(c),avg(d) from t5 group by a+b;
set session debug="-d,create_partial_threads_error";
show status like '%txsql_parallel%';

# enhanced testing as following:
#--let $num=10000
#--disable_query_log
#while ($num)
#{
#  --eval select a+b,sum(c),avg(d) from t5 group by a+b;
#  --dec $num
#}
#set session debug="-d,create_partial_threads_error";
#show status like '%txsql_parallel%';

#===============** 7.1 test schedule only.
connect(conn702,localhost,root,,);
connection conn702;
select a from t5 union select b from t5 union select c from t5 union select d from t5;
show status like '%txsql_parallel%';

# enhanced testing as following:
#--let $num=10000
#--disable_query_log
#while ($num)
#{
#  --eval select a from t5 union select b from t5 union select c from t5 union select d from t5;
#  --dec $num
#}
#show status like '%txsql_parallel%';

#===============** 7.2 whenever kill by max_execution_time
connect(conn703,localhost,root,,);
connection conn703;
--error ER_QUERY_TIMEOUT
select /*+max_execution_time(2)*/ a,sum(b),sum(c) from t1 group by a;
show status like '%txsql_parallel%';
# The worker thread may have already exited before be killed
SET GLOBAL debug = '+d,px_simulate_worker_timeout_kill';
connect(conn704,localhost,root,,);
connection conn704;
--error ER_QUERY_TIMEOUT
select /*+max_execution_time(1000)*/ * FROM t1;
connection conn703;
SET GLOBAL debug = '-d,px_simulate_worker_timeout_kill';
show status like '%txsql_parallel%';

# enhanced testing as following:
#--let $num=10000
#--disable_query_log
#while ($num)
#{
#  --error ER_QUERY_TIMEOUT
#  --eval select /*+max_execution_time(2)*/ a,sum(b),sum(c) from t1 group by a;
#  --dec $num
#}
#show status like '%txsql_parallel%';

#===============** 7.3 kill coordinator by worker finish early
connect(conn705,localhost,root,,);
set global debug="+d,enter_worker_sleep";

connect(conn706,localhost,root,,);
--let $id= `SELECT CONNECTION_ID()`
set debug_sync='schedule_before_schedule_kill SIGNAL waiting wait_for killed';
--send (select a,b,d from t1) union (select a,b,sum(d) from t2 group by a,b order by a,b);

connection conn705;
SET DEBUG_SYNC= 'now WAIT_FOR waiting';
--replace_result $id <id>
--eval KILL QUERY $id
SET DEBUG_SYNC= 'now SIGNAL killed';

connection conn706;
--error ER_QUERY_INTERRUPTED
--reap;
SET DEBUG_SYNC = 'RESET';

connection conn705;
set global debug="-d,enter_worker_sleep";

##=========================================================================

connection conn1;
--source suite/parallel_execution/inc/set_px_to_saved.inc
flush status;
show status like '%txsql_parallel%';

drop table t1;
drop table t2;
drop table t3;
drop table t4;
drop table t5;
drop database test1;
drop user user1;

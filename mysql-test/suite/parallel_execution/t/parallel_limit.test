--echo # Infrastructure for Enhanced Prepare once

--disable_ps_protocol

show grants;
connect(conn1,localhost,root,,);
select user();

create database test1;

create user 'user1'@'%';
grant all on *.* to 'user1'@'%';

connection conn1;
SET @saved_cdb_parallel_query_enable =@@cdb_parallel_query_enable;
SET @saved_cdb_parallel_execution_enabled =@@cdb_parallel_execution_enabled;
SET @saved_exchange_inject =@@exchange_inject;
SET @saved_cdb_min_parallel_table_rows=@@cdb_min_parallel_table_rows;
set global cdb_parallel_query_enable = on;
set global cdb_parallel_execution_enabled = on;
set global exchange_inject = on;
set global cdb_min_parallel_table_rows = 0;

connect(conn2,localhost,user1,,);

DROP TABLE IF EXISTS t1;
CREATE TABLE t1(
        id INT PRIMARY KEY AUTO_INCREMENT,
        col1 VARCHAR(100),
        col2 INT,
        col3 INT,
        KEY idx_col2(col2)
 )ENGINE = InnoDB;

--disable_query_log
 let $loop=10;
 while($loop)
 {
  eval INSERT INTO t1(col1, col2, col3) VALUES(repeat('test', 4), $loop, $loop);
  dec $loop;
 }
--enable_query_log
ANALYZE TABLE t1;

--echo query without limit
explain format=tree select 1 from t1;
select 1 from t1;

--echo limit after table scan
explain format=tree select * from t1 limit 10;
select * from t1 limit 10;

--echo limit after index scan
explain format=tree select col2 from t1 order by col2 limit 5;
select * from t1 order by col2 limit 5;

explain format=tree select col2 from t1 order by col2 desc limit 5;
select * from t1 order by col2 desc limit 5;

--echo limit after filesort
explain format=tree select sum(id) from t1 group by col3 order by col3 limit 5;
select sum(id) from t1 group by col3 order by col3 limit 5;

connection conn1;
set global cdb_parallel_query_enable = @saved_cdb_parallel_query_enable;
set global cdb_parallel_execution_enabled = @saved_cdb_parallel_execution_enabled;
set global exchange_inject = @saved_exchange_inject;
set global cdb_min_parallel_table_rows = @saved_cdb_min_parallel_table_rows;

DROP TABLE t1;
drop database test1;
drop user user1;

--source include/have_pq.inc
--disable_ps_protocol

show grants;
connect(conn1,localhost,root,,);
select user();

create database test1;

create user 'user1'@'%';
grant all on *.* to 'user1'@'%';

# Build the test case schema.
create table t1(a int, b int, c int, d int);
insert into t1 values(1,2,3,4);
insert into t1 values(2,3,4,5);
insert into t1 values(3,4,5,6);
insert into t1 values(4,5,6,7);
insert into t1 values(5,6,7,8);

create table t2(a int, b int, c int, d int);
insert into t2 values(1,1,1,1);
insert into t2 values(2,2,2,2);
insert into t2 values(3,3,3,3);
insert into t2 values(4,4,4,4);
insert into t2 values(5,5,5,5);

connection conn1;

--source suite/parallel_execution/inc/save_and_set_px.inc

--echo ###
--echo ### statement global check
--echo ###
SET @global_start_value = @@global.transaction_isolation;
SELECT @@global.transaction_isolation;
SET GLOBAL transaction_isolation = SERIALIZABLE;

connect(conn2,localhost,user1,,);
--echo tx_isolation check
SELECT @@transaction_isolation;
explain format=tree select sum(b) from t1;
select sum(b) from t1;

connection conn1;
SET @@global.transaction_isolation = @global_start_value;
connect(conn3,localhost,user1,,);
SELECT @@global.transaction_isolation;

--echo locking_clause check
explain format=tree select sum(b) from t1 for share;
select sum(b) from t1 for share;

explain format=tree select sum(b) from t1 for update;
select sum(b) from t1 for update;

--echo non-select statement test
explain format=tree insert into t2 (a, b, c, d) select a,b,c,d from t1;

--echo explain analyze check
--replace_regex /time=\d+\.\d+\.\.\d+\.\d+/time=N.NNN..N.NNN/
explain analyze select sum(b) from t1;

--echo sp test
delimiter |;
drop procedure if exists px_1|
create procedure px_1()
begin
  explain format=tree select sum(b) from t1;
  select sum(b) from t1;
end|
delimiter ;|
call px_1();
drop procedure px_1;

--echo prepare statement check
prepare stmt1 from 'explain format=tree select sum(?) from t1';
set @arg00='b';
execute stmt1 using @arg00 ;

--echo union check
explain format=tree (select sum(b) from t1) union all (select sum(b) from t2);
(select sum(b) from t1) union all (select sum(b) from t2);

--echo contain partition table
CREATE TABLE t3 (
       id MEDIUMINT NOT NULL AUTO_INCREMENT,
       dt DATE, st VARCHAR(255), uid INT,
       id2nd LONGBLOB, filler VARCHAR(255), PRIMARY KEY(id, dt)
);

INSERT INTO t3 (dt, st, uid, id2nd, filler) VALUES
   ('1991-03-14', 'Initial Insert', 200, 1234567, 'No Data'),
   ('1991-02-26', 'Initial Insert', 201, 1234567, 'No Data'),
   ('1992-03-16', 'Initial Insert', 234, 1234567, 'No Data'),
   ('1992-07-02', 'Initial Insert', 287, 1234567, 'No Data'),
   ('1991-05-26', 'Initial Insert', 256, 1234567, 'No Data'),
   ('1991-04-25', 'Initial Insert', 222, 1234567, 'No Data'),
   ('1993-03-12', 'Initial Insert', 267, 1234567, 'No Data'),
   ('1993-03-14', 'Initial Insert', 291, 1234567, 'No Data'),
   ('1991-12-20', 'Initial Insert', 298, 1234567, 'No Data'),
   ('1994-10-31', 'Initial Insert', 220, 1234567, 'No Data');
ALTER TABLE t3 PARTITION BY LIST (YEAR(dt)) (
    PARTITION d1 VALUES IN (1991, 1994),
    PARTITION d2 VALUES IN (1993),
    PARTITION d3 VALUES IN (1992, 1995, 1996)
);
ANALYZE TABLE t3;
explain format=tree select sum(uid) from t3;
select sum(uid) from t3;
DROP TABLE t3;

--echo myisam table check
create table t3 (
	id  char(16) not null default '',
  data int not null
) engine=myisam;
ANALYZE TABLE t3;
insert into t3 values ("foo", 42);
explain format=tree select sum(data) from t3;
select sum(data) from t3;
DROP TABLE t3;

--echo rollup check
EXPLAIN format=tree SELECT SUM(b) FROM t1 GROUP BY a WITH ROLLUP;
--sorted_result
SELECT SUM(b) FROM t1 GROUP BY a WITH ROLLUP;

--echo zero row limit
explain format=tree select * from t1 limit 0;
select * from t1 limit 0;

--echo select with distinct check
explain format=tree select distinct a from t1;
--sorted_result
select distinct a from t1;

--echo select_count check(using innodb parallel query)
explain format=tree select count(*) from t1;
select count(a) from t1;

--echo windows function check
explain format=tree SELECT a, b, rank() over ( PARTITION BY a ORDER BY b)  AS ranking FROM t1;

--echo ###
--echo ### Field and datatype check
--echo ###
--echo MYSQL_TYPE_BLOB check
CREATE TABLE `testText` (
  `id` int(11) unsigned NOT NULL,
  `before` char(6) NOT NULL DEFAULT 'before',
  `data` text NOT NULL,
  `after` char(5) NOT NULL DEFAULT 'after',
  PRIMARY KEY (`id`) ) ENGINE=InnoDB DEFAULT CHARSET=latin1;

INSERT INTO testText (id,data) VALUES (0,repeat('0123456789abcdef',1));
INSERT INTO testText (id,data) VALUES (1,repeat('0123456789abcdef',510));
INSERT INTO testText (id,data) VALUES (2,repeat('0123456789abcdef',2));
ANALYZE TABLE testText;
--echo blob field in select lists
EXPLAIN format=tree SELECT * FROM testText;
--echo blob field in aggregation function
EXPLAIN format=tree SELECT SUM(data) FROM testText;
--echo blob field in where condtion
EXPLAIN format=tree SELECT count(id) FROM testText WHERE length(data) > 100;
--echo table with blob field but blob field not in read_set
EXPLAIN format=tree SELECT SUM(id) FROM testText;
--sorted_result
SELECT SUM(id) FROM testText;
DROP TABLE testText;

--echo JSON field check
create table test_json ( 
    `id` int auto_increment,
    `obj_json` JSON,
    `arr_json` JSON,
    primary key (`id`)
)engine = InnoDB default charset = utf8mb4;

insert into test_json (obj_json, arr_json)
values ('{"key1": "value", "key2": 2019, "time": "2015-07-29 12:18:29.000000"}', 
        '["xin", 2019, null, true, false, "2019-5-14 21:30:00"]');
insert into test_json (obj_json, arr_json)
values ('{"key1": "value", "key2": 2019, "time": "2015-07-29 12:18:29.000000"}', 
        '["xin", 2019, null, true, false, "2019-5-14 21:30:00"]');
insert into test_json (obj_json, arr_json)
values ('{"key1": "value", "key2": 2019, "time": "2015-07-29 12:18:29.000000"}', 
        '["xin", 2019, null, true, false, "2019-5-14 21:30:00"]');
ANALYZE TABLE test_json;
--echo json field in select lists
EXPLAIN format=tree SELECT * FROM test_json;
--echo blob field in aggregation function
EXPLAIN format=tree SELECT SUM(obj_json) FROM test_json;
--echo table with blob field but blob field not in read_set
EXPLAIN format=tree SELECT SUM(id) FROM test_json;
--sorted_result
SELECT SUM(id) FROM test_json;
DROP TABLE test_json;

--echo ####
--echo ####parallel table check
--echo ####
--echo query without non-const primary table
EXPLAIN FORMAT=TREE SELECT 1;
EXPLAIN FORMAT=TREE SELECT * FROM (select * from t1 where a=1) as tt;

--echo parallel table with full text search
CREATE TABLE ft_test (a VARCHAR(200), b TEXT, FULLTEXT (a,b)) charset utf8mb4;
INSERT INTO ft_test VALUES('MySQL has now support', 'for full-text search'),
                       ('Full-text indexes', 'are called collections'),
                          ('Only MyISAM tables','support collections'),
             ('Function MATCH ... AGAINST()','is used to do a search'),
        ('Full-text search in MySQL', 'implements vector space model');
ANALYZE TABLE ft_test;
SHOW INDEX FROM ft_test;
EXPLAIN FORMAT=tree select * from ft_test where MATCH(a,b) AGAINST ("collections");
DROP TABLE ft_test;

--echo unsafe parallel table scan type check
CREATE TABLE t4 (f1 INT NOT NULL, f2 INT NOT NULL, PRIMARY KEY(f1, f2));
INSERT INTO t4 VALUES (1,1), (1,2), (1,3), (1,4), (1,5),(2,1), (2,2), (2,3), (2,4), (2,5);
INSERT INTO t4 SELECT f1, f2 + 5 FROM t4;
INSERT INTO t4 SELECT f1, f2 + 10 FROM t4;
INSERT INTO t4 SELECT f1, f2 + 20 FROM t4;
INSERT INTO t4 SELECT f1, f2 + 40 FROM t4;
ANALYZE TABLE t4;
EXPLAIN format=tree SELECT f1, f2 FROM t4 WHERE f2 = 40;
DROP TABLE t4;

--echo ####
--echo ####parallel unsafe aggregation function check
--echo ####
explain format=tree select count(a) from t1;
select count(a) from t1;

explain format=tree select count(distinct a) from t1;
select count(distinct a) from t1;

explain format=tree select sum(a) from t1;
select sum(a) from t1;

explain format=tree select sum(distinct a) from t1;
select sum(distinct a) from t1;

explain format=tree select avg(a) from t1;
select avg(a) from t1;

explain format=tree select avg(distinct a) from t1;
select avg(distinct a) from t1;

explain format=tree select VARIANCE(a) from t1;
select VARIANCE(a) from t1;

explain format=tree select VAR_POP(a) from t1;
select VAR_POP(a) from t1;

explain format=tree select VAR_SAMP(a) from t1;
select VAR_SAMP(a) from t1;

explain format=tree select STD(a) from t1;
select STD(a) from t1;

explain format=tree select STDDEV(a) from t1;
select STDDEV(a) from t1;

explain format=tree select STDDEV_POP(a) from t1;
select STDDEV_POP(a) from t1;

CREATE TABLE json_test (`key` varchar(8) DEFAULT NULL, `grp` varchar(8) DEFAULT NULL, `val` varchar(8)) ENGINE=InnoDB DEFAULT CHARSET=latin1;
INSERT INTO json_test(`key`, `grp`, `val`) VALUES
("key1", "g1", "v1"),
("key2", "g1", "v2"),
("key3", "g2", "v3");

explain format=tree SELECT JSON_ARRAYAGG(`key`) AS `keys` FROM json_test;
SET session debug = "+d,px_no_row_split";
SELECT JSON_ARRAYAGG(`key`) AS `keys` FROM json_test;
SET session debug = "-d,px_no_row_split";

explain format=tree SELECT JSON_OBJECTAGG(`key`, val) AS `key_val` FROM json_test;
SELECT JSON_OBJECTAGG(`key`, val) AS `key_val` FROM json_test;
DROP TABLE json_test;

--echo ####
--echo ####parallel unsafe aggregation function check
--echo ####
--echo unsafe json function check
explain format=tree select CAST('[1,2,3]' as JSON) from t1;

CREATE TABLE t11 (pk INT AUTO_INCREMENT KEY, id INT DEFAULT 0,
  data JSON NOT NULL,
  UNIQUE KEY zips(id, (CAST(CAST(data AS JSON) AS UNSIGNED ARRAY))));
INSERT INTO t11(data) VALUES ('[0,1,2]'), ('[10,11,12]');
EXPLAIN format=tree SELECT pk, id FROM t11 WHERE JSON_CONTAINS(CAST(data AS JSON),'1');
DROP TABLE t11;

--echo unsafe XML function check
CREATE TABLE t12(a INT NOT NULL);
INSERT INTO t12 VALUES (0), (0);
explain format=tree SELECT 1 FROM t12 ORDER BY(UPDATEXML(a, '1', '1'));
explain format=tree SELECT 1 FROM t12 where UPDATEXML(a, '1', '1');
DROP TABLE t12;

--echo unsafe sp function check
drop function if exists t1_sum;
create function t1_sum() returns int return (select sum(b) from t1);
explain format=tree select *, t1_sum() from t1;
drop function t1_sum;
explain format=tree select rand() from t1;

--echo unsafe multi statement check
--sorted_result
delimiter ||||;
select * from t1;select * from t2||||
delimiter ;||||

connection conn1;
--source suite/parallel_execution/inc/set_px_to_saved.inc

drop table t1;
drop table t2;
drop database test1;
drop user user1;

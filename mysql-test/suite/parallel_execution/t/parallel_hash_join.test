--echo # Infrastructure for Enhanced Prepare once

--disable_ps_protocol

show grants;
connect(conn1,localhost,root,,);
select user();

create database test1;
create user 'user1'@'%';
grant all on *.* to 'user1'@'%';

connection conn1;
set global cdb_parallel_query_enable = on;
set global cdb_parallel_execution_enabled = on;
set global exchange_inject = on;

connect(conn2,localhost,user1,,);
--echo # Join on two integer columns.
CREATE TABLE t1 (col1 INTEGER);
CREATE TABLE t2 (col1 INTEGER);
INSERT INTO t1 VALUES (1), (3), (5), (7);
INSERT INTO t2 VALUES (1), (2), (5), (6);
ANALYZE TABLE t1, t2;
EXPLAIN FORMAT=tree
  SELECT t1.col1, t2.col1 FROM t1 JOIN t2 ON t1.col1 = t2.col1 ORDER BY t1.col1;
SELECT t1.col1, t2.col1 FROM t1 JOIN t2 ON t1.col1 = t2.col1 ORDER BY t1.col1;
DROP TABLE t1, t2;

connection conn1;
set global cdb_parallel_query_enable = off;
set global cdb_parallel_execution_enabled = off;
set global exchange_inject = off;

drop database test1;
drop user user1;
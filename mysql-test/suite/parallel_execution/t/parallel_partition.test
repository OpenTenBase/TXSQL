--source include/have_pq.inc
--disable_ps_protocol

show grants;
connect(conn1,localhost,root,,);
select user();
create database test1;
create user 'user1'@'%';
grant all on *.* to 'user1'@'%';

CREATE TABLE t1(a INT);

connection conn1;
SET @saved_autocommit =@@autocommit;
set global autocommit=0;
--source suite/parallel_execution/inc/save_and_set_px.inc

START TRANSACTION;
INSERT INTO t1 VALUES (1), (2), (3);

connect(conn2,localhost,user1,,);
SELECT * FROM t1;
ROLLBACK;

connection conn1;
ROLLBACK;

--source suite/parallel_execution/inc/set_px_to_saved.inc
set global autocommit= @saved_autocommit;

drop table t1;
drop database test1;
drop user user1;
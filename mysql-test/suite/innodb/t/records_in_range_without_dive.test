('kkk07', 1),
('kkk08', 1),
('mmm', 1),
('nnn', 1),
('uuu01', 3),
('uuu02', 3),
('uuu03', 3),
('uuu04', 3),
('uuu05', 3),
('uuu06', 3),
('uuu07', 3),
('uuu08', 3),
('xxx', 3);


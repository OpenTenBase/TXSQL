
--source include/have_debug.inc

SHOW VARIABLES LIKE '%copy_free%';

CREATE TABLE t1 (c1 INT PRIMARY KEY, c2 INT) ENGINE=INNODB;

INSERT INTO t1 VALUE (1, 1);
INSERT INTO t1 VALUE (2, 2);
INSERT INTO t1 VALUE (3, 3);
INSERT INTO t1 VALUE (4, 4);
INSERT INTO t1 VALUE (5, 5);
INSERT INTO t1 VALUE (6, 6);

SELECT * FROM t1;

SET GLOBAL TRANSACTION_ISOLATION="REPEATABLE-READ";

connect (con1,localhost,root,,);
connect (con2,localhost,root,,);
connect (con3,localhost,root,,);

connection con1;
BEGIN;
UPDATE t1 SET c2 = c2 + 10 WHERE c1 = 1;
UPDATE t1 SET c2 = c2 + 10 WHERE c1 = 2;


connection con2;
BEGIN;
UPDATE t1 SET c2 = c2 + 10 WHERE c1 = 3;
UPDATE t1 SET c2 = c2 + 10 WHERE c1 = 4;


connection con3;
BEGIN;
SELECT * FROM t1;
SLEEP 1;
SELECT * FROM t1;
COMMIT;

connection con1;
COMMIT;

connection con2;
COMMIT;

connection con3;
SELECT * FROM t1;

connection default;
DROP TABLE t1;


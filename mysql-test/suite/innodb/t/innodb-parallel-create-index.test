call mtr.add_suppression("Detected too long lock waiting around");
CREATE TABLE t1 (c1 char(127) PRIMARY KEY, c2 int, c3 char(127)) ENGINE=INNODB;
let row_count=5000;
--disable_query_log
while ($row_count)
{
  --let $c2=`select 1 + floor(rand()*10000 % 10000)`
  --eval INSERT INTO t1 VALUES (LPAD($row_count, 127, 0), $c2, LPAD($row_count, 127, 0));
  dec $row_count;
}
--enable_query_log
ANALYZE TABLE t1;
--let $checksum_before = query_get_value(CHECKSUM TABLE t1 EXTENDED, Checksum, 1)
--let $count_before = query_get_value(SELECT COUNT(*) FROM t1 WHERE c2 < 4000, COUNT(*), 1)

--echo 
--echo 
--echo #TEST THE CHECKSUM OF PARALLEL CREATE INDEX
CREATE TEMPORARY TABLE t1_temp_on like t1;
CREATE TEMPORARY TABLE t1_temp_off like t1;
SET SESSION innodb_txsql_parallel_ddl=ON;
ALTER TABLE t1 ADD INDEX k_c2_on(c2);
--let $count_after = query_get_value(SELECT COUNT(*) FROM t1 WHERE c2 < 4000, COUNT(*), 1)

INSERT INTO t1_temp_on SELECT * from t1 force index(k_c2_on);
--let $checksum_temp_on = query_get_value(CHECKSUM TABLE t1_temp_on EXTENDED, Checksum, 1)
drop table t1_temp_on;
ALTER TABLE t1 DROP INDEX k_c2_on;

SET SESSION innodb_txsql_parallel_ddl=OFF;
ALTER TABLE t1 ADD INDEX k_c2_off(c2);
INSERT INTO t1_temp_off SELECT * from t1 force index(k_c2_off);
--let $checksum_temp_off = query_get_value(CHECKSUM TABLE t1_temp_off EXTENDED, Checksum, 1)

assert($count_before == $count_after);
assert($checksum_temp_on == $checksum_temp_off);
assert($checksum_temp_on == $checksum_before);

--echo 
--echo 
--echo #TEST SCAN_THREAD=1 AND DDL_THREAD>1
CREATE TEMPORARY TABLE t1_temp_on like t1;
SET SESSION innodb_txsql_parallel_ddl=ON;
SET SESSION innodb_parallel_read_threads=1;
ALTER TABLE t1 ADD INDEX k_c2_on(c2);
INSERT INTO t1_temp_on SELECT * from t1 force index(k_c2_on);
--let $checksum_temp_on = query_get_value(CHECKSUM TABLE t1_temp_on EXTENDED, Checksum, 1)
--let $count_after = query_get_value(SELECT COUNT(*) FROM t1 WHERE c2 < 4000, COUNT(*), 1)
drop table t1_temp_on;
ALTER TABLE t1 DROP INDEX k_c2_on;

assert($count_before == $count_after);
assert($checksum_temp_on == $checksum_temp_off);
assert($checksum_temp_on == $checksum_before);

drop table t1_temp_off;
ALTER TABLE t1 DROP INDEX k_c2_off;


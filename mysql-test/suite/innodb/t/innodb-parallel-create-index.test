--echo 
--echo 
--echo #TEST SCAN_THREAD>1 AND DDL_THREAD=1

CREATE TABLE t1 (id int PRIMARY KEY, val1 int, val2 char(127), val3 char(127)) ENGINE=INNODB;

let row_count=5000;
--disable_query_log
while ($row_count)
{
  --let $val1=`select 1 + floor(rand()*10000 % 10000)`
  --eval INSERT INTO t1 VALUES ($row_count, $val1, LPAD($row_count, 127, 0), LPAD($row_count, 127, 0));
  dec $row_count;
}
--enable_query_log
ANALYZE TABLE t1;

--let $count_before_create_index = query_get_value(SELECT COUNT(*) FROM t1 WHERE val1 < 5000, COUNT(*), 1)

SET SESSION innodb_txsql_parallel_ddl=ON;
SET SESSION innodb_parallel_read_threads=4;
SET SESSION innodb_txsql_ddl_threads=1;

ALTER TABLE t1 ADD INDEX k_val1(val1);

--let $count_after_create_index = query_get_value(SELECT COUNT(*) FROM t1 WHERE val1 < 5000, COUNT(*), 1)

ALTER TABLE t1 DROP INDEX k_val1;

assert($count_before_create_index == $count_after_create_index);

SET SESSION innodb_parallel_read_threads=1;
SET SESSION innodb_txsql_ddl_threads=4;

ALTER TABLE t1 ADD INDEX k_val1(val1);

--let $count_after_create_index_after = query_get_value(SELECT COUNT(*) FROM t1 WHERE val1 < 5000, COUNT(*), 1)

ALTER TABLE t1 DROP INDEX k_val1;

assert($count_before_create_index == $count_after_create_index_after);

--echo 
--echo 
--echo #TEST SCAN_THREAD AND DDL_THREAD from 1 to 12

let parallel_thread_cnt=1;

while ($parallel_thread_cnt <= 12)
{
  --eval SET SESSION innodb_txsql_ddl_threads=$parallel_thread_cnt
  --eval SET SESSION innodb_parallel_read_threads=$parallel_thread_cnt
  --eval ALTER TABLE t1 ADD INDEX k_val1(val1)
  --let $count_after = query_get_value(SELECT COUNT(*) FROM t1 WHERE val1 < 5000, COUNT(*), 1)
  --eval ALTER TABLE t1 DROP INDEX k_val1
  --inc $parallel_thread_cnt
}

assert($count_before_create_index == $count_after);


--echo 
--echo 
--echo #TEST SCAN_THREAD AND DDL_THREAD from 1 to 16 with k-ways merge sort
--error 1193
select @@global.txsql_parallel_ddl_merge_sort_k_value;

--let $restart_parameters=restart:--tencent-root-cnf=tmy.conf
--source include/restart_mysqld.inc
connect (con_tencentroot, localhost, tencentroot,'', );
--connection con_tencentroot
select @@global.txsql_parallel_ddl_merge_sort_k_value;

SET @old_k_value= @@global.txsql_parallel_ddl_merge_sort_k_value;

SET SESSION innodb_txsql_parallel_ddl=ON;

set @@global.txsql_parallel_ddl_merge_sort_k_value = 64;
let parallel_thread_cnt=4;

while ($parallel_thread_cnt <= 8)
{
  --eval SET SESSION innodb_txsql_ddl_threads=$parallel_thread_cnt
  --eval SET SESSION innodb_parallel_read_threads=$parallel_thread_cnt
  --eval ALTER TABLE t1 ADD INDEX k_val1(val1), add unique index k_val2(val2)
  --let $count_after = query_get_value(SELECT COUNT(*) FROM t1 WHERE val1 < 5000, COUNT(*), 1)
  --eval ALTER TABLE t1 DROP INDEX k_val1, DROP INDEX k_val2
  --eval set @@global.txsql_parallel_ddl_merge_sort_k_value = 31;
  --inc $parallel_thread_cnt
}

assert($count_before_create_index == $count_after);

set @@global.txsql_parallel_ddl_merge_sort_k_value = 8;
let parallel_thread_cnt=4;

while ($parallel_thread_cnt <= 8)
{
  --eval SET SESSION innodb_txsql_ddl_threads=$parallel_thread_cnt
  --eval SET SESSION innodb_parallel_read_threads=$parallel_thread_cnt
  --eval ALTER TABLE t1 ADD INDEX k_val1(val1), add unique index k_val2(val2)
  --let $count_after = query_get_value(SELECT COUNT(*) FROM t1 WHERE val1 < 5000, COUNT(*), 1)
  --eval ALTER TABLE t1 DROP INDEX k_val1, DROP INDEX k_val2
  --eval set @@global.txsql_parallel_ddl_merge_sort_k_value = 5;
  --inc $parallel_thread_cnt
}

assert($count_before_create_index == $count_after);

SET @@global.txsql_parallel_ddl_merge_sort_k_value= @old_k_value;

DROP TABLE t1;


#
# test partition range table
#
--echo 
--echo 
--echo #TEST PARATITION RANGE TABLE
SET SESSION innodb_txsql_parallel_ddl=ON;
SET SESSION innodb_txsql_ddl_threads=4;
SET SESSION innodb_parallel_read_threads=4;

CREATE TABLE t1
(a INT PRIMARY KEY, b int, c char(127), d char(127)) ENGINE=InnoDB
PARTITION BY RANGE(a) PARTITIONS 5
(PARTITION p0 VALUES LESS THAN (1001) TABLESPACE innodb_file_per_table,
PARTITION p1 VALUES LESS THAN (2001) TABLESPACE innodb_file_per_table,
PARTITION p2 VALUES LESS THAN (3001) TABLESPACE innodb_file_per_table,
PARTITION p3 VALUES LESS THAN (4001) TABLESPACE innodb_file_per_table,
PARTITION p4 VALUES LESS THAN (5001) TABLESPACE innodb_file_per_table);
let row_count=5000;
--disable_query_log
while ($row_count)
{
  --let $b=`select 1 + floor(rand()*10000 % 10000)`
  --eval INSERT INTO t1 VALUES ($row_count, $b, LPAD($row_count, 127, 0), LPAD($row_count, 127, 0));
  dec $row_count;
}
--enable_query_log

--let $count_before = query_get_value(SELECT COUNT(*) FROM t1 WHERE b < 1000, COUNT(*), 1)

ALTER TABLE t1 ADD INDEX k_b(b);
--let $count_after = query_get_value(SELECT COUNT(*) FROM t1 WHERE b < 1000, COUNT(*), 1)
assert($count_before == $count_after);

CREATE TEMPORARY TABLE t1_temp (a INT PRIMARY KEY, b int, c char(127), d char(127)) ENGINE=InnoDB;
INSERT INTO t1_temp SELECT * from t1 force index(k_b);
--let $checksum_temp = query_get_value(CHECKSUM TABLE t1_temp EXTENDED, Checksum, 1)
--let $checksum_origin = query_get_value(CHECKSUM TABLE t1 EXTENDED, Checksum, 1)
assert($checksum_temp == $checksum_origin);
ALTER TABLE t1 DROP INDEX k_b;
DROP TABLE t1_temp;

# test optimize table
--echo 
--echo 
--echo #TEST OPTIMIZE TABLE
SET SESSION innodb_txsql_parallel_ddl=ON;

ALTER TABLE t1 ADD INDEX k_b(b);
DELETE FROM t1 where a % 2 = 0;
--let $checksum_origin = query_get_value(CHECKSUM TABLE t1 EXTENDED, Checksum, 1)
--let $count_before = query_get_value(SELECT COUNT(*) FROM t1 WHERE b < 3000, COUNT(*), 1)

ANALYZE TABLE t1;
OPTIMIZE TABLE t1;
--let $count_after = query_get_value(SELECT COUNT(*) FROM t1 WHERE b < 3000, COUNT(*), 1)
--let $checksum_origin1 = query_get_value(CHECKSUM TABLE t1 EXTENDED, Checksum, 1)
CREATE TEMPORARY TABLE t1_temp (a INT PRIMARY KEY, b int, c char(127), d char(127)) ENGINE=InnoDB;
INSERT INTO t1_temp SELECT * from t1 force index(k_b);
--let $checksum_temp = query_get_value(CHECKSUM TABLE t1_temp EXTENDED, Checksum, 1)

assert($count_before == $count_after);
assert($checksum_origin == $checksum_origin1);
assert($checksum_temp == $checksum_origin);
DROP TABLE t1;
DROP TABLE t1_temp;

#
# test add multiple indexes with different column types
#
CREATE TABLE t2 (c1 char(127) PRIMARY KEY, c2 char(127), c3 int) ENGINE=INNODB;
let row_count=1000;
--disable_query_log
while ($row_count)
{
  --eval INSERT INTO t2 VALUES (LPAD($row_count, 127, 0), LPAD($row_count, 127, 0), $row_count);
  dec $row_count;
}
--enable_query_log
ANALYZE TABLE t2;
--let $checksum_origin = query_get_value(CHECKSUM TABLE t2 EXTENDED, Checksum, 1)

CREATE TEMPORARY TABLE t2_temp_on  like t2;
CREATE TEMPORARY TABLE t2_temp_off like t2;

SET SESSION innodb_txsql_parallel_ddl=ON;
ALTER TABLE t2 ADD INDEX k_c2_on(c2), ADD INDEX k_c3_on(c3);
SHOW CREATE TABLE t2;

INSERT INTO t2_temp_on SELECT * from t2 force index(k_c2_on);
--let $checksum_temp_on = query_get_value(CHECKSUM TABLE t2_temp_on EXTENDED, Checksum, 1)
drop table t2_temp_on;
ALTER TABLE t2 DROP INDEX k_c2_on, DROP INDEX k_c3_on;

SET SESSION innodb_txsql_parallel_ddl=OFF;
ALTER TABLE t2 ADD INDEX k_c2_off(c2), ADD INDEX k_c3_off(c3);
SHOW CREATE TABLE t2;

INSERT INTO t2_temp_off SELECT * from t2 force index(k_c2_off);
--let $checksum_temp_off = query_get_value(CHECKSUM TABLE t2_temp_off EXTENDED, Checksum, 1)
drop table t2_temp_off;
ALTER TABLE t2 DROP INDEX k_c2_off, DROP INDEX k_c3_off;

assert($checksum_origin == $checksum_temp_on);
assert($checksum_origin == $checksum_temp_off);

DROP TABLE t2;


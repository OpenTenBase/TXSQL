# This test case aims to test hot update optimization feature.
# In this feature, we create a wait queue to avoid too many
# rec lock put into lock system, which will cause performance
# drop down especially in high concurrrent scenario.
# In the case, we will test:
# 1: Hot update for multiple updates

--source include/have_debug_sync.inc

USE test;
SET @@global.innodb_hot_update_detect=true;
SET @@global.innodb_hot_update_wait_timeout=1000000;
--disable_warnings
DROP TABLE IF EXISTS cats;
DROP TABLE IF EXISTS hotupdates;
--enable_warnings

let SEARCH_FILE= $MYSQLTEST_VARDIR/log/mysqld.1.err;

--connection default
CREATE TABLE hotupdates (id int PRIMARY KEY, f2 CHAR(255), counter int) Engine=InnoDB;

# HOW to test?
# We place two rows on a the same page: a normal row and a hot row.
# We instruct the first connection to obtain locks on both normal and hot row.
# We instruct the rest of at least 32 of connections to queue on the hot row.
# When the first connection finishes, the expected case should be that 
# the hot row is added in the hot_update_hash hash table(hot_update_add_new_item).

start transaction;
insert into hotupdates(id, f2, counter) values (4, repeat('~', 50), 0); # Non-hotspot
insert into hotupdates(id, f2, counter) values (5, repeat('~', 50), 0); # hotspot
commit;

--echo ########################################################
--echo #                                                      #
--echo # Scenario: Hot Update on Multiple Updates             #
--echo #                                                      #
--echo ########################################################
SET GLOBAL DEBUG='+d,hot_update_add_new_item,hot_update_move_item';
--source suite/innodb/include/hot_update_multiple_updates.inc
--let SEARCH_PATTERN=added a new hot update item
--source include/search_pattern_in_file.inc

--connection default
SET GLOBAL DEBUG='-d,hot_update_add_new_item';
SET GLOBAL DEBUG='-d,hot_update_move_item';

SET DEBUG_SYNC = 'RESET';

DROP TABLE hotupdates;

SET @@global.innodb_hot_update_detect=false;

--echo #####################
--echo #                   #
--echo # End of            #
--echo #                   #
--echo #####################

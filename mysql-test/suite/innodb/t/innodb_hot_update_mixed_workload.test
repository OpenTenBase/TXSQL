# This test case aims to test hot update optimization feature.
# In this feature, we create a wait queue to avoid too many
# rec lock put into lock system, which will cause performance
# drop down especially in high concurrrent scenario.
# In the case, we will test:
# 1: Hot updates mixed with normal updates and deadlocks

--source include/have_debug_sync.inc

USE test;
SET @@global.innodb_hot_update_detect=true;
SET @@global.innodb_hot_update_wait_timeout=1000000;
--disable_warnings
DROP TABLE IF EXISTS cats;
DROP TABLE IF EXISTS hotupdates;
DROP PROCEDURE IF EXISTS mixed_workload_test;
--enable_warnings

let SEARCH_FILE= $MYSQLTEST_VARDIR/log/mysqld.1.err;

--connection default
CREATE TABLE hotupdates (id int PRIMARY KEY, balance int) Engine=InnoDB;

--let j = 0
--disable_query_log
start transaction;
while ($j <= 100) {
    --eval insert into hotupdates(id, balance) values ($j, 50);
    --inc $j
}
commit;
--enable_query_log

# The mixed workload consists of :
#   1. 40% multi-row-hot-update transactions
#   2. 20% point updates
#   3. 20% point selects
#   4. 20% range selects

DELIMITER //;

CREATE PROCEDURE mixed_workload_test()
BEGIN
    DECLARE row_id INT DEFAULT 0;
    DECLARE op_row_id INT DEFAULT 0;
    DECLARE opid INT DEFAULT 0;
    
    SELECT FLOOR(RAND() * 5) + 0 into opid;
    IF opid = 0 or opid = 1 THEN
        SELECT FLOOR(RAND() * 2) + 0 into row_id;
        SET op_row_id = 1 - row_id;
        START TRANSACTION;
            UPDATE hotupdates set balance = balance - 1 where id = row_id;
            UPDATE hotupdates set balance = balance + 1 where id = op_row_id;
        COMMIT;
    ELSE
        IF opid = 2 THEN
            SELECT FLOOR(RAND() * 31) + 0 into row_id;
            IF row_id <= 1 THEN
                START TRANSACTION;
                    UPDATE hotupdates set balance = balance + 0 where id = row_id;
                COMMIT;
            ELSE
                START TRANSACTION;
                    UPDATE hotupdates set balance = balance + 1 where id = row_id;
                COMMIT;
            END IF;
        ELSE
            IF opid = 3 THEN
                SELECT FLOOR(RAND() * 101) + 2 into row_id;
                select * from hotupdates where id = row_id;
            ELSE
                SELECT FLOOR(RAND() * 101) + 2 into row_id;
                select sum(balance) from hotupdates where id <= row_id;
            END IF;
        END IF;
    END IF;
END//

DELIMITER ;//



--echo ##########################################################################
--echo #                                                                        #
--echo # Scenario: Hot updates mixed with normal updates, and queries           #
--echo #                                                                        #
--echo ##########################################################################
--let CONCURRENT_CONNS = 95

--let $j = 0
while ($j < $CONCURRENT_CONNS) {
    --let hotupdate_connection_name = hotupdate$j
    --connect ($hotupdate_connection_name, localhost, root,,)
    --inc $j
}


--disable_abort_on_error
--disable_query_log
--disable_info
--disable_result_log
--let $ITERS = 100
--let $i = 0
while ($i < $ITERS) {
    
    --let $j = 0

    while ($j < $CONCURRENT_CONNS) {
        --let $hotupdate_connection_name = hotupdate$j
        --connection $hotupdate_connection_name
        --send call mixed_workload_test()
        --inc $j
    }

    --let $j = 0
    while ($j < $CONCURRENT_CONNS) {
        --let $hotupdate_connection_name = hotupdate$j
        --connection $hotupdate_connection_name
        --reap
        --inc $j
    }
    --inc $i
}

--enable_result_log
--enable_info
--enable_query_log
--enable_abort_on_error

--connection default
#select * from hotupdates;
--let result_sum = `select sum(balance) from hotupdates where id = 0 or id = 1`
# We expect the sum of the first two hot rows to be 100 after the execution
--echo $result_sum
DROP TABLE hotupdates;

SET @@global.innodb_hot_update_detect=false;

DROP PROCEDURE IF EXISTS mixed_workload_test;
--echo #####################
--echo #                   #
--echo # End of            #
--echo #                   #
--echo #####################

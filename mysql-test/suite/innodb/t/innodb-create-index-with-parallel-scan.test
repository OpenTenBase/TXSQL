# data amount is small, do not use parallel scan
--echo 
--echo 
--echo #TEST TABLE WITH NOT ENOUGHT RECORDS
CREATE TABLE t2 (c1 int primary key, c2 int) ENGINE=INNODB;
INSERT INTO t2 VALUES(1,1);
INSERT INTO t2 VALUES(2,2);
INSERT INTO t2 VALUES(3,3);
INSERT INTO t2 VALUES(4,4);
SET SESSION innodb_txsql_parallel_ddl=ON;

SET SESSION innodb_txsql_ddl_threads=16;
SET SESSION innodb_parallel_read_threads=16;
SET GLOBAL debug="";
ALTER TABLE t2 ADD INDEX k_c2(c2);

let $check_secondary_index__table_name=t2;
let $check_secondary_index__pk_name=c1;
let $check_secondary_index__idx_col_name=c2;
let $check_secondary_index__idx_name=k_c2;
--source include/check_secondary_index.inc

CHECK TABLE t2;
DROP TABLE t2;


# create unique index on table with dup record
--echo 
--echo 
--echo #TEST TABLE WITH DUP RECORDS
CREATE TABLE t3 (c1 char(127) PRIMARY KEY, c2 char(127), c3 char(127)) ENGINE=INNODB;
let row_count=500;
--disable_query_log
while ($row_count)
{
  --eval INSERT INTO t3 VALUES (LPAD($row_count, 127, 0), LPAD(1, 127, 0), LPAD(1, 127, 0));
  dec $row_count;
}
--enable_query_log
ANALYZE TABLE t1;
SET SESSION innodb_txsql_parallel_ddl=ON;

SET SESSION innodb_txsql_ddl_threads=16;
SET SESSION innodb_parallel_read_threads=16;
--error 1062 # dup
ALTER TABLE t3 ADD UNIQUE INDEX k_c2(c2);
DROP TABLE t3;




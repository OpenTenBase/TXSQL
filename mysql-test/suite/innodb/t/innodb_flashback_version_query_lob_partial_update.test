#############################################
#      Test for flashback version query     #
#############################################
--source include/have_debug.inc
--source include/have_innodb_max_16k.inc

disable_ps_protocol;
set @saved_innodb_backquery_enable = @@global.innodb_backquery_enable;
set global innodb_backquery_enable = ON;
set global innodb_compression_level = 0;
set debug = '+d,lob_print_partial_update_hit';
sleep 2;

CREATE TABLE t1(id int not null primary key, c1 JSON);

set @data_1 = repeat('abcdefghijklmnopqrstuvwxyz1234', 6006);
set @json_doc_1 = concat('["Sven", "', @data_1, '"]');

INSERT INTO t1 VALUES (1, @json_doc_1);
select json_extract(c1, '$[0]') from t1;
sleep 2;
let $time1 = query_get_value(select now(), now(), 1);
sleep 2;

UPDATE t1 SET c1 = JSON_SET(c1, '$[0]', 'Knut');
select json_extract(c1, '$[0]') from t1;
sleep 2;
let $time2 = query_get_value(select now(), now(), 1);
sleep 2;

UPDATE t1 SET c1 = JSON_SET(c1, '$[0]', 'Anna');
select json_extract(c1, '$[0]') from t1;
sleep 2;
let $time3 = query_get_value(select now(), now(), 1);
sleep 2;

let SEARCH_FILE= $MYSQLTEST_VARDIR/log/mysqld.1.err;
let SEARCH_PATTERN= LOB partial update of field=\\(c1\\) on index=\\(\\`PRIMARY\\`\\) in table=\\(test/t1\\);
--source include/search_pattern.inc

disable_query_log;
echo ## query1: select json_extract(c1, '$[0]') from t1 as of timestamp 'time1';
eval select json_extract(c1, '$[0]') from t1 as of timestamp '$time1';
echo ## query2: select json_extract(c1, '$[0]') from t1 as of timestamp 'time2';
eval select json_extract(c1, '$[0]') from t1 as of timestamp '$time2';
echo ## query3: select json_extract(c1, '$[0]') from t1 versions between timestamp 'time1' and 'time2';
eval select json_extract(c1, '$[0]') from t1 versions between timestamp '$time1' and '$time2';
echo ## query4: select json_extract(c1, '$[0]') from t1 versions between timestamp 'time1' and 'time2' where id=1;
eval select json_extract(c1, '$[0]') from t1 versions between timestamp '$time1' and '$time2' where id=1;
echo ## query5: select json_extract(c1, '$[0]') from t1 as of timestamp 'time2';
eval select json_extract(c1, '$[0]') from t1 as of timestamp '$time2';
echo ## query6: eval select json_extract(c1, '$[0]') from t1 versions between timestamp 'time1' and 'time3';
eval select json_extract(c1, '$[0]') from t1 versions between timestamp '$time1' and '$time3';
enable_query_log;
enable_warnings;

set global innodb_backquery_enable=@saved_innodb_backquery_enable;
drop table t1;
set debug = '-d,lob_print_partial_update_hit';
set global innodb_compression_level = default;

INSERT INTO `test`.`news` (`id`, `catid`, `typeid`, `title`, `style`, `thumb`, `keywords`, `description`, `posids`, `url`, `listorder`, `status`, `sysadd`, `islink`, `username`, `inputtime`, `updatetime`, `subtitle`, `passname`, `modifyname`, `ztsc`, `yuansuid`, `zhnaduiid`, `duiyaunid`, `gameid`, `gameclassid`, `baidu`, `gamename`) VALUES ('20676116', '19', '0', '国际商业结算(00147.HK):预计2019财年亏损将大幅度增加', '', '', 'hk 商业 国际 结算 预计 00147.', '@@?value.islive$$@@=', '0', 'http://www.haoxyx.com/yxrd/20190607/20676116.html', '0', '1', '1', '0', 'meihua', '1559908139', '1559908139', '国际商业结算(00147.HK):预计2019财年亏损将大幅度增加', '', '', '0', '0', '0', '0', '0', '0', '0', '');

--remove_file $file
set global innodb_buffer_pool_snapshot_now = on;
--disable_warnings
let $wait_condition =
  SELECT SUBSTR(variable_value, 1, 34) = 'Buffer pool(s) snapshot started at'
  FROM performance_schema.global_status
  WHERE LOWER(variable_name) = 'innodb_buffer_pool_snapshot_status';
--enable_warnings
--source include/wait_condition.inc
--file_exists $file

set global innodb_buffer_pool_recover_now = ON;

--disable_warnings
let $wait_condition =
  SELECT SUBSTR(variable_value, 1, 33) = 'Buffer pool(s) recover started at'
  FROM performance_schema.global_status
  WHERE LOWER(variable_name) = 'innodb_buffer_pool_recover_status';
--enable_warnings
--source include/wait_condition.inc

# Test none exist table
DROP TABLE t;
set global innodb_buffer_pool_recover_now = ON;

--disable_warnings
let $wait_condition =
  SELECT SUBSTR(variable_value, 1, 33) = 'Buffer pool(s) recover started at'
  FROM performance_schema.global_status
  WHERE LOWER(variable_name) = 'innodb_buffer_pool_recover_status';
--enable_warnings
--source include/wait_condition.inc

# Test none exist index
DROP INDEX listorder ON news;
set global innodb_buffer_pool_recover_now = ON;

--disable_warnings
let $wait_condition =
  SELECT SUBSTR(variable_value, 1, 33) = 'Buffer pool(s) recover started at'
  FROM performance_schema.global_status
  WHERE LOWER(variable_name) = 'innodb_buffer_pool_recover_status';
--enable_warnings
--source include/wait_condition.inc

# Test none exist column
ALTER TABLE types DROP COLUMN b;
ALTER TABLE news DROP ztsc;
set global innodb_buffer_pool_recover_now = ON;

--disable_warnings
let $wait_condition =
  SELECT SUBSTR(variable_value, 1, 33) = 'Buffer pool(s) recover started at'
  FROM performance_schema.global_status
  WHERE LOWER(variable_name) = 'innodb_buffer_pool_recover_status';
--enable_warnings
--source include/wait_condition.inc

# Test wrong ib_bp_info
--exec echo "abcd" >> $file
set global innodb_buffer_pool_recover_now = ON;

call mtr.add_suppression("\\[ERROR\\] .* Error parsing");
--disable_warnings
let $wait_condition =
  SELECT SUBSTR(variable_value, 1, 13) = 'Error parsing'
  FROM performance_schema.global_status
  WHERE LOWER(variable_name) = 'innodb_buffer_pool_recover_status';
--enable_warnings
--source include/wait_condition.inc

# Test snapshot and recover pages limit
set global innodb_buffer_pool_snapshot_pct = 80;
set global innodb_buffer_pool_recover_pct = 10;

set global innodb_buffer_pool_snapshot_now = ON;

--disable_warnings
let $wait_condition =
  SELECT SUBSTR(variable_value, 1, 34) = 'Buffer pool(s) snapshot started at'
  FROM performance_schema.global_status
  WHERE LOWER(variable_name) = 'innodb_buffer_pool_snapshot_status';
--enable_warnings
--source include/wait_condition.inc
--file_exists $file

set global innodb_buffer_pool_recover_now = ON;

--disable_warnings
let $wait_condition =
  SELECT SUBSTR(variable_value, 1, 65) = 'Buffer pool(s) recover aborted because it reached the pages limit'
  FROM performance_schema.global_status
  WHERE LOWER(variable_name) = 'innodb_buffer_pool_recover_status';
--enable_warnings
--source include/wait_condition.inc

set global innodb_buffer_pool_recover_pct = 100;
set global innodb_buffer_pool_recover_now = ON;

--disable_warnings
let $wait_condition =
  SELECT SUBSTR(variable_value, 1, 33) = 'Buffer pool(s) recover started at'
  FROM performance_schema.global_status
  WHERE LOWER(variable_name) = 'innodb_buffer_pool_recover_status';
--enable_warnings
--source include/wait_condition.inc

SET GLOBAL innodb_buffer_pool_snapshot_pct = @old_snapshot_pct;
SET GLOBAL innodb_buffer_pool_recover_pct = @old_recover_pct;

# Clean
DROP PROCEDURE load_t;
DROP TABLE types;
DROP TABLE partition_t;
DROP TABLE news;

--remove_file $file

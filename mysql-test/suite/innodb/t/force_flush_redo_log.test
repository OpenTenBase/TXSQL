#Feautre flush redo log

--echo ###connet to server
connection default;

--echo ###generate redo log
create database tdb1;
use tdb1;
create table tlsn1(f1 int, f2 varchar(1000));
insert into tlsn1 values (1, lpad('', 900, 'a'));

--echo ###push checkpoint forward
let $user1=root;
connect (con_root1, localhost, $user1, '', );
set global innodb_async_checkpoint_now=true;

###should be error if use is not root
connection default;
set global innodb_async_checkpoint_now=true;

--echo ###clean up
drop database tdb1;

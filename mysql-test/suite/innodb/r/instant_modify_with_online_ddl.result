create table test1 (id int not null AUTO_INCREMENT,
c1_char char(10) CHARACTER SET latin1 default 'abc',
c2_varchar varchar(10) CHARACTER SET utf8 not null,
c3_binary binary(10),
c4_varbinary varbinary(10) not null default b'111',
c5_tint tinyint default 0,
c6_sint smallint,
c7_mint mediumint signed not null,
c8_int int unsigned unique,
c9_bint bigint,
PRIMARY KEY (id),
KEY test1_key (c9_bint));

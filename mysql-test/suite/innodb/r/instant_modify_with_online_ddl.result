Table	Create Table
test1	CREATE TABLE `test1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `c1_char` varchar(20) CHARACTER SET latin1 COLLATE latin1_swedish_ci DEFAULT 'abc',
  `c2_varchar` varchar(10) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NOT NULL,
  `c3_binary` binary(10) DEFAULT NULL,
  `c4_varbinary` varbinary(10) NOT NULL DEFAULT '',
  `c5_tint` smallint DEFAULT '1',
  `c6_sint` int NOT NULL DEFAULT '100',
  `c7_mint` int NOT NULL,
  `c8_int` int unsigned DEFAULT NULL,
  `c9_bint` bigint DEFAULT NULL,
  `i` int DEFAULT NULL,
  `j` char(30) DEFAULT 'abc',
  `n` int DEFAULT '1',
  PRIMARY KEY (`id`,`c6_sint`),
  UNIQUE KEY `c8_int` (`c8_int`),
  KEY `test1_key` (`c9_bint`)
) ENGINE=InnoDB AUTO_INCREMENT=18 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci

set @saved_innodb_backquery_enable = @@global.innodb_backquery_enable;
set global innodb_backquery_enable = ON;
CREATE TABLE t1(
id   INT not null primary key,
name VARCHAR(35),
part int
)PARTITION BY LIST (id) (
PARTITION r0 VALUES IN (1, 5, 9, 13, 17, 21),
PARTITION r1 VALUES IN (2, 6, 10, 14, 18, 22),
PARTITION r2 VALUES IN (3, 7, 11, 15, 19, 23),
PARTITION r3 VALUES IN (4, 8, 12, 16, 20, 24)
);
insert into t1 values(1,'a',1),(2,'a',1),(3,'bbb',2),(4,'jak',2),(5,'jone',343);
update t1 set name='ddddc' where id=1;
update t1 set part=3 where id=2;
update t1 set name='eeee' where id=1;
update t1 set name='dddggc' where id=3;
update t1 set part=9 where id=3;
update t1 set id=9 where id=1;
## query1: select * from t1 as of timestamp 'time1'
id	name	part
1	a	1
5	jone	343
2	a	1
3	bbb	2
4	jak	2
## query2: select * from t1 as of timestamp 'time2'
id	name	part
1	eeee	1
5	jone	343
2	a	3
3	dddggc	9
4	jak	2
## query3: select * from t1 versions between timestamp 'time1' and 'time2'
id	name	part
1	eeee	1
1	ddddc	1
1	a	1
5	jone	343
2	a	3
2	a	1
3	dddggc	9
3	dddggc	2
3	bbb	2
4	jak	2
## query4: select * from t1 versions between timestamp 'time1' and 'time2' where id=1
id	name	part
1	eeee	1
1	ddddc	1
1	a	1
## query5: select * from t1 as of timestamp 'time2'
id	name	part
1	eeee	1
5	jone	343
2	a	3
3	dddggc	9
4	jak	2
## query6: select * from t1 versions between timestamp 'time1' and 'time2' where id=9
id	name	part
## query7: eval select * from t1 versions between timestamp 'time1' and 'time3'
id	name	part
5	jone	343
9	eeee	1
2	a	3
2	a	1
3	dddggc	9
3	dddggc	2
3	bbb	2
4	jak	2
## query8: eval select * from t1 versions between timestamp 'time1' and 'time3' where id=9
id	name	part
9	eeee	1
## query9: select count(*) from t1 versions between timestamp 'time1' and 'time2'
count(*)
10
drop table t1;
set global innodb_backquery_enable=@saved_innodb_backquery_enable;

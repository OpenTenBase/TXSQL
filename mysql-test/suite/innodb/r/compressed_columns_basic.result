DROP TABLE t1;
#
# A bug in row_merge_buf_add(): "ut_ad(len <= col->len || col->mtype == DATA_BLOB)" assertion
#
SET @saved_innodb_zlib_column_compression_level = @@global.innodb_zlib_column_compression_level;
SET GLOBAL innodb_zlib_column_compression_level = 0;
CREATE TABLE t1 (
a VARCHAR(254) COLUMN_FORMAT COMPRESSED,
b DATE DEFAULT NULL
) ENGINE = InnoDB;
SET @inserted_value = REPEAT('z', 254);
INSERT INTO t1 SET a = @inserted_value;
SELECT COUNT(*) AS number_of_rows_before_alteration FROM t1 WHERE a = @inserted_value;
number_of_rows_before_alteration
1
ALTER TABLE t1 DROP COLUMN b;
SELECT COUNT(*) AS number_of_rows_after_alteration FROM t1 WHERE a = @inserted_value;
number_of_rows_after_alteration
1
DROP TABLE t1;
SET GLOBAL innodb_zlib_column_compression_level = @saved_innodb_zlib_column_compression_level;
#
# Bug lp:1640810 "Adding COMPRESSED attributes to InnoDB special tables fields can lead to server crashes"
#
call mtr.add_suppression("InnoDB: Column .* in table .* has unexpected COMPRESSED attribute");
ALTER TABLE mysql.innodb_index_stats
MODIFY stat_description VARCHAR(1024) COLLATE utf8_bin NOT NULL COLUMN_FORMAT COMPRESSED;
ERROR 42000: The used command is not allowed with this MySQL version
#
# Bug PS-5025 Assertion after altering a compressed column
#
CREATE TABLE t1 (c1 VARBINARY(5) COLUMN_FORMAT COMPRESSED) ENGINE=InnoDB;
ALTER TABLE t1 ADD c2 CHAR(10) FIRST;
INSERT INTO t1 VALUES(0,11111);
DROP TABLE t1;
#
# Bug issue#1518 compresse blob free heap bug
#
SET GLOBAL innodb_min_column_compress_length = 1;
CREATE TABLE `col_compress1` (
`id` int NOT NULL AUTO_INCREMENT,
`col_varchar` varchar(255) /*!80022 COMPRESSED ALGORITHM=ZLIB */ DEFAULT 'varchar_columnaaaaabbbbbccccc',
`col_varbinary` varbinary(255) /*!80022 COMPRESSED ALGORITHM=ZLIB */ DEFAULT 'varbinary_columnaaaaabbbbbccccc',
`col_tinyblob` tinyblob /*!80022 COMPRESSED ALGORITHM=ZLIB */,
`col_mediumblob` mediumblob /*!80022 COMPRESSED ALGORITHM=ZLIB */,
`col_blob` blob /*!80022 COMPRESSED ALGORITHM=ZLIB */,
`col_longblob` longblob /*!80022 COMPRESSED ALGORITHM=ZLIB */,
`col_tinytext` tinytext /*!80022 COMPRESSED ALGORITHM=ZLIB */,
`col_mediumtext` mediumtext /*!80022 COMPRESSED ALGORITHM=ZLIB */,
`col_text` text /*!80022 COMPRESSED ALGORITHM=ZLIB */,
`col_longtext` longtext /*!80022 COMPRESSED ALGORITHM=ZLIB */,
`col_json` json /*!80022 COMPRESSED ALGORITHM=ZLIB */ DEFAULT NULL,
PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=1002;

# TEST COMPRESSED (Compatible with TenDB previous versions)
# only blob/text/varchar/varbinary/json are supported
CREATE TABLE t1 (a INT COMPRESSED) ENGINE=InnoDB;
ERROR HY000: Can not define column 'a' in compressed format
CREATE TABLE t2 (a VARCHAR(100) COMPRESSED) ENGINE=InnoDB;
SHOW CREATE TABLE t2;
Table	Create Table
t2	CREATE TABLE `t2` (
  `a` varchar(100) /*!80022 COMPRESSED ALGORITHM=ZLIB */ DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
CREATE TABLE t3 (a BLOB COMPRESSED) ENGINE=InnoDB;
SHOW CREATE TABLE t3;
Table	Create Table

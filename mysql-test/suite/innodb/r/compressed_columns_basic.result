# test index creation
# compressed columns are not allowed to defined as a part or a key
CREATE TABLE t1(a BLOB COMPRESSED, KEY(a(10)));
ERROR HY000: Compressed column 'a' is not allowed in the key list
CREATE TABLE t1(a BLOB COMPRESSED);
ALTER TABLE t3 ADD KEY(a(10));
ERROR HY000: Compressed column 'a' is not allowed in the key list
DROP TABLE t1;
CREATE TABLE t1 (a BLOB) ENGINE=InnoDB;
# it's ok if a blob column is not compressed
ALTER TABLE t1 ADD KEY(a(10));
# test modifying column format
DROP TABLE t1;
CREATE TABLE t1 (a BLOB) ENGINE=InnoDB;
INSERT INTO t1 VALUES (REPEAT('abc',5));
INSERT INTO t1 VALUES (REPEAT('abc',100));
SELECT * FROM t1;
a
abcabcabcabcabc

ALTER TABLE t1 MODIFY COLUMN a BLOB COMPRESSED;
SELECT * FROM t1;
a
abcabcabcabcabc

SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` blob /*!80022 COMPRESSED ALGORITHM=ZLIB */
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
CHECKSUM TABLE t1;
Table	Checksum
test.t1	1570560110
ALTER TABLE t1 MODIFY COLUMN a VARCHAR(10000) COMPRESSED;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` varchar(10000) /*!80022 COMPRESSED ALGORITHM=ZLIB */ DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
ALTER TABLE t1 MODIFY COLUMN a VARCHAR(10000);
ALTER TABLE t1 MODIFY COLUMN a BLOB COMPRESSED;
CHECKSUM TABLE t1;
Table	Checksum
test.t1	1570560110
# test adding column with default value
DROP TABLE t1;
CREATE TABLE t1 (a INT AUTO_INCREMENT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO t1 VALUES (NULL);
ALTER TABLE t1 ADD COLUMN b TEXT COMPRESSED;
INSERT INTO t1 (a) VALUES (NULL);
ALTER TABLE t1 ADD COLUMN c VARCHAR(1000) COMPRESSED;
INSERT INTO t1 (a,b,c) VALUES (NULL, "hello!", "world!");
ALTER TABLE t1 ADD COLUMN d VARCHAR(10000) COMPRESSED DEFAULT "hello, world! see you!";
INSERT INTO t1 (a,b,c) VALUES (NULL, "hello", "world!");
SELECT * FROM t1;
a	b	c	d
1	NULL	NULL	hello, world! see you!
2	NULL	NULL	hello, world! see you!
3	hello!	world!	hello, world! see you!
4	hello	world!	hello, world! see you!
# test new option: innodb_zlib_column_compression_level
SHOW VARIABLES LIKE 'innodb_zlib_column_compression_level';
Variable_name	Value
innodb_zlib_column_compression_level	6
SET @old_innodb_zlib_column_compression_level = @@global.innodb_zlib_column_compression_level;
DROP TABLE t1;
CREATE TABLE t1 (a BLOB COMPRESSED) ENGINE=InnoDB;
SET GLOBAL innodb_zlib_column_compression_level = -1;
Warnings:
Warning	1292	Truncated incorrect innodb_zlib_column_compression_level value: '-1'
SELECT @@global.innodb_zlib_column_compression_level;
@@global.innodb_zlib_column_compression_level
0
INSERT INTO t1 VALUES(REPEAT('abcd', 200));
SET GLOBAL innodb_zlib_column_compression_level = 5;
SELECT @@global.innodb_zlib_column_compression_level;
@@global.innodb_zlib_column_compression_level
5
INSERT INTO t1 VALUES(REPEAT('abcd', 200));
SET GLOBAL innodb_zlib_column_compression_level = 9;
SELECT @@global.innodb_zlib_column_compression_level;
@@global.innodb_zlib_column_compression_level
9
INSERT INTO t1 VALUES(REPEAT('abcd', 200));
SET GLOBAL innodb_zlib_column_compression_level = 10;
Warnings:
Warning	1292	Truncated incorrect innodb_zlib_column_compression_level value: '10'
SELECT @@global.innodb_zlib_column_compression_level;
@@global.innodb_zlib_column_compression_level
9
SELECT MAX(LENGTH(a)) FROM t1;
MAX(LENGTH(a))
800
# test new option: innodb_min_column_compress_length
SHOW VARIABLES LIKE 'innodb_min_column_compress_length';
Variable_name	Value
innodb_min_column_compress_length	256
SET @old_innodb_min_column_compress_length = @@global.innodb_min_column_compress_length;
TRUNCATE TABLE t1;
SET GLOBAL innodb_min_column_compress_length = 0;
Warnings:
Warning	1292	Truncated incorrect innodb_min_column_compress_length value: '0'
SELECT @@global.innodb_min_column_compress_length;
@@global.innodb_min_column_compress_length
1
INSERT INTO t1 VALUES (REPEAT('abc',10));
SET GLOBAL innodb_min_column_compress_length = 256;
SELECT @@global.innodb_min_column_compress_length;
@@global.innodb_min_column_compress_length
256
INSERT INTO t1 VALUES (REPEAT('abc',40));
SET GLOBAL innodb_min_column_compress_length = 1000;
SELECT @@global.innodb_min_column_compress_length;
@@global.innodb_min_column_compress_length
1000
INSERT INTO t1 VALUES (REPEAT('abc',1000));
SELECT MAX(LENGTH(a)) from t1;
MAX(LENGTH(a))
3000
DROP TABLE t1;
CREATE TABLE t1 (a INT AUTO_INCREMENT PRIMARY KEY, b INT, c INT, d BLOB COMPRESSED) ENGINE=InnoDB;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` int NOT NULL AUTO_INCREMENT,
  `b` int DEFAULT NULL,
  `c` int DEFAULT NULL,
  `d` blob /*!80022 COMPRESSED ALGORITHM=ZLIB */,
  PRIMARY KEY (`a`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
INSERT INTO t1 SELECT NULL, 100, 100, REPEAT('abc',100);
INSERT INTO t1 SELECT NULL, 100, 100, REPEAT('abc',100) FROM t1;
INSERT INTO t1 SELECT NULL, 100, 100, REPEAT('abc',100) FROM t1 a, t1 b;
INSERT INTO t1 SELECT NULL, 100, 100, REPEAT('abc',100) FROM t1 a, t1 b;
INSERT INTO t1 SELECT NULL, 100, 100, REPEAT('abc',100) FROM t1 a, t1 b;
SELECT COUNT(*) FROM t1;
COUNT(*)

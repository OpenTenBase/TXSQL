CREATE TABLE t1(
id INT
) ENGINE=InnoDB;
ALTER TABLE t1 ADD c BLOB COMPRESSED, ALGORITHM = DEFAULT;
INSERT INTO t1 VALUES(1, REPEAT('bar', 300));
INSERT INTO t1 VALUES(2, REPEAT('foo', 200));
SELECT id, LEFT(c, 30), LENGTH(c) FROM t1;
id	LEFT(c, 30)	LENGTH(c)
1	barbarbarbarbarbarbarbarbarbar	900
2	foofoofoofoofoofoofoofoofoofoo	600
SELECT id, LEFT(c, 30), LENGTH(c) FROM t1 WHERE c = REPEAT('foo', 200);
id	LEFT(c, 30)	LENGTH(c)
2	foofoofoofoofoofoofoofoofoofoo	600
SELECT id, LEFT(c, 30), LENGTH(c) FROM t1 WHERE c not in (REPEAT('bar', 300));
id	LEFT(c, 30)	LENGTH(c)
2	foofoofoofoofoofoofoofoofoofoo	600
UPDATE t1 SET c = REPEAT('abc', 100) WHERE id = 2;
SELECT id, LEFT(c, 30), LENGTH(c) FROM t1;
id	LEFT(c, 30)	LENGTH(c)
1	barbarbarbarbarbarbarbarbarbar	900
2	abcabcabcabcabcabcabcabcabcabc	300
SELECT id, LEFT(c, 30), LENGTH(c) FROM t1 WHERE c = REPEAT('foo', 200);
id	LEFT(c, 30)	LENGTH(c)
SELECT id, LEFT(c, 30), LENGTH(c) FROM t1 WHERE c not in (REPEAT('abc', 100));
id	LEFT(c, 30)	LENGTH(c)
1	barbarbarbarbarbarbarbarbarbar	900
DROP TABLE t1;

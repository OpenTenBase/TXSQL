SET @old_innodb_txsql_parallel_ddl = @@innodb_txsql_parallel_ddl;
SET GLOBAL innodb_txsql_parallel_ddl = ON;
CREATE PROCEDURE populate_t1(load_even INT, n INT)
BEGIN
DECLARE i int DEFAULT 1;
DECLARE j int DEFAULT 1;
START TRANSACTION;
WHILE (i <= n) DO
SET j = FLOOR(RAND() * n);
IF i%2 = 0 AND load_even = 1 THEN
INSERT INTO t1 VALUES (i, j, CONCAT('a', j));
END IF;
IF i%2 != 0 AND load_even != 1 THEN
INSERT INTO t1 VALUES (i, j, CONCAT('a', j));
END IF;
SET i = i + 1;
END WHILE;
COMMIT;
END|
SELECT @@innodb_fill_factor;
@@innodb_fill_factor
100

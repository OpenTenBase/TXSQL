call mtr.add_suppression("Found .* prepared XA transactions");
create  table t1(a int primary key, b int) PARTITION BY HASH(a) PARTITIONS 4;
xa begin '123';
insert into t1 values(1,2);
xa end '123';
xa prepare '123';
# restart
xa recover;
formatID	gtrid_length	bqual_length	data
1	3	0	123
xa commit '123';
drop table t1;

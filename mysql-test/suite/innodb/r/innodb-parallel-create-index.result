(a INT PRIMARY KEY, b int, c char(127), d char(127)) ENGINE=InnoDB
PARTITION BY RANGE(a) PARTITIONS 5
(PARTITION p0 VALUES LESS THAN (1001) TABLESPACE innodb_file_per_table,
PARTITION p1 VALUES LESS THAN (2001) TABLESPACE innodb_file_per_table,
PARTITION p2 VALUES LESS THAN (3001) TABLESPACE innodb_file_per_table,
PARTITION p3 VALUES LESS THAN (4001) TABLESPACE innodb_file_per_table,
PARTITION p4 VALUES LESS THAN (5001) TABLESPACE innodb_file_per_table);

CREATE TEMPORARY TABLE t1_temp (a INT PRIMARY KEY, b int, c char(127), d char(127)) ENGINE=InnoDB;
INSERT INTO t1_temp SELECT * from t1 force index(k_b);
ALTER TABLE t1 DROP INDEX k_b;
DROP TABLE t1_temp;



CREATE TABLE t1(
f1 INT PRIMARY KEY,
f2 BLOB COLUMN_FORMAT COMPRESSED ALGORITHM = ZSTD,
f3 BLOB GENERATED ALWAYS AS (f2) VIRTUAL,
INDEX(f3(200))
) ROW_FORMAT=COMPRESSED, ENGINE=InnoDB;
INSERT INTO t1 (f1, f2) VALUES (1, REPEAT('a', 256));
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `f1` int NOT NULL,
  `f2` blob /*!80022 COMPRESSED ALGORITHM=ZSTD */,
  `f3` blob GENERATED ALWAYS AS (`f2`) VIRTUAL,
  PRIMARY KEY (`f1`),
  KEY `f3` (`f3`(200))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci ROW_FORMAT=COMPRESSED
ALTER TABLE t1 ROW_FORMAT=COMPACT;
SHOW CREATE TABLE t1;
Table	Create Table

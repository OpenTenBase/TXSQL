SHOW VARIABLES LIKE '%fast_clone%';
Variable_name	Value
innodb_use_fast_clone_oldest_view	ON
SET GLOBAL TRANSACTION_ISOLATION="REPEATABLE-READ";
CREATE TABLE t1 (c1 INT PRIMARY KEY, c2 INT) ENGINE=INNODB;
INSERT INTO t1 VALUE (1, 1);
INSERT INTO t1 VALUE (2, 2);
INSERT INTO t1 VALUE (3, 3);
INSERT INTO t1 VALUE (4, 4);
INSERT INTO t1 VALUE (5, 5);
INSERT INTO t1 VALUE (6, 6);
SET SESSION DEBUG = '+d, sleep_when_taking_snapshot';
BEGIN;
SELECT * FROM t1 WHERE c1=1;;
SET SESSION DEBUG = '+d, sleep_when_taking_snapshot';
BEGIN;
SELECT * FROM t1 WHERE c1=2;;
SET SESSION DEBUG = '+d, sleep_when_taking_snapshot';
BEGIN;
SELECT * FROM t1 WHERE c1=3;;
c1	c2
1	1
c1	c2
2	2
c1	c2
3	3
SET SESSION DEBUG = '+d, sleep_when_taking_snapshot';
BEGIN;
SELECT * FROM t1 WHERE c1=4;;
SET SESSION DEBUG = '+d, sleep_when_taking_snapshot';
BEGIN;
SELECT * FROM t1 WHERE c1=5;;
SET SESSION DEBUG = '+d, sleep_when_taking_snapshot';
BEGIN;
SELECT * FROM t1 WHERE c1=6;;
SET GLOBAL DEBUG = '+d, test_reach_time';
UPDATE t1 SET c2 = c1 + 10 WHERE c1 = 1;
UPDATE t1 SET c2 = c1 + 10 WHERE c1 = 2;
c1	c2
4	4
c1	c2
5	5
c1	c2
6	6
UPDATE t1 SET c2 = c2 * 100 WHERE c1 = 3;
COMMIT;
COMMIT;
COMMIT;
COMMIT;
COMMIT;
COMMIT;
SET GLOBAL DEBUG = '';
DROP TABLE t1;

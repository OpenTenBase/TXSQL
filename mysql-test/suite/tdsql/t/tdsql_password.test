set names utf8;
select tdsql_password('');
select tdsql_password(NULL);
select tdsql_password('a');
select tdsql_password('bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb');
select tdsql_password('中文||');
select tdsql_password('%%%&@#*&^!)(*#&&@||');

set names latin1;
select tdsql_password('');
select tdsql_password(NULL);
select tdsql_password('a');
select tdsql_password('bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb');
select tdsql_password('中文||');
select tdsql_password('%%%&@#*&^!)(*#&&@||');

set names gbk;
select tdsql_password('');
select tdsql_password(NULL);
select tdsql_password('a');
select tdsql_password('bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb');
select tdsql_password('中文||');
select tdsql_password('%%%&@#*&^!)(*#&&@||');

create database tdb1;
use tdb1;

create table t1(f1 int, f2 varchar(10), f3 datetime, f4 varchar(10));
insert into t1 values (1, '1', now(), null);

select tdsql_password(t1.f1) from t1;
select tdsql_password(t1.f2) from t1;
select tdsql_password(t1.f3) from t1;
select tdsql_password(t1.f4) from t1;

drop table t1;
drop database tdb1;

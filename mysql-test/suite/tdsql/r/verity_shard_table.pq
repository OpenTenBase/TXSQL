CREATE TABLE `customer` (
`c_id` int(11) NOT NULL,
`c_d_id` tinyint(4) NOT NULL,
`c_w_id` int(11) NOT NULL,
`c_first` varchar(16) COLLATE utf8_bin DEFAULT NULL,
`c_middle` char(2) COLLATE utf8_bin DEFAULT NULL,
`c_last` varchar(16) COLLATE utf8_bin DEFAULT NULL,
`c_street_1` varchar(20) COLLATE utf8_bin DEFAULT NULL,
`c_street_2` varchar(20) COLLATE utf8_bin DEFAULT NULL,
`c_city` varchar(20) COLLATE utf8_bin DEFAULT NULL,
`c_state` char(2) COLLATE utf8_bin DEFAULT NULL,
`c_zip` char(9) COLLATE utf8_bin DEFAULT NULL,
`c_phone` char(16) COLLATE utf8_bin DEFAULT NULL,
`c_since` datetime DEFAULT NULL,
`c_credit` char(2) COLLATE utf8_bin DEFAULT NULL,
`c_credit_lim` bigint(20) DEFAULT NULL,
`c_discount` decimal(4,2) DEFAULT NULL,
`c_balance` decimal(12,2) DEFAULT NULL,
`c_ytd_payment` decimal(12,2) DEFAULT NULL,
`c_payment_cnt` smallint(6) DEFAULT NULL,
`c_delivery_cnt` int(11) DEFAULT NULL,
`c_data` text COLLATE utf8_bin,
PRIMARY KEY (`c_w_id`,`c_d_id`,`c_id`),
KEY `idx_customer` (`c_w_id`,`c_d_id`,`c_last`,`c_first`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_bin

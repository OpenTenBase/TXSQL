-- source include/master-slave.inc
-- source include/have_binlog_format_row.inc
--disable_ps_protocol

connect (con1,localhost,tencentroot,,);

connection master;
CREATE TABLE `t1` (
  `c1` int(11),
  `c2` int(11)
) ENGINE=InnoDB;

CREATE TABLE `t2` (
  `c1` int(11),
  `c2` int(11)
) ENGINE=InnoDB;

# case 1: insert t2 select * from t1;
# isolation levl: repeatable read
# binlog_format: row

set session transaction isolation level repeatable read;
insert into t1 values(10,10),(20,20), (30, 30), (40, 40);

insert t2 select * from t1;
--replace_column 4 # 5 # 6 #
query_vertical SELECT * FROM  information_schema.CDB_SQL_STATISTICS;

insert t2 select * from t1;
--replace_column 4 # 5 # 6 #
query_vertical SELECT * FROM  information_schema.CDB_SQL_STATISTICS;

connection con1;
set global cdb_optimize_large_trans_binlog=OFF;

connection master;
insert t2 select * from t1;
--replace_column 4 # 5 # 6 #
query_vertical SELECT * FROM  information_schema.CDB_SQL_STATISTICS;

connection con1;
set global cdb_optimize_large_trans_binlog=ON;
set global cdb_sql_statistics_info_threshold=0;

connection master;
--sleep 6
--replace_column 4 # 5 # 6 #
query_vertical SELECT * FROM  information_schema.CDB_SQL_STATISTICS;

connection con1;
set global cdb_sql_statistics_info_threshold=10000;

connection master;
select * from t1;
select * from t2;
--source include/show_binlog_events.inc
--source include/sync_slave_sql_with_master.inc
select * from t1;
select * from t2;

connection master;
drop table t1;
drop table t2;

--source include/sync_slave_sql_with_master.inc
--source include/rpl_end.inc

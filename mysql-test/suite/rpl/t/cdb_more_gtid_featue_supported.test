--source include/master-slave.inc
--source include/have_binlog_format_row.inc 

--disable_warnings
call mtr.add_suppression("Statement violates GTID consistency .*");
--enable_warnings

let $saved_cdb_more_gtid_feature_supported= `SELECT @@cdb_more_gtid_feature_supported`;
set global cdb_more_gtid_feature_supported=OFF;

create table t(id int) engine=innodb;
create table tt(id int, c int) engine=innodb;
create table t1(id int) engine=myisam;

insert into t values(1);
insert into t1 values(1);

#1 `CREATE TABLE ... SELECT` statements.
--echo ====case1====
create table t_0 select * from t;
select * from t_0;
drop table t_0;

#2 `CREATE TEMPORARY TABLE` or `DROP TEMPORARY TABLE` statements inside transactions.
--echo ====case2====
begin;
insert into t values(1);
create temporary table tx(id int);
insert into tx values(2);
commit;
select * from tx;
drop table tx;

#3 Transactions or statements that update both transactional and nontransactional tables.
--echo ====case3====
begin;
insert into t values(3);
--error ER_GTID_UNSAFE_NON_TRANSACTIONAL_TABLE
insert into t1 values(3);
rollback;

set global cdb_more_gtid_feature_supported=ON;

#1 `CREATE TABLE ... SELECT` statements.
--echo ====case1====
create table t_1 select * from t;
select * from t_1;
drop table t_1;

#2 `CREATE TEMPORARY TABLE` or `DROP TEMPORARY TABLE` statements inside transactions.
--echo ====case2====
begin;
insert into t values(1);
create temporary table tx2(id int);
insert into tx2 values(2);
select * from tx2;
drop table tx2;
insert into tt values(44, 55);
create temporary table xx(id int);
alter table xx add column c int;
insert into xx select * from tt;
insert into xx values(55, 66);
drop table xx;
drop table tt;
commit;

#3 Transactions or statements that update both transactional and nontransactional tables.
--echo ====case3====
begin;
insert into t values(3);
insert into t1 values(3);
commit;

#test statement format
set binlog_format=statement;

create table t2(id int primary key, c int) engine=innodb;
create table t3(id int primary key, c int) engine=myisam;

begin;
insert into t2 values(1,1);
--error ER_CLIENT_GTID_UNSAFE_CREATE_DROP_TEMP_TABLE_IN_TRX_IN_SBR
create temporary table xx (id int primary key, c int); 
--error 1146
insert into xx select * from t2;
--error 1146
insert into t3 select * from xx;
commit;
drop table t2, t3;

#test mixed format
set binlog_format=mixed;

create table t2(id int primary key, c int) engine=innodb;
create table t3(id int primary key, c int) engine=myisam;

begin;
insert into t2 values(1,1);
create temporary table xx (id int primary key, c int);
insert into xx select * from t2;
--error 1785
insert into t3 select * from xx;
commit;
drop table xx, t2, t3;

--echo ====cleanup====
# Clean up environment.
drop table t, t1;

eval SET GLOBAL cdb_more_gtid_feature_supported= $saved_cdb_more_gtid_feature_supported;
--source include/rpl_end.inc


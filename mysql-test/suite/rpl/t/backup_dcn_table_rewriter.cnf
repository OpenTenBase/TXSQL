!include ../my.cnf

[mysqld.1]
early-plugin-load="table_rewriter=table_rewriter.so"
log-slave-updates

[mysqld.2]
early-plugin-load="table_rewriter=table_rewriter.so"
log-slave-updates

[mysqld.3]
early-plugin-load="table_rewriter=table_rewriter.so"
log-slave-updates

[ENV]
SERVER_MYPORT_3=                @mysqld.3.port
SERVER_MYSOCK_3=                @mysqld.3.socket

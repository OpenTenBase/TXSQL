-- source include/master-slave.inc

--connection master
CALL mtr.add_suppression("aborting in bottom half answering thread");

--connection master
set global sqlasyn = 1;
set global sqlasyntimeout = 5;

--connection slave
set global sqlasyn = 1;

--connection master
create table t1(a int primary key, name varchar(256));

--source include/sync_slave_sql_with_master.inc

--connection slave
--source include/stop_slave.inc

--connection master
--error ER_XA_RBTIMEOUT
insert into t1 values (1,'test');

# lose connection, reconnect to master
let $rpl_connection_name= master;
--source include/rpl_connection.inc
--enable_reconnect
# the trx not committed
select * from t1;
show status like 'sqlasync_uncommitted_timeout_trxs';

commit tdsql_timeout_trxs;
select * from t1;
show status like 'sqlasync_uncommitted_timeout_trxs';

--connection slave
--source include/start_slave.inc
select * from t1;

--connection master
drop table t1;
set global sqlasyn = 0;
set global sqlasyntimeout = 30;

--connection slave
set global sqlasyn = 0;

--connection master
--source include/rpl_end.inc

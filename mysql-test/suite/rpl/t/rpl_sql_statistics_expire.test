-- source include/master-slave.inc
-- source include/have_binlog_format_mixed_or_row.inc
--disable_ps_protocol

connect (con1,localhost,tencentroot,,);

connection master;
CREATE TABLE `t1` (
  `c1` int(11) AUTO_INCREMENT,
  `c2` int(11),
   PRIMARY KEY (c1)
) ENGINE=InnoDB;

CREATE TABLE `t2` (
  `c1` int(11),
  `c2` int(11) AUTO_INCREMENT,
  `c3` int(11),
   PRIMARY KEY (c2, c1)
) ENGINE=InnoDB;

set session transaction isolation level repeatable read;

connection master;
insert into t1 values(10,10),(20,20), (30, 30), (40, 40);
insert t2 (c1, c3) select * from t1;
insert into t2 (c1, c3) values (1, 1);
update t1 set c2 = 10;

--sleep 1
delete from t1;

--replace_column 4 # 5 # 6 #
query_vertical SELECT * FROM  information_schema.CDB_SQL_STATISTICS;

connection con1;
set global cdb_sql_statistics_info_threshold=1;

connection master;

--sleep 6
--replace_column 4 # 5 # 6 #
query_vertical SELECT * FROM  information_schema.CDB_SQL_STATISTICS;

--sleep 6
--replace_column 4 # 5 # 6 #
query_vertical SELECT * FROM  information_schema.CDB_SQL_STATISTICS;

connection con1;
set global cdb_sql_statistics_info_threshold=1;

connection master;
--sleep 6
--replace_column 4 # 5 # 6 #
query_vertical SELECT * FROM  information_schema.CDB_SQL_STATISTICS;

connection con1;
set global cdb_sql_statistics_info_threshold=1000;

connection master;
select * from t1;
select * from t2;
# show binlog events;
--source include/sync_slave_sql_with_master.inc
select * from t1;
select * from t2;

connection master1;

connection master;
drop table t1;
drop table t2;

--source include/sync_slave_sql_with_master.inc
--source include/rpl_end.inc

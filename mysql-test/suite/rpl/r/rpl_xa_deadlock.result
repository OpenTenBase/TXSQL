include/master-slave.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the master info repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START SLAVE; see the 'START SLAVE Syntax' in the MySQL Manual for more information.
[connection master]
create database d1;
use d1;
CREATE TABLE t3 (
id int NOT NULL PRIMARY KEY AUTO_INCREMENT,
info varchar(2000)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;
insert into d1.t3 values(1,repeat('a',1000));
insert into d1.t3 values(2,repeat('a',1000));
insert into d1.t3 values(3,repeat('a',1000));
insert into d1.t3 values(4,repeat('a',1000));
insert into d1.t3 values(5,repeat('a',1000));
insert into d1.t3 values(6,repeat('a',1000));
insert into d1.t3 values(7,repeat('a',1000));
insert into d1.t3 values(8,repeat('a',1000));
set innodb_lock_wait_timeout=600;
xa start 'test';
update d1.t3 set info='a' where id =7;
update d1.t3 set info='a' where id =1;
set innodb_lock_wait_timeout=600;
xa start 'test2';
update d1.t3 set info='a' where id =2;
update d1.t3 set info='a' where id =2;;
update d1.t3 set info='a' where id =1;
ERROR 40001: Deadlock found when trying to get lock; try restarting transaction
insert into d1.t3 values(9,repeat('a',1000));
xa end 'test2';
ERROR XA102: XA_RBDEADLOCK: Transaction branch was rolled back: deadlock was detected
xa rollback 'test2';
insert into d1.t3 values(9,repeat('a',1000));
xa end 'test';
xa prepare 'test';
xa commit 'test';
select count(*) from d1.t3;
count(*)
9
drop database d1;

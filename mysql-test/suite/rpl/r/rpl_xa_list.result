[connection master]
create table t1 (a int) engine=innodb;
create table t2 (a int) engine=innodb;
create table t3 (a int) engine=innodb;
create table t4 (a int) engine=innodb;
xa begin '123';
insert into t1 values (1);
xa end '123';
xa prepare '123';
xa begin '234';
insert into t2 values (2);
xa end '234';
xa prepare '234';
xa begin '345';
insert into t3 values (3);
xa end '345';
xa prepare '345';
xa begin '456';
insert into t3 values (4);
xa end '456';
xa prepare '456';
flush logs;
include/sync_slave_sql_with_master.inc
xa commit '123';
xa commit '234';
xa commit '345';
xa commit '456';
drop table t1;
drop table t2;
drop table t3;
drop table t4;
include/sync_slave_sql_with_master.inc
include/rpl_end.inc

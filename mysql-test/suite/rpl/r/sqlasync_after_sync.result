3. multi statements
---- 1. support normal case
include/stop_slave.inc
------create table
use kz;
insert into t values(2,2);insert into t values(3,3)|
ERROR XA106: The transaction is in doubt. Please check whether the transaction has been committed.
---------- after timeout
select * from t;
a	b
1	1
2	2
commit tdsql_timeout_trxs;
---------- after commit
select * from t;
a	b
1	1
2	2
3	3
[connection master]
------- after reconect to master
select * from t;
a	b
1	1
2	2
3	3
include/start_slave.inc
include/sync_slave_sql_with_master.inc
------- after replicate to slave
select * from t;
a	b
1	1
2	2
3	3

3.1 multi statements error happen
include/stop_slave.inc
------ dup key error
use kz;
insert into t values(20,20);insert into t values(20,20)|
ERROR 23000: Duplicate entry '20' for key 'PRIMARY'
---------- after timeout
select * from t;
a	b
1	1
2	2
3	3
20	20
commit tdsql_timeout_trxs;
---------- after commit
select * from t;
a	b
1	1
2	2
3	3
20	20
[connection master]
------- after reconect to master
select * from t;
a	b
1	1
2	2
3	3
20	20
include/start_slave.inc
include/sync_slave_sql_with_master.inc
------- after replicate to slave

include/master-slave.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the master info repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START SLAVE; see the 'START SLAVE Syntax' in the MySQL Manual for more information.
[connection master]
CALL mtr.add_suppression("aborting in bottom half answering thread");
set global sqlasyn = 1;
set global sqlasync_after_sync = 1;
set global sqlasyn = 1;
set global sqlasync_after_sync = 1;
create database kz;
use kz;
create table t(a int primary key, b int);
set global sqlasyntimeout = 1;
include/stop_slave.inc

case 1: normal after sync mode don't commit if no one acked to
insert into t values (1,1);;
use kz;
-------- before time out
select * from t;
a	b
ERROR XA106: The transaction is in doubt. Please check whether the transaction has been committed.
use kz;
-------- after time out
select * from t;
a	b
commit tdsql_timeout_trxs;
-------- after commit
select * from t;
a	b
1	1
include/start_slave.inc
include/sync_slave_sql_with_master.inc
use kz;
------- after replicate to slave
select * from t;
a	b
1	1
[connection master]
------- after reconect to master
select * from t;
a	b
1	1

case 2: ddls only support create/drop database/table
include/stop_slave.inc
-----create database
create database kz1;
ERROR XA106: The transaction is in doubt. Please check whether the transaction has been committed.
---------- after timeout
show databases like 'kz1';
Database (kz1)
commit tdsql_timeout_trxs;
---------- after commit
show databases like 'kz1';
Database (kz1)
kz1
[connection master]
------- after reconect to master
show databases like 'kz1';
Database (kz1)
kz1
include/start_slave.inc
include/sync_slave_sql_with_master.inc
------- after replicate to slave
show databases like 'kz1';
Database (kz1)
kz1
include/stop_slave.inc
------create table
create table kz1(id int primary key);
ERROR XA106: The transaction is in doubt. Please check whether the transaction has been committed.
---------- after timeout
show tables like 'kz1';
Tables_in_kz (kz1)
commit tdsql_timeout_trxs;
---------- after commit
show tables like 'kz1';
Tables_in_kz (kz1)
kz1
[connection master]
------- after reconect to master
show tables like 'kz1';
Tables_in_kz (kz1)
kz1
include/start_slave.inc
include/sync_slave_sql_with_master.inc
------- after replicate to slave
show tables like 'kz1';
Tables_in_kz (kz1)
kz1
include/stop_slave.inc
------alter table downgrade to after commit
alter table kz1 add column c int;
ERROR XA106: The transaction is in doubt. Please check whether the transaction has been committed.
---------- after timeout
show create table kz1;
Table	Create Table
kz1	CREATE TABLE `kz1` (
  `id` int(11) NOT NULL,
  `c` int(11) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
commit tdsql_timeout_trxs;
---------- after commit
show create table kz1;
Table	Create Table
kz1	CREATE TABLE `kz1` (
  `id` int(11) NOT NULL,
  `c` int(11) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
[connection master]
------- after reconect to master
show create table kz1;
Table	Create Table
kz1	CREATE TABLE `kz1` (
  `id` int(11) NOT NULL,
  `c` int(11) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci

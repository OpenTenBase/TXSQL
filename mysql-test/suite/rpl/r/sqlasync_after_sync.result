---- 6. downgrade to after commit if commit in procedure
include/stop_slave.inc
use kz;
create procedure after_sync_func()
modifies sql data
begin
delete from t;
START TRANSACTION;
insert into t values(19,19);
commit;
end|
ERROR XA106: The transaction is in doubt. Please check whether the transaction has been committed.
[connection master]
call after_sync_func();
ERROR XA106: The transaction is in doubt. Please check whether the transaction has been committed.
---------- after timeout
select * from t;
a	b
commit tdsql_timeout_trxs;
---------- after commit
select * from t;
a	b
19	19
[connection master]
------- after reconect to master
select * from t;
a	b
19	19
include/start_slave.inc
include/sync_slave_sql_with_master.inc
------- after replicate to slave
select * from t;
a	b
19	19
include/stop_slave.inc


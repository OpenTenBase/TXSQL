INSTALL PLUGIN rpl_speed_limit_master SONAME 'rpl_speed_limit_master.so';
SHOW VARIABLES LIKE 'rpl_speed_limit_master%';
Variable_name	Value
rpl_speed_limit_master_enabled	OFF
rpl_speed_limit_master_max_token_ratio	150
rpl_speed_limit_master_mode	FIX_BANDWIDTH
rpl_speed_limit_master_run_test	0
rpl_speed_limit_master_slave_bandwidth	10240
rpl_speed_limit_master_test_send_len	100
rpl_speed_limit_master_tick_interval	20
rpl_speed_limit_master_total_bandwidth	51200
rpl_speed_limit_master_trace_level	0
SHOW STATUS LIKE 'rpl_speed_limit_master%';
Variable_name	Value
rpl_speed_limit_master_bandwidth	0
rpl_speed_limit_master_bytes_send	0
rpl_speed_limit_master_clients	0
rpl_speed_limit_master_sleep_count	0
rpl_speed_limit_master_sleep_time	0
SET GLOBAL rpl_speed_limit_master_slave_bandwidth=1024;
SET GLOBAL rpl_speed_limit_master_enabled=on;
SHOW VARIABLES LIKE 'rpl_speed_limit_master%';
Variable_name	Value
rpl_speed_limit_master_enabled	ON
rpl_speed_limit_master_max_token_ratio	150
rpl_speed_limit_master_mode	FIX_BANDWIDTH
rpl_speed_limit_master_run_test	0
rpl_speed_limit_master_slave_bandwidth	1024
rpl_speed_limit_master_test_send_len	100
rpl_speed_limit_master_tick_interval	20
rpl_speed_limit_master_total_bandwidth	51200
rpl_speed_limit_master_trace_level	0
SHOW STATUS LIKE 'rpl_speed_limit_master%';
Variable_name	Value
rpl_speed_limit_master_bandwidth	0
rpl_speed_limit_master_bytes_send	0
rpl_speed_limit_master_clients	0
rpl_speed_limit_master_sleep_count	0
rpl_speed_limit_master_sleep_time	0
SET GLOBAL rpl_speed_limit_master_test_send_len=1024;
SET GLOBAL rpl_speed_limit_master_run_test=2;
SET GLOBAL rpl_speed_limit_master_test_send_len=1024*1024;
SET GLOBAL rpl_speed_limit_master_run_test=4;
SET GLOBAL rpl_speed_limit_master_test_send_len=2048*1024;
SET GLOBAL rpl_speed_limit_master_run_test=6;
UNINSTALL PLUGIN rpl_speed_limit_master;
INSTALL PLUGIN rpl_speed_limit_slave SONAME 'rpl_speed_limit_slave.so';
SHOW VARIABLES LIKE 'rpl_speed_limit_slave%';
Variable_name	Value
rpl_speed_limit_slave_enabled	OFF
rpl_speed_limit_slave_max_token_ratio	150
rpl_speed_limit_slave_mode	FIX_BANDWIDTH
rpl_speed_limit_slave_run_test	0
rpl_speed_limit_slave_slave_bandwidth	10240
rpl_speed_limit_slave_test_send_len	100
rpl_speed_limit_slave_tick_interval	20
rpl_speed_limit_slave_total_bandwidth	51200
rpl_speed_limit_slave_trace_level	0
SHOW STATUS LIKE 'rpl_speed_limit_slave%';
Variable_name	Value
rpl_speed_limit_slave_bandwidth	0
rpl_speed_limit_slave_bytes_received	0
rpl_speed_limit_slave_clients	0
rpl_speed_limit_slave_sleep_count	0
rpl_speed_limit_slave_sleep_time	0
SET GLOBAL rpl_speed_limit_slave_slave_bandwidth=1024;
SET GLOBAL rpl_speed_limit_slave_enabled=on;
SHOW VARIABLES LIKE 'rpl_speed_limit_slave%';
Variable_name	Value
rpl_speed_limit_slave_enabled	ON
rpl_speed_limit_slave_max_token_ratio	150
rpl_speed_limit_slave_mode	FIX_BANDWIDTH
rpl_speed_limit_slave_run_test	0
rpl_speed_limit_slave_slave_bandwidth	1024
rpl_speed_limit_slave_test_send_len	100
rpl_speed_limit_slave_tick_interval	20
rpl_speed_limit_slave_total_bandwidth	51200
rpl_speed_limit_slave_trace_level	0
SHOW STATUS LIKE 'rpl_speed_limit_slave%';
Variable_name	Value
rpl_speed_limit_slave_bandwidth	0
rpl_speed_limit_slave_bytes_received	0
rpl_speed_limit_slave_clients	0
rpl_speed_limit_slave_sleep_count	0
rpl_speed_limit_slave_sleep_time	0
SET GLOBAL rpl_speed_limit_slave_test_send_len=1024;
SET GLOBAL rpl_speed_limit_slave_run_test=2;
SET GLOBAL rpl_speed_limit_slave_test_send_len=1024*1024;
SET GLOBAL rpl_speed_limit_slave_run_test=4;
SET GLOBAL rpl_speed_limit_slave_test_send_len=2048*1024;
SET GLOBAL rpl_speed_limit_slave_run_test=6;
UNINSTALL PLUGIN rpl_speed_limit_slave;

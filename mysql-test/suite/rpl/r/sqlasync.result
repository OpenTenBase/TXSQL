0
select @@thread_handling;
@@thread_handling
pool-of-threads
set global sqlasyn = 1;
set global sqlasyn = 1;
create database sb1;
use sb1;
create table t1(a int primary key, b int);
set global sqlasyntimeout = 1;
set global sqlasynwarntimeout = 120;
include/stop_slave.inc
insert into t1 values (1,2);
ERROR XA106: XA_RBTIMEOUT: Transaction branch was rolled back: took too long
[connection master]
select * from t1;
a	b
1	2
set global sqlasync_after_sync = 1;
insert into t1 values (2,3);
ERROR XA106: XA_RBTIMEOUT: Transaction branch was rolled back: took too long
[connection master]
select * from t1;
a	b
1	2
2	3
set global sqlasyntimeout = 3000;
insert into t1 values (3,4);;
use sb1;
select * from t1;
a	b
1	2
2	3
include/start_slave.inc
include/sync_slave_sql_with_master.inc
use sb1;
select * from t1;
a	b
1	2
2	3
3	4
select * from t1;
a	b
1	2
2	3
3	4
alter table t1 add column c int;
update t1 set c = 10;
include/sync_slave_sql_with_master.inc
select * from t1;
a	b	c
1	2	10
2	3	10
3	4	10

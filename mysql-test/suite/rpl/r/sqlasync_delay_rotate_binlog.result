[connection master]
CALL mtr.add_suppression("aborting in bottom half answering thread");
set global sqlasyn = 1;
set global sqlasyntimeout = 5;
SET @@global.max_binlog_size = 4096;
set global sqlasyn = 1;
set global sqlasync_after_sync = 1;
create table t1(a int primary key, name varchar(4096));
include/sync_slave_sql_with_master.inc
include/stop_slave.inc
show binary logs;

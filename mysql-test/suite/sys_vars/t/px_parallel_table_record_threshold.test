######## mysql-test\suite\sys_vars\t\px_parallel_table_record_threshold.test ########
#                                                                                   #
# Variable Name: px_parallel_table_record_threshold                                 #
# Scope: SESSION                                                                    #
# Access Type: Dynamic                                                              #
# Data Type: numeric                                                                #
# Default Value:  5000                                                              #
# Minimum value:  0                                                                 #
# Maximum value:  18446744073709551615                                              #
#                                                                                   #
####################################################################################

###########################################################################
#           START OF px_parallel_table_record_threshold TESTS                    #
###########################################################################

#############################################################
#                 Save initial value                        #
#############################################################

SET @start_global_value = @@global.px_parallel_table_record_threshold;
SELECT @start_global_value;
SET @start_session_value = @@session.px_parallel_table_record_threshold;
SELECT @start_session_value;

###########################################################################
#     Display the DEFAULT value of px_parallel_table_record_threshold            #
###########################################################################

SET @@global.px_parallel_table_record_threshold = 100;
SET @@global.px_parallel_table_record_threshold = DEFAULT;
SELECT @@global.px_parallel_table_record_threshold;

SET @@session.px_parallel_table_record_threshold = 200;
SET @@session.px_parallel_table_record_threshold = DEFAULT;
SELECT @@session.px_parallel_table_record_threshold;

###########################################################################
#     Check the DEFAULT value of px_parallel_table_record_threshold              #
###########################################################################

SET @@global.px_parallel_table_record_threshold = DEFAULT;
SELECT @@global.px_parallel_table_record_threshold = 5000;

SET @@session.px_parallel_table_record_threshold = DEFAULT;
SELECT @@session.px_parallel_table_record_threshold = 5000;

#####################################################################################
# Change the value of px_parallel_table_record_threshold to a valid value for GLOBAL Scope #
#####################################################################################

SET @@global.px_parallel_table_record_threshold = 0;
SELECT @@global.px_parallel_table_record_threshold;
SET @@global.px_parallel_table_record_threshold = 100;
SELECT @@global.px_parallel_table_record_threshold;
SET @@global.px_parallel_table_record_threshold = 18446744073709551615;
SELECT @@global.px_parallel_table_record_threshold;

######################################################################################
# Change the value of px_parallel_table_record_threshold to a valid value for SESSION Scope #
######################################################################################
 
SET @@session.px_parallel_table_record_threshold = 0;
SELECT @@session.px_parallel_table_record_threshold;
SET @@session.px_parallel_table_record_threshold = 100;
SELECT @@session.px_parallel_table_record_threshold;
SET @@session.px_parallel_table_record_threshold = 18446744073709551615;
SELECT @@session.px_parallel_table_record_threshold;

#######################################################################
# Change the value of px_parallel_table_record_threshold to an invalid value #
#######################################################################

SET @@global.px_parallel_table_record_threshold = -1024;
SELECT @@global.px_parallel_table_record_threshold;

--Error ER_WRONG_TYPE_FOR_VAR
SET @@global.px_parallel_table_record_threshold = 18446744073709551616;
SELECT @@global.px_parallel_table_record_threshold;

--Error ER_WRONG_TYPE_FOR_VAR
SET @@global.px_parallel_table_record_threshold = 65530.34;
SELECT @@global.px_parallel_table_record_threshold;

--Error ER_WRONG_TYPE_FOR_VAR
SET @@global.px_parallel_table_record_threshold = test;
SELECT @@global.px_parallel_table_record_threshold;

SET @@session.px_parallel_table_record_threshold = -2;
SELECT @@session.px_parallel_table_record_threshold;

--Error ER_WRONG_TYPE_FOR_VAR
SET @@session.px_parallel_table_record_threshold = 18446744073709551616;
SELECT @@session.px_parallel_table_record_threshold;

--Error ER_WRONG_TYPE_FOR_VAR
SET @@session.px_parallel_table_record_threshold = 65530.34;
SELECT @@session.px_parallel_table_record_threshold;

--Error ER_WRONG_TYPE_FOR_VAR
SET @@session.px_parallel_table_record_threshold = test;
SELECT @@session.px_parallel_table_record_threshold;

####################################################################
#   Check if the value in GLOBAL Table matches value in variable   #
####################################################################

--disable_warnings
SELECT @@global.px_parallel_table_record_threshold = VARIABLE_VALUE 
FROM performance_schema.global_variables 
WHERE VARIABLE_NAME='px_parallel_table_record_threshold';
--enable_warnings

####################################################################
#  Check if the value in SESSION Table matches value in variable   #
####################################################################

--disable_warnings
SELECT @@session.px_parallel_table_record_threshold = VARIABLE_VALUE 
FROM performance_schema.session_variables 
WHERE VARIABLE_NAME='px_parallel_table_record_threshold';
--enable_warnings

####################################################################
#     Check if TRUE and FALSE values can be used on variable       #
####################################################################

SET @@global.px_parallel_table_record_threshold = TRUE;
SELECT @@global.px_parallel_table_record_threshold;
SET @@global.px_parallel_table_record_threshold = FALSE;
SELECT @@global.px_parallel_table_record_threshold;

#################################################################################### 
#  Check if accessing variable with and without GLOBAL point to same variable      #
#################################################################################### 

SET @@global.px_parallel_table_record_threshold = 10;
SELECT @@px_parallel_table_record_threshold = @@global.px_parallel_table_record_threshold;


########################################################################################################
#    Check if accessing variable with SESSION,LOCAL and without SCOPE points to same session variable  #
########################################################################################################

SET @@px_parallel_table_record_threshold = 100;
SELECT @@px_parallel_table_record_threshold = @@local.px_parallel_table_record_threshold;
SELECT @@local.px_parallel_table_record_threshold = @@session.px_parallel_table_record_threshold;

######################################################################################
#   Check if px_parallel_table_record_threshold can be accessed with and without @@ sign    #
######################################################################################

SET px_parallel_table_record_threshold = 1;
SELECT @@px_parallel_table_record_threshold;
--Error ER_UNKNOWN_TABLE
SELECT local.px_parallel_table_record_threshold;
--Error ER_UNKNOWN_TABLE
SELECT session.px_parallel_table_record_threshold;
--Error ER_BAD_FIELD_ERROR
SELECT px_parallel_table_record_threshold = @@session.px_parallel_table_record_threshold;

####################################
#     Restore initial value        #
####################################

SET @@global.px_parallel_table_record_threshold = @start_global_value;
SELECT @@global.px_parallel_table_record_threshold;
SET @@session.px_parallel_table_record_threshold = @start_session_value;
SELECT @@session.px_parallel_table_record_threshold;

###########################################################################
#           END OF px_parallel_table_record_threshold TESTS                      #
###########################################################################
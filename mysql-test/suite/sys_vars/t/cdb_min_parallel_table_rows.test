############## mysql-test\t\cdb_min_parallel_table_rows.test #######################
#                                                                                   #
# Variable Name: cdb_min_parallel_table_rows                                        #
# Scope: SESSION                                                                    #
# Access Type: Dynamic                                                              #
# Data Type: numeric                                                                #
# Default Value:  5000                                                              #
# Minimum value:  0                                                                 #
# Maximum value:  18446744073709551615                                              #
#                                                                                   #
####################################################################################

###########################################################################
#           START OF cdb_min_parallel_table_rows TESTS                    #
###########################################################################

#############################################################
#                 Save initial value                        #
#############################################################

SET @start_global_value = @@global.cdb_min_parallel_table_rows;
SELECT @start_global_value;
SET @start_session_value = @@session.cdb_min_parallel_table_rows;
SELECT @start_session_value;

###########################################################################
#     Display the DEFAULT value of cdb_min_parallel_table_rows            #
###########################################################################

SET @@global.cdb_min_parallel_table_rows = 100;
SET @@global.cdb_min_parallel_table_rows = DEFAULT;
SELECT @@global.cdb_min_parallel_table_rows;

SET @@session.cdb_min_parallel_table_rows = 200;
SET @@session.cdb_min_parallel_table_rows = DEFAULT;
SELECT @@session.cdb_min_parallel_table_rows;

###########################################################################
#     Check the DEFAULT value of cdb_min_parallel_table_rows              #
###########################################################################

SET @@global.cdb_min_parallel_table_rows = DEFAULT;
SELECT @@global.cdb_min_parallel_table_rows = 5000;

SET @@session.cdb_min_parallel_table_rows = DEFAULT;
SELECT @@session.cdb_min_parallel_table_rows = 5000;

#####################################################################################
# Change the value of cdb_min_parallel_table_rows to a valid value for GLOBAL Scope #
#####################################################################################

SET @@global.cdb_min_parallel_table_rows = 0;
SELECT @@global.cdb_min_parallel_table_rows;
SET @@global.cdb_min_parallel_table_rows = 100;
SELECT @@global.cdb_min_parallel_table_rows;
SET @@global.cdb_min_parallel_table_rows = 18446744073709551615;
SELECT @@global.cdb_min_parallel_table_rows;

######################################################################################
# Change the value of cdb_min_parallel_table_rows to a valid value for SESSION Scope #
######################################################################################
 
SET @@session.cdb_min_parallel_table_rows = 0;
SELECT @@session.cdb_min_parallel_table_rows;
SET @@session.cdb_min_parallel_table_rows = 100;
SELECT @@session.cdb_min_parallel_table_rows;
SET @@session.cdb_min_parallel_table_rows = 18446744073709551615;
SELECT @@session.cdb_min_parallel_table_rows;

#######################################################################
# Change the value of cdb_min_parallel_table_rows to an invalid value #
#######################################################################

SET @@global.cdb_min_parallel_table_rows = -1024;
SELECT @@global.cdb_min_parallel_table_rows;

--Error ER_WRONG_TYPE_FOR_VAR
SET @@global.cdb_min_parallel_table_rows = 18446744073709551616;
SELECT @@global.cdb_min_parallel_table_rows;

--Error ER_WRONG_TYPE_FOR_VAR
SET @@global.cdb_min_parallel_table_rows = 65530.34;
SELECT @@global.cdb_min_parallel_table_rows;

--Error ER_WRONG_TYPE_FOR_VAR
SET @@global.cdb_min_parallel_table_rows = test;
SELECT @@global.cdb_min_parallel_table_rows;

SET @@session.cdb_min_parallel_table_rows = -2;
SELECT @@session.cdb_min_parallel_table_rows;

--Error ER_WRONG_TYPE_FOR_VAR
SET @@session.cdb_min_parallel_table_rows = 18446744073709551616;
SELECT @@session.cdb_min_parallel_table_rows;

--Error ER_WRONG_TYPE_FOR_VAR
SET @@session.cdb_min_parallel_table_rows = 65530.34;
SELECT @@session.cdb_min_parallel_table_rows;

--Error ER_WRONG_TYPE_FOR_VAR
SET @@session.cdb_min_parallel_table_rows = test;
SELECT @@session.cdb_min_parallel_table_rows;

####################################################################
#   Check if the value in GLOBAL Table matches value in variable   #
####################################################################

--disable_warnings
SELECT @@global.cdb_min_parallel_table_rows = VARIABLE_VALUE 
FROM performance_schema.global_variables 
WHERE VARIABLE_NAME='cdb_min_parallel_table_rows';
--enable_warnings

####################################################################
#  Check if the value in SESSION Table matches value in variable   #
####################################################################

--disable_warnings
SELECT @@session.cdb_min_parallel_table_rows = VARIABLE_VALUE 
FROM performance_schema.session_variables 
WHERE VARIABLE_NAME='cdb_min_parallel_table_rows';
--enable_warnings

####################################################################
#     Check if TRUE and FALSE values can be used on variable       #
####################################################################

SET @@global.cdb_min_parallel_table_rows = TRUE;
SELECT @@global.cdb_min_parallel_table_rows;
SET @@global.cdb_min_parallel_table_rows = FALSE;
SELECT @@global.cdb_min_parallel_table_rows;

#################################################################################### 
#  Check if accessing variable with and without GLOBAL point to same variable      #
#################################################################################### 

SET @@global.cdb_min_parallel_table_rows = 10;
SELECT @@cdb_min_parallel_table_rows = @@global.cdb_min_parallel_table_rows;


########################################################################################################
#    Check if accessing variable with SESSION,LOCAL and without SCOPE points to same session variable  #
########################################################################################################

SET @@cdb_min_parallel_table_rows = 100;
SELECT @@cdb_min_parallel_table_rows = @@local.cdb_min_parallel_table_rows;
SELECT @@local.cdb_min_parallel_table_rows = @@session.cdb_min_parallel_table_rows;

######################################################################################
#   Check if cdb_min_parallel_table_rows can be accessed with and without @@ sign    #
######################################################################################

SET cdb_min_parallel_table_rows = 1;
SELECT @@cdb_min_parallel_table_rows;
--Error ER_UNKNOWN_TABLE
SELECT local.cdb_min_parallel_table_rows;
--Error ER_UNKNOWN_TABLE
SELECT session.cdb_min_parallel_table_rows;
--Error ER_BAD_FIELD_ERROR
SELECT cdb_min_parallel_table_rows = @@session.cdb_min_parallel_table_rows;

####################################
#     Restore initial value        #
####################################

SET @@global.cdb_min_parallel_table_rows = @start_global_value;
SELECT @@global.cdb_min_parallel_table_rows;
SET @@session.cdb_min_parallel_table_rows = @start_session_value;
SELECT @@session.cdb_min_parallel_table_rows;

###########################################################################
#           END OF cdb_min_parallel_table_rows TESTS                      #
###########################################################################
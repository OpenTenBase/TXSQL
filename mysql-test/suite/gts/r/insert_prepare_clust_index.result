DROP DATABASE IF EXISTS dbtest_gts;
CREATE DATABASE dbtest_gts;
use dbtest_gts;
drop table if exists t;
create table t(id int primary key, name char(10),gts int, index i_name(name));
insert into t values(1,'a',0);
XA start 'a' tdsql_withgts 300;
insert into t values(2,'b',301);
XA end 'a';
XA prepare 'a';
XA commit 'a' tdsql_withgts 301;
XA start 'a' tdsql_withgts 301;
insert t values(3,'c',302);
XA end 'a';
XA prepare 'a';
use dbtest_gts;
select *from t force index(primary) tdsql_withgts 300;
id	name	gts
1	a	0
select *from t force index(primary) tdsql_withgts 301;
use dbtest_gts;
select *from t force index(primary) tdsql_withgts 302;
xa commit 'a' tdsql_withgts 302;

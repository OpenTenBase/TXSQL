2	b	501
XA end 'b';
XA prepare 'b';
XA commit 'b' tdsql_withgts 505;
id	name	gts
1	a	504
2	b	501
XA end 'c';
XA prepare 'c';
XA commit 'c' tdsql_withgts 506;
XA start 'a';
update t set gts=0 where id =1;
XA end 'a';
XA prepare 'a';
use dbtest_gts;
XA start 'b' tdsql_withgts 506;
select *from t force index(primary);
id	name	gts
1	a	504
2	b	501
XA end 'b';

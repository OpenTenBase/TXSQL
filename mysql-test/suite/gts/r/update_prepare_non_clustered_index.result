DROP DATABASE IF EXISTS dbtest_gts;
CREATE DATABASE dbtest_gts;
use dbtest_gts;
drop table if exists t;
create table t(id int primary key, name char(10),gts int, index i_name(name));
insert into t values(1,'a',0);
XA start 'a' tdsql_withgts 600;
insert into t values(2,'b',601);
XA end 'a';
XA prepare 'a';
XA commit 'a' tdsql_withgts 601;
XA start 'a' tdsql_withgts 601;
update t set gts=602 where id =1;
XA end 'a';
XA prepare 'a';
use dbtest_gts;
select name from t force index(i_name) tdsql_withgts 600;
name
a

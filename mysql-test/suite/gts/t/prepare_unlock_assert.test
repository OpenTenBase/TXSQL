--disable_warnings
DROP DATABASE IF EXISTS dbtest_gts;
--enable_warnings
 
CREATE DATABASE dbtest_gts;
use dbtest_gts;
--disable_warnings
drop table if exists t;
--enable_warnings
create table t(id int primary key, name char(10),gts int, index i_name(name));

insert into t values(1,'a',0);
insert into t values(2,'b',0);

# Set isolation to RR
--let $old_trx_isolation=`select @@global.transaction_isolation`
SET GLOBAL transaction_isolation = 'REPEATABLE-READ';

#t1 start a normal XA transtion
XA start 'a' tdsql_withgts 700;
insert into t values(3,'c',700);
XA end 'a';
XA prepare 'a';

#t2 select with_gts blocking
connect(conn1,localhost,root);
SET DEBUG_SYNC= 'prepare_rec_lock_before WAIT_FOR s1';
use dbtest_gts;
send select *from t force index(primary) tdsql_withgts 701;
--sleep 1

#t1 commit XA transtion
connection default;
xa commit 'a' tdsql_withgts 701;
#t1 Notify t2 to lock
SET DEBUG_SYNC= 'now SIGNAL s1';

# assert in row_unlock_for_mysql without bug fix
connection conn1;
reap;

#clean
connection default;
--eval SET GLOBAL transaction_isolation = `$old_trx_isolation`
disconnect conn1;
DROP DATABASE dbtest_gts;
PURGE TDSQL_TLOG logs;

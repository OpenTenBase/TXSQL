--disable_warnings
DROP DATABASE IF EXISTS dbtest_gts;
--enable_warnings
 
CREATE DATABASE dbtest_gts;
use dbtest_gts;
--disable_warnings
drop table if exists t;
--enable_warnings
create table t(id int primary key, name char(10),gts int, index i_name(name));

insert into t values(1,'a',0);

XA start 'a' tdsql_withgts 300;
insert into t values(2,'b',301);
XA end 'a';
XA prepare 'a';
XA commit 'a' tdsql_withgts 301;

#########################
#caset 1.1 The xa-prepare for normal select with_gts
#t1 start a normal XA transtion tdsql_withgts 300
XA start 'a' tdsql_withgts 301;
insert t values(3,'c',302);
XA end 'a';
XA prepare 'a';

#t2 select with_gts and no blocking
connect(conn1,localhost,root);
use dbtest_gts;
select *from t force index(primary) tdsql_withgts 300;

#t2 select with_gts and blocking
send select *from t force index(primary) tdsql_withgts 301;

#t3 select with_gts and blocking
connect(conn2,localhost,root);
use dbtest_gts;
send select *from t force index(primary) tdsql_withgts 302;

--sleep 1
#t1 commit
connection default;
xa commit 'a' tdsql_withgts 302;

# t2 select tdsql_withgts returns and can not see the change
connection conn1;
reap;

# t3 select tdsql_withgts returns and can see the change
connection conn2;
reap;


#########################
#case 1.2 The xa-prepare for XA-select with_gts
connection default;
#t1 start a normal XA transtion
XA start 'a' tdsql_withgts 302;
insert into t values (4,'d',303);
XA end 'a';
XA prepare 'a';

#t2 XA-select with_gts and no blocking
connection conn1;
use dbtest_gts;
XA start 'b' tdsql_withgts 301;
select *from t force index(primary);
XA end 'b';
XA prepare 'b';
XA commit 'b' tdsql_withgts 302;

#t2 XA-select with_gts blocking
XA start 'b' tdsql_withgts 302;
send select *from t force index(primary);

#t3 XA-select with_gts blocking
connection conn2;
use dbtest_gts;
XA start 'c' tdsql_withgts 303;
send select *from t force index(primary);

--sleep 1
#t1 commit
connection default;
xa commit 'a' tdsql_withgts 303;

# t2 select tdsql_withgts returns and can not see the change
connection conn1;
reap;
XA end 'b';
XA prepare 'b';
XA commit 'b' tdsql_withgts 304;

# t3 select tdsql_withgts returns and can see the change
connection conn2;
reap;
XA end 'c';
XA prepare 'c';
XA commit 'c' tdsql_withgts 305;

#########################
##case 1.3 The xa-prepare with no gts info
connection default;
#t1 start a normal XA transtion
XA start 'a';
insert into t values(5,'e',0);
XA end 'a';
XA prepare 'a';

#t2 XA-select with_gts and no waitting
connection conn1;
use dbtest_gts;
XA start 'b' tdsql_withgts 306;
select *from t force index(primary);
XA end 'b';
XA prepare 'b';
XA commit 'b';

#t2 XA-select with_gts and no waitting
select *from t force index(primary) tdsql_withgts 307;

#t1 commit
connection default;
xa commit 'a';

#clean
disconnect conn1;
DROP DATABASE dbtest_gts;
PURGE TDSQL_TLOG logs;

--disable_warnings
DROP DATABASE IF EXISTS dbtest_gts;
--enable_warnings

CREATE DATABASE dbtest_gts;
use dbtest_gts;
--disable_warnings
drop table if exists t;
--enable_warnings
create table t(id int primary key, name char(10),gts int, index i_name(name));

PURGE TDSQL_TLOG logs;

XA start 'a' tdsql_withgts 100;
insert into t values(3,'c',100);
XA end 'a';
XA prepare 'a';
xa commit 'a' tdsql_withgts 101;

XA start 'a' tdsql_withgts 700;
insert into t values(4,'d',700);
XA end 'a';
XA prepare 'a';
xa commit 'a' tdsql_withgts 701;

SET GLOBAL innodb_min_purge_gts = 200;

SHOW GLOBAL VARIABLES LIKE "mc_gts_check";

# XA start statement
--error ER_INVALID_TDSQL_GTS
XA start 'a' tdsql_withgts 199;

XA start 'a' tdsql_withgts 200;
insert into t values(5,'e',200);
XA end 'a';
XA prepare 'a';

# XA commit statement
SET GLOBAL innodb_min_purge_gts = 202;
--error ER_INVALID_TDSQL_GTS
xa commit 'a' tdsql_withgts 201;

# Success if mc_gts_check is OFF
SET GLOBAL mc_gts_check = OFF;
xa commit 'a' tdsql_withgts 201;

# Select statement
SET GLOBAL mc_gts_check = ON;
--error ER_INVALID_TDSQL_GTS
select * from t tdsql_withgts 200;

connection default;
# Restart server as we cann't set innodb_min_purge_gts back
--source include/restart_mysqld.inc
DROP DATABASE dbtest_gts;
PURGE TDSQL_TLOG logs;

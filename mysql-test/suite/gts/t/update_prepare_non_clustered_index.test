--disable_warnings
DROP DATABASE IF EXISTS dbtest_gts;
--enable_warnings
 
CREATE DATABASE dbtest_gts;
use dbtest_gts;
--disable_warnings
drop table if exists t;
--enable_warnings
create table t(id int primary key, name char(10),gts int, index i_name(name));

insert into t values(1,'a',0);

XA start 'a' tdsql_withgts 600;
insert into t values(2,'b',601);
XA end 'a';
XA prepare 'a';
XA commit 'a' tdsql_withgts 601;

#########################
#caset 1.1 The xa-prepare for normal select with_gts
#t1 start a normal XA transtion
XA start 'a' tdsql_withgts 601;
update t set gts=602 where id =1;
XA end 'a';
XA prepare 'a';

#t2 select with_gts no blocking
connect(conn1,localhost,root);
use dbtest_gts;
select name from t force index(i_name) tdsql_withgts 600;

#t2 select with_gts and blocking
send select name from t force index(i_name) tdsql_withgts 601;

#t3 select with_gts and blocking
connect(conn2,localhost,root);
use dbtest_gts;
send select name from t force index(i_name) tdsql_withgts 602;

--sleep 1
#t1 commit
connection default;
xa commit 'a' tdsql_withgts 602;

#t2 returns and can not see the change
connection conn1;
reap;

#t3 returns and can see the change
connection conn2;
reap;


#########################
#case 1.2 The xa-prepare of the update event for XA-select with_gts
connection default;
#t1 start a normal XA transtion
XA start 'a' tdsql_withgts 602;
update t set gts=604 where id =1;
XA end 'a';
XA prepare 'a';

#t2 XA-select with_gts no blocking
connection conn1;
use dbtest_gts;
XA start 'b' tdsql_withgts 601;
select name from t force index(i_name);
XA end 'b';
XA prepare 'b';
XA commit 'b' tdsql_withgts 603;

#t2 XA-select with_gts blocking
XA start 'b' tdsql_withgts 603;
send select name from t force index(i_name);

#t3 select with_gts and blocking
connection conn2;
use dbtest_gts;
XA start 'c' tdsql_withgts 604;
send select name from t force index(i_name);

--sleep 1
#t1 commit
connection default;
xa commit 'a' tdsql_withgts 604;

#t2 select returns and can not see the change
connection conn1;
reap;
XA end 'b';
XA prepare 'b';
XA commit 'b' tdsql_withgts 605;

#t3 select returns and can see the change
connection conn2;
reap;
XA end 'c';
XA prepare 'c';
XA commit 'c' tdsql_withgts 606;


#########################
#case 1.3 The xa-prepare of the update event with no gts info
connection default;
#t1 start a normal XA transtion
XA start 'a';
update t set gts=0 where id =1;
XA end 'a';
XA prepare 'a';

#t2 select with_gts and no blocking
connection conn1;
use dbtest_gts;
XA start 'b' tdsql_withgts 606;
select name from t force index(i_name);
XA end 'b';
XA prepare 'b';
XA commit 'b' tdsql_withgts 607;

#t2 select with_gts and no blocking
select name from t force index(i_name) tdsql_withgts 608;

#t1 commit
connection default;
xa commit 'a' tdsql_withgts 609;

#t1 select with_gts and no blocking
select name from t force index(i_name) tdsql_withgts 609;

#clean
connection default;
disconnect conn1;
DROP DATABASE dbtest_gts;
PURGE TDSQL_TLOG logs;

--disable_warnings
DROP DATABASE IF EXISTS dbtest_gts;
--enable_warnings
 
CREATE DATABASE dbtest_gts;
use dbtest_gts;
--disable_warnings
drop table if exists t;
--enable_warnings
create table t(id int primary key, name char(10),gts int, index i_name(name));

insert into t values(1,'a',0);

XA start 'a' tdsql_withgts 500;
insert into t values(2,'b',501);
XA end 'a';
XA prepare 'a';
XA commit 'a' tdsql_withgts 501;

#########################
#caset 1.1 The xa-prepare for normal select with_gts
#t1 start a normal XA transtion
XA start 'a' tdsql_withgts 501;
update t set gts=502 where id =1;
XA end 'a';
XA prepare 'a';

#t2 select with_gts no blocking
connect(conn1,localhost,root);
use dbtest_gts;
select *from t force index(primary) tdsql_withgts 500;

#t2 select with_gts and blocking
send select *from t force index(primary) tdsql_withgts 501;

#t3 select with_gts and blocking
connect(conn2,localhost,root);
use dbtest_gts;
send select *from t force index(primary) tdsql_withgts 502;

--sleep 1
#t1 commit
connection default;
xa commit 'a' tdsql_withgts 502;

#t2 returns and can not see the change
connection conn1;
reap;

#t3 returns and can see the change
connection conn2;
reap;


#########################
#case 1.2 The xa-prepare of the update event for XA-select with_gts
connection default;
#t1 start a normal XA transtion
XA start 'a' tdsql_withgts 502;
update t set gts=504 where id =1;
XA end 'a';
XA prepare 'a';

#t2 XA-select with_gts no blocking
connection conn1;
use dbtest_gts;
XA start 'b' tdsql_withgts 501;
select *from t force index(primary);
XA end 'b';
XA prepare 'b';
XA commit 'b' tdsql_withgts 503;

#t2 XA-select with_gts blocking
XA start 'b' tdsql_withgts 503;
send select *from t force index(primary);

#t3 select with_gts and blocking
connection conn2;
use dbtest_gts;
XA start 'c' tdsql_withgts 504;
send select *from t force index(primary);

--sleep 1
#t1 commit
connection default;
xa commit 'a' tdsql_withgts 504;

#t2 select returns and can not see the change
connection conn1;
reap;
XA end 'b';
XA prepare 'b';
XA commit 'b' tdsql_withgts 505;

#t3 select returns and can see the change
connection conn2;
reap;
XA end 'c';
XA prepare 'c';
XA commit 'c' tdsql_withgts 506;


#########################
#case 1.3 The xa-prepare of the update event with no gts info
connection default;
#t1 start a normal XA transtion
XA start 'a';
update t set gts=0 where id =1;
XA end 'a';
XA prepare 'a';

#t2 select with_gts and no blocking
connection conn1;
use dbtest_gts;
XA start 'b' tdsql_withgts 506;
select *from t force index(primary);
XA end 'b';
XA prepare 'b';
XA commit 'b' tdsql_withgts 507;

#t2 select with_gts and no blocking
select *from t force index(primary) tdsql_withgts 508;

#t1 commit
connection default;
xa commit 'a' tdsql_withgts 509;

#t1 select with_gts and no blocking
select *from t force index(primary) tdsql_withgts 509;

#clean
connection default;
disconnect conn1;
DROP DATABASE dbtest_gts;
PURGE TDSQL_TLOG logs;

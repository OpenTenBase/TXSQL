INSERT INTO sbtest2 (id, k, c, pad) VALUES (49949, 25065, '8740870360-96092211895-92245845870-50076433705-770507855-78557557344-51477159996-19560961956-50017336227-53535198032', '16240797034-59926863925-15186166368-5805268926-6889');
SELECT * FROM sbtest2 WHERE id=49928;
--replace_column 5 #
SELECT * FROM sbtest2 WHERE id=49949;

--echo # TestPoint : test update after hiding partition
#The item where id=661 exists in partition 32
UPDATE sbtest2 SET c='hide_partitions_003' WHERE id=661;
#The item where id=1949 does not exist in partition 32
UPDATE sbtest2 SET c='hide_partitions_004' WHERE id=1949;
SELECT c FROM sbtest2 WHERE id=661;
SELECT c FROM sbtest2 WHERE id=1949;

--echo # TestPoint : test delete after hiding partition
#item in partition 32
DELETE from sbtest2 where id=1964;
#item  not in partition 32
DELETE from sbtest2 where id=1931;

SELECT COUNT(*) FROM sbtest2;

--echo # 1.3 hide parts of the partitions
--echo # TestPoint : test select after hiding partition
SELECT COUNT(*) FROM sbtest1;
SELECT COUNT(*) FROM sbtest2;
SELECT COUNT(*) FROM sbtest3;
SELECT COUNT(*) FROM sbtest4;
SELECT COUNT(*) FROM sbtest5;


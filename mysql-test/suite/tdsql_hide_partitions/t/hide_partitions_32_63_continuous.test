--disable_warnings
DROP DATABASE IF EXISTS dbtest_parts_32_63;
--enable_warnings                                                                                                                                                     
CREATE DATABASE dbtest_parts_32_63;

--exec $MYSQL --disable-comments dbtest_parts_32_63 2>&1 < "suite/tdsql_hide_partitions/include/32-63.sql"

--disable_query_log
USE dbtest_parts_32_63;
--enable_query_log
SELECT COUNT(*) FROM sbtest1;
SELECT COUNT(*) FROM sbtest2;
SELECT COUNT(*) FROM sbtest3;

--echo # 1.1 hide all the partitions
--echo # TestPoint : set tdsql_hide_partitions
SHOW GLOBAL VARIABLES LIKE "tdsql_hide_partitions";
SET GLOBAL tdsql_hide_partitions='32-63';
--echo # TestPoint : show tdsql_hide_partitions
SHOW GLOBAL VARIABLES LIKE "tdsql_hide_partitions";

--echo # TestPoint : select after hiding partitions
SELECT COUNT(*) FROM sbtest1;
SELECT COUNT(*) FROM sbtest2;
SELECT COUNT(*) FROM sbtest3;
--echo # TestPoint : insert after hiding partitions
--error 1526
INSERT INTO sbtest1 (id, k, c, pad) VALUES (950292, 502, '54597664649-67433364011-97677597551-77298823214-29287984746-76563689377-50441476395-21252218775-94708970004-80135758167', '25162847773-58972245813-67950978727-19293975806-53685824203');
--echo # TestPoint : update after hiding partitions
UPDATE sbtest1 set c='hide_partition_test_001' where 1=1;
SELECT COUNT(*) FROM sbtest1 where c='hide_partition_test_001';
--echo # TestPoint : delete after hiding partitions
DELETE from sbtest1 where id>100;

SET GLOBAL tdsql_hide_partitions='';
SHOW GLOBAL VARIABLES LIKE "tdsql_hide_partitions";

--echo # TestPoint : select/update/delete/insert after release
--echo # test select after release
SELECT COUNT(*) FROM sbtest1;
--echo # test update after release
UPDATE sbtest1 set c='hide_partition_test_002' where id=96;
--replace_column 5 #
SELECT * FROM sbtest1 where id=96;
--echo # test insert after release
INSERT INTO sbtest1 (id, k, c, pad) VALUES (950292, 502, '54597664649-67433364011-97677597551-77298823214-29287984746-76563689377-50441476395-21252218775-94708970004-80135758167', '25162847773-58972245813-67950978727-19293975806-53685824203');
--replace_column 5 #
SELECT * FROM sbtest1 where id=950292;
--echo # test delete after release
DELETE from sbtest1 where id=950292;
SELECT COUNT(*) FROM sbtest1;

--echo # 1.2 hide single part of the partitions
SET GLOBAL tdsql_hide_partitions='32';
SHOW GLOBAL VARIABLES LIKE "tdsql_hide_partitions";

--echo # TestPoint : test select after hiding partition
SELECT COUNT(*) FROM sbtest1;
SELECT COUNT(*) FROM sbtest2;
SELECT COUNT(*) FROM sbtest3;
--replace_column 5 #
SELECT * FROM sbtest2 WHERE id=49949;
--replace_column 5 #
SELECT * FROM sbtest1 WHERE id=1560;
--replace_column 5 #
SELECT * FROM sbtest2 WHERE id=1560;
--replace_column 5 #
SELECT * FROM sbtest3 WHERE id=1560;

--echo # TestPoint : test insert after hiding partition
--error 1526

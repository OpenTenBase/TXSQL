--disable_warnings
DROP DATABASE IF EXISTS dbtest_parts_0_31;
--enable_warnings
CREATE DATABASE dbtest_parts_0_31;

--exec $MYSQL --disable-comments dbtest_parts_0_31 2>&1 < "suite/tdsql_hide_partitions/include/0-31.sql"

USE dbtest_parts_0_31;
SELECT COUNT(*) FROM sbtest1;
SELECT COUNT(*) FROM sbtest2;
SELECT COUNT(*) FROM sbtest3;
SELECT COUNT(*) FROM sbtest4;
SELECT COUNT(*) FROM sbtest5;

--echo # 1.1 hide all the partitions
--echo # TestPoint : set tdsql_hide_partitions
SHOW GLOBAL VARIABLES LIKE "tdsql_hide_partitions";
SET GLOBAL tdsql_hide_partitions='0-31';
--echo # TestPoint : show tdsql_hide_partitions
SHOW GLOBAL VARIABLES LIKE "tdsql_hide_partitions";

--echo # TestPoint : select after hiding partitions
SELECT COUNT(*) FROM sbtest1;
SELECT COUNT(*) FROM sbtest2;
SELECT COUNT(*) FROM sbtest3;
SELECT COUNT(*) FROM sbtest4;
SELECT COUNT(*) FROM sbtest5;
--echo # TestPoint : insert after hiding partitions
--error 1526
#partition 10
INSERT INTO sbtest5 (id, k, c, pad) VALUES (20077, 502, '54597664649-67433364011-97677597551-77298823214-29287984746-76563689377-50441476395-21252218775-94708970004-80135758167', '25162847773-58972245813-67950978727-19293975806-53685824203');
--echo # TestPoint : update after hiding partitions
UPDATE sbtest5 set c='hide_partition_test_100' where 1=1;
SELECT COUNT(*) FROM sbtest5 where c='hide_partition_test100';
--echo # TestPoint : delete after hiding partitions
DELETE from sbtest5 where id>100;

SET GLOBAL tdsql_hide_partitions='';
SHOW GLOBAL VARIABLES LIKE "tdsql_hide_partitions";

--echo # TestPoint : select/update/delete/insert after release
--echo # test select after release
SELECT COUNT(*) FROM sbtest5;
--echo # test update after release
UPDATE sbtest5 set c='hide_partition_test_101' where id=523;
--replace_column 5 #
SELECT * FROM sbtest5 where id=523;
--echo # test insert after release
INSERT INTO sbtest5 (id, k, c, pad) VALUES (20197, 502, '54597664649-67433364011-97677597551-77298823214-29287984746-76563689377-50441476395-21252218775-94708970004-80135758167', '25162847773-58972245813-67950978727-19293975806-53685824203');
--replace_column 5 #
SELECT * FROM sbtest5 where id=20197;
--echo # test delete after release
DELETE from sbtest5 where id=467;
SELECT COUNT(*) FROM sbtest5;

--echo # 1.2 hide single part of the partitions

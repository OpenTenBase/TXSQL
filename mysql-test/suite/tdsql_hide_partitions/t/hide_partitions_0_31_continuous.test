SELECT COUNT(*) FROM sbtest3 partition(p5,p6,p7,p8,p9,p10);
SELECT COUNT(*) FROM sbtest4 partition(p5,p6,p7,p8,p9,p10);
SELECT COUNT(*) FROM sbtest5 partition(p5,p6,p7,p8,p9,p10);


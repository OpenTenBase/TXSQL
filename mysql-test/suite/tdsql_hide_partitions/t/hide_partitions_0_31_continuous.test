--echo # TestPoint : test update after hiding partition
#The item where id=447 exists in partition p0
UPDATE sbtest5 SET c='hide_partitions_test_102' WHERE id=447;
#The item where id=888 does not exist in partition 31
UPDATE sbtest5 SET c='hide_partitions_test_103' WHERE id=888;
SELECT c FROM sbtest5 WHERE id=447;
SELECT c FROM sbtest5 WHERE id=888;

--echo # TestPoint : test delete after hiding partition
#item in partition 0
DELETE from sbtest5 where id=720;
#item  not in partition 31
DELETE from sbtest5 where id=500;

SELECT COUNT(*) FROM sbtest5;

--echo # 1.3 hide parts of the partitions
--echo # TestPoint : test select after hiding partition
SELECT COUNT(*) FROM sbtest1;
SELECT COUNT(*) FROM sbtest2;
SELECT COUNT(*) FROM sbtest3;
SELECT COUNT(*) FROM sbtest4;
SELECT COUNT(*) FROM sbtest5;

SET GLOBAL tdsql_hide_partitions='5-10';
SHOW GLOBAL VARIABLES LIKE "tdsql_hide_partitions";
SELECT COUNT(*) FROM sbtest1;
SELECT COUNT(*) FROM sbtest2;
SELECT COUNT(*) FROM sbtest3;
SELECT COUNT(*) FROM sbtest4;
SELECT COUNT(*) FROM sbtest5;


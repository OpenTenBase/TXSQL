--enable_warnings

CREATE DATABASE dbtest_seq_cac;

use dbtest_seq_cac;

#default value 
CREATE TDSQL_SEQUENCE sequence_000 TDSQL_MAXVALUE 1000 TDSQL_minvalue 100;

CREATE TABLE t0(a int PRIMARY KEY);


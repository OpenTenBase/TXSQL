#TPC-H/TPC-R Returned Item Reporting Query (Q10)
explain format=tree select
c_custkey,
c_name,
sum(l_extendedprice * (1 - l_discount)) as revenue,
c_acctbal,
n_name,
c_address,
c_phone,
c_comment
from
customer,
orders,
lineitem,
nation
where
c_custkey = o_custkey
and l_orderkey = o_orderkey
and o_orderdate >= '1994-09-01'
	and o_orderdate < date_add( '1994-09-01' ,interval '3' month)
and l_returnflag = 'R'
	and c_nationkey = n_nationkey
group by
c_custkey,
c_name,
c_acctbal,
c_phone,
n_name,
c_address,
c_comment
order by
revenue desc
LIMIT 20;
EXPLAIN
-> Limit: 20 row(s)
    -> Sort: revenue DESC, limit input to 20 row(s) per chunk
        -> Table scan on <temp>
            -> Aggregate using temporary table
                -> Exchange Receive dop )
                    -> Exchange Send dop )
                        -> Table scan on <temporary>
                            -> Aggregate using temporary table
                                -> Nested loop inner join  (cost=*** rows=***)
                                    -> Nested loop inner join  (cost=*** rows=***)
                                        -> Nested loop inner join  (cost=*** rows=***)
                                            -> Filter: (lineitem.l_returnflag = 'R')  (cost=*** rows=***)
                                                -> Table scan on lineitem  (cost=*** rows=***)
                                            -> Filter: ((orders.o_orderdate >= DATE'1994-09-01') and (orders.o_orderdate < <cache>(('1994-09-01' + interval '3' month))))  (cost=*** rows=***)
                                                -> Single-row index lookup on orders using PRIMARY (o_orderkey=lineitem.l_orderkey)  (cost=*** rows=***)
                                        -> Single-row index lookup on customer using PRIMARY (c_custkey=orders.o_custkey)  (cost=*** rows=***)
                                    -> Single-row index lookup on nation using PRIMARY (n_nationkey=customer.c_nationkey)  (cost=*** rows=***)

select
c_custkey,
c_name,
sum(l_extendedprice * (1 - l_discount)) as revenue,
c_acctbal,
n_name,
c_address,
c_phone,
c_comment
from
customer,
orders,
lineitem,
nation
where
c_custkey = o_custkey
and l_orderkey = o_orderkey
and o_orderdate >= '1994-09-01'
	and o_orderdate < date_add( '1994-09-01' ,interval '3' month)
and l_returnflag = 'R'
	and c_nationkey = n_nationkey
group by
c_custkey,
c_name,
c_acctbal,
c_phone,
n_name,
c_address,
c_comment
order by
revenue desc
LIMIT 20;

#TPC-H/TPC-R Promotion Effect Query (Q14)
explain format=tree select
100.00 * sum(case
when p_type like 'PROMO%'
			then l_extendedprice * (1 - l_discount)
else 0
end) / sum(l_extendedprice * (1 - l_discount)) as promo_revenue
from
lineitem,
part
where
l_partkey = p_partkey
and l_shipdate >= '1997-07-01'
	and l_shipdate < date_add( '1997-07-01', interval '1' month);
EXPLAIN
-> Aggregate: sum((lineitem.l_extendedprice * (1 - lineitem.l_discount))), sum((case when (part.p_type like 'PROMO%') then (lineitem.l_extendedprice * (1 - lineitem.l_discount)) else 0 end))
    -> Exchange Receive dop )
        -> Exchange Send dop )
            -> Aggregate: sum((lineitem.l_extendedprice * (1 - lineitem.l_discount))), sum((case when (part.p_type like 'PROMO%') then (lineitem.l_extendedprice * (1 - lineitem.l_discount)) else 0 end))
                -> Nested loop inner join  (cost=*** rows=***)
                    -> Filter: ((lineitem.l_shipdate >= DATE'1997-07-01') and (lineitem.l_shipdate < <cache>(('1997-07-01' + interval '1' month))))  (cost=*** rows=***)
                        -> Table scan on lineitem  (cost=*** rows=***)
                    -> Single-row index lookup on part using PRIMARY (p_partkey=lineitem.l_partkey)  (cost=*** rows=***)

select
100.00 * sum(case
when p_type like 'PROMO%'
			then l_extendedprice * (1 - l_discount)
else 0
end) / sum(l_extendedprice * (1 - l_discount)) as promo_revenue
from
lineitem,
part
where
l_partkey = p_partkey
and l_shipdate >= '1997-07-01'
	and l_shipdate < date_add( '1997-07-01', interval '1' month);

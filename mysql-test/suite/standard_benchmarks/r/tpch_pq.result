#TPC-H/TPC-R Local Supplier Volume Query (Q5)
explain format=tree select
n_name,
sum(l_extendedprice * (1 - l_discount)) as revenue
from
customer,
orders,
lineitem,
supplier,
nation,
region
where
c_custkey = o_custkey
and l_orderkey = o_orderkey
and l_suppkey = s_suppkey
and c_nationkey = s_nationkey
and s_nationkey = n_nationkey
and n_regionkey = r_regionkey
and r_name = 'MIDDLE EAST'
	and o_orderdate >= '1997-01-01'
	and o_orderdate < date_add( '1997-01-01', interval '1' year)
group by
n_name
order by
revenue desc;
EXPLAIN
-> Sort: revenue DESC
    -> Table scan on <temporary>
        -> Aggregate using temporary table
            -> Nested loop inner join  (cost=*** rows=***)
                -> Nested loop inner join  (cost=*** rows=***)
                    -> Nested loop inner join  (cost=*** rows=***)
                        -> Nested loop inner join  (cost=*** rows=***)
                            -> Inner hash join (no condition)  (cost=*** rows=***)
                                -> Filter: ((orders.o_orderdate >= DATE'1997-01-01') and (orders.o_orderdate < <cache>(('1997-01-01' + interval '1' year))))  (cost=*** rows=***)
                                    -> Table scan on orders  (cost=*** rows=***)
                                -> Hash
                                    -> Filter: (region.r_name = 'MIDDLE EAST')  (cost=*** rows=***)
                                        -> Table scan on region  (cost=*** rows=***)
                            -> Single-row index lookup on customer using PRIMARY (c_custkey=orders.o_custkey)  (cost=*** rows=***)
                        -> Filter: (nation.n_regionkey = region.r_regionkey)  (cost=*** rows=***)
                            -> Single-row index lookup on nation using PRIMARY (n_nationkey=customer.c_nationkey)  (cost=*** rows=***)
                    -> Index lookup on lineitem using PRIMARY (l_orderkey=orders.o_orderkey)  (cost=*** rows=***)
                -> Filter: (supplier.s_nationkey = customer.c_nationkey)  (cost=*** rows=***)
                    -> Single-row index lookup on supplier using PRIMARY (s_suppkey=lineitem.l_suppkey)  (cost=*** rows=***)

select
n_name,
sum(l_extendedprice * (1 - l_discount)) as revenue
from
customer,
orders,
lineitem,
supplier,
nation,
region
where
c_custkey = o_custkey
and l_orderkey = o_orderkey
and l_suppkey = s_suppkey
and c_nationkey = s_nationkey
and s_nationkey = n_nationkey
and n_regionkey = r_regionkey
and r_name = 'MIDDLE EAST'
	and o_orderdate >= '1997-01-01'
	and o_orderdate < date_add( '1997-01-01', interval '1' year)
group by
n_name
order by
revenue desc;

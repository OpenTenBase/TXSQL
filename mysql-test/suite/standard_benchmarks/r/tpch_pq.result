#TPC-H/TPC-R Discounted Revenue Query (Q19)
explain format=tree select
sum(l_extendedprice* (1 - l_discount)) as revenue
from
lineitem,
part
where
(
p_partkey = l_partkey
and p_brand = 'Brand#24'
		and p_container in ('SM CASE', 'SM BOX', 'SM PACK', 'SM PKG')
and l_quantity >= 5 and l_quantity <= 5+10
and p_size between 1 and 40
and l_shipmode in ('AIR', 'REG AIR')
and l_shipinstruct = 'DELIVER IN PERSON'
	)
or
(
p_partkey = l_partkey
and p_brand = 'Brand#35'
		and p_container in ('MED BAG', 'MED BOX', 'MED PKG', 'MED PACK')
and l_quantity >= 20 and l_quantity <= 20+10
and p_size between 1 and 44
and l_shipmode in ('AIR', 'REG AIR')
and l_shipinstruct = 'DELIVER IN PERSON'
	)
or
(
p_partkey = l_partkey
and p_brand = 'Brand#42'
		and p_container in ('LG CASE', 'LG BOX', 'LG PACK', 'LG PKG')
and l_quantity >= 30 and l_quantity <= 30+10
and p_size between 19 and 31
and l_shipmode in ('AIR', 'REG AIR')
and l_shipinstruct = 'DELIVER IN PERSON'
	);
EXPLAIN
-> Aggregate: sum((lineitem.l_extendedprice * (1 - lineitem.l_discount)))
    -> Exchange Receive dop )
        -> Exchange Send dop )
            -> Aggregate: sum((lineitem.l_extendedprice * (1 - lineitem.l_discount)))
                -> Nested loop inner join  (cost=*** rows=***)
                    -> Filter: (((lineitem.l_shipinstruct = 'DELIVER IN PERSON') and (lineitem.l_quantity >= 5.00) and (lineitem.l_quantity <= <cache>((5 + 10))) and (lineitem.l_shipmode in ('AIR','REG AIR'))) or ((lineitem.l_shipinstruct = 'DELIVER IN PERSON') and (lineitem.l_quantity >= 20.00) and (lineitem.l_quantity <= <cache>((20 + 10))) and (lineitem.l_shipmode in ('AIR','REG AIR'))) or ((lineitem.l_shipinstruct = 'DELIVER IN PERSON') and (lineitem.l_quantity >= 30.00) and (lineitem.l_quantity <= <cache>((30 + 10))) and (lineitem.l_shipmode in ('AIR','REG AIR'))))  (cost=*** rows=***)
                        -> Table scan on lineitem  (cost=*** rows=***)
                    -> Filter: (((lineitem.l_shipinstruct = 'DELIVER IN PERSON') and (part.p_brand = 'Brand#24') and (part.p_container in ('SM CASE','SM BOX','SM PACK','SM PKG')) and (lineitem.l_quantity >= 5.00) and (lineitem.l_quantity <= <cache>((5 + 10))) and (part.p_size between 1 and 40) and (lineitem.l_shipmode in ('AIR','REG AIR'))) or ((lineitem.l_shipinstruct = 'DELIVER IN PERSON') and (part.p_brand = 'Brand#35') and (part.p_container in ('MED BAG','MED BOX','MED PKG','MED PACK')) and (lineitem.l_quantity >= 20.00) and (lineitem.l_quantity <= <cache>((20 + 10))) and (part.p_size between 1 and 44) and (lineitem.l_shipmode in ('AIR','REG AIR'))) or ((lineitem.l_shipinstruct = 'DELIVER IN PERSON') and (part.p_brand = 'Brand#42') and (part.p_container in ('LG CASE','LG BOX','LG PACK','LG PKG')) and (lineitem.l_quantity >= 30.00) and (lineitem.l_quantity <= <cache>((30 + 10))) and (part.p_size between 19 and 31) and (lineitem.l_shipmode in ('AIR','REG AIR'))))  (cost=*** rows=***)
                        -> Single-row index lookup on part using PRIMARY (p_partkey=lineitem.l_partkey)  (cost=*** rows=***)

select
sum(l_extendedprice* (1 - l_discount)) as revenue
from
lineitem,
part
where
(
p_partkey = l_partkey
and p_brand = 'Brand#24'
		and p_container in ('SM CASE', 'SM BOX', 'SM PACK', 'SM PKG')
and l_quantity >= 5 and l_quantity <= 5+10
and p_size between 1 and 40
and l_shipmode in ('AIR', 'REG AIR')
and l_shipinstruct = 'DELIVER IN PERSON'
	)
or
(
p_partkey = l_partkey
and p_brand = 'Brand#35'
		and p_container in ('MED BAG', 'MED BOX', 'MED PKG', 'MED PACK')
and l_quantity >= 20 and l_quantity <= 20+10
and p_size between 1 and 44
and l_shipmode in ('AIR', 'REG AIR')
and l_shipinstruct = 'DELIVER IN PERSON'
	)
or
(
p_partkey = l_partkey
and p_brand = 'Brand#42'
		and p_container in ('LG CASE', 'LG BOX', 'LG PACK', 'LG PKG')
and l_quantity >= 30 and l_quantity <= 30+10
and p_size between 19 and 31
and l_shipmode in ('AIR', 'REG AIR')
and l_shipinstruct = 'DELIVER IN PERSON'
	);

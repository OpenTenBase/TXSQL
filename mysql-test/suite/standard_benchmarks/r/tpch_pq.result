#TPC-H/TPC-R Shipping Modes and Order Priority Query (Q12)
explain format=tree select
l_shipmode,
sum(case
when o_orderpriority = '1-URGENT'
			or o_orderpriority = '2-HIGH'
			then 1
else 0
end) as high_line_count,
sum(case
when o_orderpriority <> '1-URGENT'
			and o_orderpriority <> '2-HIGH'
			then 1
else 0
end) as low_line_count
from
orders,
lineitem
where
o_orderkey = l_orderkey
and l_shipmode in ('TRUCK', 'REG AIR')
and l_commitdate < l_receiptdate
and l_shipdate < l_commitdate
and l_receiptdate >= '1997-01-01'
	and l_receiptdate < date_add( '1997-01-01', interval '1' year)
group by
l_shipmode
order by
l_shipmode;
EXPLAIN
-> Sort: lineitem.l_shipmode
    -> Table scan on <temp>
        -> Aggregate using temporary table
            -> Exchange Receive dop )
                -> Exchange Send dop )
                    -> Table scan on <temporary>
                        -> Aggregate using temporary table
                            -> Nested loop inner join  (cost=*** rows=***)
                                -> Filter: ((lineitem.l_shipmode in ('TRUCK','REG AIR')) and (lineitem.l_commitdate < lineitem.l_receiptdate) and (lineitem.l_shipdate < lineitem.l_commitdate) and (lineitem.l_receiptdate >= DATE'1997-01-01') and (lineitem.l_receiptdate < <cache>(('1997-01-01' + interval '1' year))))  (cost=*** rows=***)
                                    -> Table scan on lineitem  (cost=*** rows=***)
                                -> Single-row index lookup on orders using PRIMARY (o_orderkey=lineitem.l_orderkey)  (cost=*** rows=***)

select
l_shipmode,
sum(case
when o_orderpriority = '1-URGENT'
			or o_orderpriority = '2-HIGH'
			then 1
else 0
end) as high_line_count,
sum(case
when o_orderpriority <> '1-URGENT'
			and o_orderpriority <> '2-HIGH'
			then 1
else 0
end) as low_line_count
from
orders,
lineitem
where
o_orderkey = l_orderkey
and l_shipmode in ('TRUCK', 'REG AIR')
and l_commitdate < l_receiptdate
and l_shipdate < l_commitdate
and l_receiptdate >= '1997-01-01'
	and l_receiptdate < date_add( '1997-01-01', interval '1' year)
group by
l_shipmode
order by
l_shipmode;
l_shipmode	high_line_count	low_line_count
REG AIR	1	6
TRUCK	4	2
#TPC-H/TPC-R Customer Distribution Query (Q13)
explain format=tree select
c_count,
count(*) as custdist
from
(
select
c_custkey,
count(o_orderkey) as c_count
from
customer left outer join orders on
c_custkey = o_custkey
and o_comment not like '%special%deposits%'
		group by
c_custkey
) as c_orders
group by
c_count
order by
custdist desc,
c_count desc;
EXPLAIN
-> Sort: custdist DESC, c_orders.c_count DESC
    -> Table scan on <temporary>
        -> Aggregate using temporary table
            -> Table scan on c_orders  (cost=*** rows=***)
                -> Materialize
                    -> Table scan on <temporary>
                        -> Aggregate using temporary table
                            -> Left hash join (orders.o_custkey = customer.c_custkey)  (cost=*** rows=***)
                                -> Index scan on customer using PRIMARY  (cost=*** rows=***)
                                -> Hash
                                    -> Filter: (not((orders.o_comment like '%special%deposits%')))  (cost=*** rows=***)
                                        -> Table scan on orders  (cost=*** rows=***)

select
c_count,
count(*) as custdist
from
(
select
c_custkey,
count(o_orderkey) as c_count
from
customer left outer join orders on
c_custkey = o_custkey
and o_comment not like '%special%deposits%'
		group by
c_custkey
) as c_orders
group by
c_count
order by
custdist desc,
c_count desc;

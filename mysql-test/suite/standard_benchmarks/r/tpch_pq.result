#TPC-H/TPC-R Forecasting Revenue Change Query (Q6)
explain format=tree select
sum(l_extendedprice * l_discount) as revenue
from
lineitem
where
l_shipdate >= '1997-01-01'
	and l_shipdate < date_add( '1997-01-01' , interval '1' year)
and l_discount between 0.03 - 0.01 and 0.03 + 0.01
and l_quantity < 25;
EXPLAIN
-> Aggregate: sum((lineitem.l_extendedprice * lineitem.l_discount))
    -> Exchange Receive dop )
        -> Exchange Send dop )
            -> Aggregate: sum((lineitem.l_extendedprice * lineitem.l_discount))
                -> Filter: ((lineitem.l_shipdate >= DATE'1997-01-01') and (lineitem.l_shipdate < <cache>(('1997-01-01' + interval '1' year))) and (lineitem.l_discount between <cache>((0.03 - 0.01)) and <cache>((0.03 + 0.01))) and (lineitem.l_quantity < 25.00))  (cost=*** rows=***)
                    -> Table scan on lineitem  (cost=*** rows=***)

select
sum(l_extendedprice * l_discount) as revenue
from
lineitem
where
l_shipdate >= '1997-01-01'
	and l_shipdate < date_add( '1997-01-01' , interval '1' year)
and l_discount between 0.03 - 0.01 and 0.03 + 0.01
and l_quantity < 25;

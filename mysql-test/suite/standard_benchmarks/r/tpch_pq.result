#TPC-H/TPC-R Volume Shipping Query (Q7)
explain format=tree select
supp_nation,
cust_nation,
l_year,
sum(volume) as revenue
from
(
select
n1.n_name as supp_nation,
n2.n_name as cust_nation,
extract(year from l_shipdate) as l_year,
l_extendedprice * (1 - l_discount) as volume
from
supplier,
lineitem,
orders,
customer,
nation n1,
nation n2
where
s_suppkey = l_suppkey
and o_orderkey = l_orderkey
and c_custkey = o_custkey
and s_nationkey = n1.n_nationkey
and c_nationkey = n2.n_nationkey
and (
(n1.n_name = 'EGYPT' and n2.n_name = 'MOZAMBIQUE')
or (n1.n_name = 'MOZAMBIQUE' and n2.n_name = 'EGYPT')
)
and l_shipdate between '1995-01-01' and '1996-12-31'
	) as shipping
group by
supp_nation,
cust_nation,
l_year
order by
supp_nation,
cust_nation,
l_year;
EXPLAIN
-> Sort: shipping.supp_nation, shipping.cust_nation, shipping.l_year
    -> Table scan on <temp>
        -> Aggregate using temporary table
            -> Exchange Receive dop )
                -> Exchange Send dop )
                    -> Table scan on <temporary>
                        -> Aggregate using temporary table
                            -> Nested loop inner join  (cost=*** rows=***)
                                -> Nested loop inner join  (cost=*** rows=***)
                                    -> Nested loop inner join  (cost=*** rows=***)
                                        -> Nested loop inner join  (cost=*** rows=***)
                                            -> Nested loop inner join  (cost=*** rows=***)
                                                -> Filter: (lineitem.l_shipdate between '1995-01-01' and '1996-12-31')  (cost=*** rows=***)
                                                    -> Table scan on lineitem  (cost=*** rows=***)
                                                -> Single-row index lookup on supplier using PRIMARY (s_suppkey=lineitem.l_suppkey)  (cost=*** rows=***)
                                            -> Filter: ((n1.n_name = 'EGYPT') or (n1.n_name = 'MOZAMBIQUE'))  (cost=*** rows=***)
                                                -> Single-row index lookup on n1 using PRIMARY (n_nationkey=supplier.s_nationkey)  (cost=*** rows=***)
                                        -> Single-row index lookup on orders using PRIMARY (o_orderkey=lineitem.l_orderkey)  (cost=*** rows=***)
                                    -> Single-row index lookup on customer using PRIMARY (c_custkey=orders.o_custkey)  (cost=*** rows=***)
                                -> Filter: (((n2.n_name = 'MOZAMBIQUE') and (n1.n_name = 'EGYPT')) or ((n2.n_name = 'EGYPT') and (n1.n_name = 'MOZAMBIQUE')))  (cost=*** rows=***)
                                    -> Single-row index lookup on n2 using PRIMARY (n_nationkey=customer.c_nationkey)  (cost=*** rows=***)

select
supp_nation,
cust_nation,
l_year,
sum(volume) as revenue
from
(
select
n1.n_name as supp_nation,
n2.n_name as cust_nation,
extract(year from l_shipdate) as l_year,
l_extendedprice * (1 - l_discount) as volume
from
supplier,
lineitem,
orders,
customer,
nation n1,
nation n2
where
s_suppkey = l_suppkey
and o_orderkey = l_orderkey
and c_custkey = o_custkey
and s_nationkey = n1.n_nationkey
and c_nationkey = n2.n_nationkey
and (
(n1.n_name = 'EGYPT' and n2.n_name = 'MOZAMBIQUE')
or (n1.n_name = 'MOZAMBIQUE' and n2.n_name = 'EGYPT')
)
and l_shipdate between '1995-01-01' and '1996-12-31'
	) as shipping
group by
supp_nation,
cust_nation,
l_year
order by
supp_nation,
cust_nation,
l_year;
supp_nation	cust_nation	l_year	revenue
EGYPT	MOZAMBIQUE	1995	40037.0688
MOZAMBIQUE	EGYPT	1996	59607.0000
#TPC-H/TPC-R National Market Share Query (Q8)
explain format=tree select
o_year,
sum(case
when nation = 'MOZAMBIQUE' then volume
else 0
end) / sum(volume) as mkt_share
from
(
select
extract(year from o_orderdate) as o_year,
l_extendedprice * (1 - l_discount) as volume,
n2.n_name as nation
from
part,
supplier,
lineitem,
orders,
customer,
nation n1,
nation n2,
region
where
p_partkey = l_partkey
and s_suppkey = l_suppkey
and l_orderkey = o_orderkey
and o_custkey = c_custkey
and c_nationkey = n1.n_nationkey
and n1.n_regionkey = r_regionkey
and r_name = 'AFRICA'
			and s_nationkey = n2.n_nationkey
and o_orderdate between '1995-01-01' and '1996-12-31'
			and p_type = 'ECONOMY BURNISHED TIN'
	) as all_nations
group by
o_year
order by
o_year;
EXPLAIN
-> Sort: all_nations.o_year
    -> Table scan on <temporary>
        -> Aggregate using temporary table
            -> Nested loop inner join  (cost=*** rows=***)
                -> Nested loop inner join  (cost=*** rows=***)
                    -> Nested loop inner join  (cost=*** rows=***)
                        -> Nested loop inner join  (cost=*** rows=***)
                            -> Nested loop inner join  (cost=*** rows=***)
                                -> Nested loop inner join  (cost=*** rows=***)
                                    -> Inner hash join (no condition)  (cost=*** rows=***)
                                        -> Filter: (orders.o_orderdate between '1995-01-01' and '1996-12-31')  (cost=*** rows=***)
                                            -> Table scan on orders  (cost=*** rows=***)
                                        -> Hash
                                            -> Filter: (region.r_name = 'AFRICA')  (cost=*** rows=***)
                                                -> Table scan on region  (cost=*** rows=***)
                                    -> Single-row index lookup on customer using PRIMARY (c_custkey=orders.o_custkey)  (cost=*** rows=***)
                                -> Filter: (n1.n_regionkey = region.r_regionkey)  (cost=*** rows=***)
                                    -> Single-row index lookup on n1 using PRIMARY (n_nationkey=customer.c_nationkey)  (cost=*** rows=***)
                            -> Index lookup on lineitem using PRIMARY (l_orderkey=orders.o_orderkey)  (cost=*** rows=***)
                        -> Single-row index lookup on supplier using PRIMARY (s_suppkey=lineitem.l_suppkey)  (cost=*** rows=***)
                    -> Single-row index lookup on n2 using PRIMARY (n_nationkey=supplier.s_nationkey)  (cost=*** rows=***)
                -> Filter: (part.p_type = 'ECONOMY BURNISHED TIN')  (cost=*** rows=***)
                    -> Single-row index lookup on part using PRIMARY (p_partkey=lineitem.l_partkey)  (cost=*** rows=***)

select
o_year,
sum(case
when nation = 'MOZAMBIQUE' then volume
else 0
end) / sum(volume) as mkt_share
from
(
select
extract(year from o_orderdate) as o_year,
l_extendedprice * (1 - l_discount) as volume,
n2.n_name as nation
from
part,
supplier,
lineitem,
orders,
customer,
nation n1,
nation n2,
region
where
p_partkey = l_partkey
and s_suppkey = l_suppkey
and l_orderkey = o_orderkey
and o_custkey = c_custkey
and c_nationkey = n1.n_nationkey
and n1.n_regionkey = r_regionkey
and r_name = 'AFRICA'
			and s_nationkey = n2.n_nationkey
and o_orderdate between '1995-01-01' and '1996-12-31'
			and p_type = 'ECONOMY BURNISHED TIN'
	) as all_nations
group by
o_year
order by
o_year;
o_year	mkt_share

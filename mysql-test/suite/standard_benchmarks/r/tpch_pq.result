#TPC-H/TPC-R Global Sales Opportunity Query (Q22)
explain format=tree select
cntrycode,
count(*) as numcust,
sum(c_acctbal) as totacctbal
from
(
select
substr(c_phone from 1 for 2) as cntrycode,
c_acctbal
from
customer
where
substr(c_phone from 1 for 2) in
('32', '28', '20', '23', '34', '14', '18')
and c_acctbal > (
select
avg(c_acctbal)
from
customer
where
c_acctbal > 0.00
and substr(c_phone from 1 for 2) in
('32', '28', '20', '23', '34', '14', '18')
)
and not exists (
select
*
from
orders
where
o_custkey = c_custkey
)
) as custsale
group by
cntrycode
order by
cntrycode;
EXPLAIN
-> Sort: custsale.cntrycode
    -> Table scan on <temporary>
        -> Aggregate using temporary table
            -> Nested loop antijoin  (cost=*** rows=***)
                -> Filter: ((substr(customer.c_phone,1,2) in ('32','28','20','23','34','14','18')) and (customer.c_acctbal > (select #3)))  (cost=*** rows=***)
                    -> Table scan on customer  (cost=*** rows=***)
                    -> Select #3 (subquery in condition; run only once)
                        -> Aggregate: avg(customer.c_acctbal)
                            -> Filter: ((customer.c_acctbal > 0.00) and (substr(customer.c_phone,1,2) in ('32','28','20','23','34','14','18')))  (cost=*** rows=***)
                                -> Table scan on customer  (cost=*** rows=***)
                -> Single-row index lookup on <subquery4> using <auto_distinct_key> (o_custkey=customer.c_custkey)
                    -> Materialize with deduplication  (cost=*** rows=***)
                        -> Table scan on orders  (cost=*** rows=***)


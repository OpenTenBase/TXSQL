#TPC-H/TPC-R Shipping Priority Query (Q3)
explain format=tree select
l_orderkey,
sum(l_extendedprice * (1 - l_discount)) as revenue,
o_orderdate,
o_shippriority
from
customer,
orders,
lineitem
where
c_mktsegment = 'MACHINERY'
	and c_custkey = o_custkey
and l_orderkey = o_orderkey
and o_orderdate < '1995-03-11'
	and l_shipdate > '1995-03-11'
group by
l_orderkey,
o_orderdate,
o_shippriority
order by
revenue desc,
o_orderdate
LIMIT 10;
EXPLAIN
-> Limit: 10 row(s)
    -> Sort: revenue DESC, orders.o_orderdate, limit input to 10 row(s) per chunk
        -> Table scan on <temp>
            -> Aggregate using temporary table
                -> Exchange Receive dop )
                    -> Exchange Send dop )
                        -> Table scan on <temporary>
                            -> Aggregate using temporary table
                                -> Nested loop inner join  (cost=*** rows=***)
                                    -> Nested loop inner join  (cost=*** rows=***)
                                        -> Filter: (orders.o_orderdate < DATE'1995-03-11')  (cost=*** rows=***)
                                            -> Table scan on orders  (cost=*** rows=***)
                                        -> Filter: (customer.c_mktsegment = 'MACHINERY')  (cost=*** rows=***)
                                            -> Single-row index lookup on customer using PRIMARY (c_custkey=orders.o_custkey)  (cost=*** rows=***)
                                    -> Filter: (lineitem.l_shipdate > DATE'1995-03-11')  (cost=*** rows=***)
                                        -> Index lookup on lineitem using PRIMARY (l_orderkey=orders.o_orderkey)  (cost=*** rows=***)

select
l_orderkey,
sum(l_extendedprice * (1 - l_discount)) as revenue,
o_orderdate,
o_shippriority
from
customer,
orders,
lineitem
where
c_mktsegment = 'MACHINERY'
	and c_custkey = o_custkey
and l_orderkey = o_orderkey
and o_orderdate < '1995-03-11'
	and l_shipdate > '1995-03-11'
group by
l_orderkey,
o_orderdate,
o_shippriority
order by
revenue desc,
o_orderdate
LIMIT 10;
l_orderkey	revenue	o_orderdate	o_shippriority

master_uuid	1	1004
SELECT @@gtid_undeleted;
@@gtid_undeleted
master_uuid:5-1004
# Removing debug point 'stop_cleanup_owned_gtids' from @@GLOBAL.debug
SELECT * FROM mysql.gtid_executed;
source_uuid	interval_start	interval_end
master_uuid	1	1004
SELECT @@gtid_undeleted;
@@gtid_undeleted

==== Case4 ====
select @@gtid_executed,@@gtid_owned,@@gtid_undeleted;
@@gtid_executed	@@gtid_owned	@@gtid_undeleted
master_uuid:1-1004		
show master status;
File	Position	Binlog_Do_DB	Binlog_Ignore_DB	Executed_Gtid_Set
#	#	#		master_uuid:1-1004
SET debug_sync = "bgc_after_sync_stage_before_commit_stage WAIT_FOR continue";
INSERT INTO test.t VALUES(2);;
# gtid_undeleted should be null, and Executed_Gtid_Set should be less than gtid_executed.
select @@gtid_executed,@@gtid_owned,@@gtid_undeleted;
@@gtid_executed	@@gtid_owned	@@gtid_undeleted
master_uuid:1-1005		
show master status;
File	Position	Binlog_Do_DB	Binlog_Ignore_DB	Executed_Gtid_Set
#	#	#		master_uuid:1-1004
SET debug_sync = "now SIGNAL continue";
select @@gtid_executed,@@gtid_owned,@@gtid_undeleted;
@@gtid_executed	@@gtid_owned	@@gtid_undeleted
master_uuid:1-1005		master_uuid:1005
show master status;
File	Position	Binlog_Do_DB	Binlog_Ignore_DB	Executed_Gtid_Set
#	#	#		master_uuid:1-1005
==== Case5 ====
select @@gtid_executed,@@gtid_owned,@@gtid_undeleted;
@@gtid_executed	@@gtid_owned	@@gtid_undeleted
master_uuid:1-1005		
show master status;
File	Position	Binlog_Do_DB	Binlog_Ignore_DB	Executed_Gtid_Set
#	#	#		master_uuid:1-1005
# Adding debug point 'handle_gtid_on_finish_rollback' to @@GLOBAL.debug
# exec 20 times 'insert into...'
# gtid_undeleted and Executed_Gtid_Set should not be modified because all trx rollback.
select @@gtid_executed,@@gtid_owned,@@gtid_undeleted;
@@gtid_executed	@@gtid_owned	@@gtid_undeleted
master_uuid:1-1005		
show master status;
File	Position	Binlog_Do_DB	Binlog_Ignore_DB	Executed_Gtid_Set
#	#	#		master_uuid:1-1005
# Removing debug point 'handle_gtid_on_finish_rollback' from @@GLOBAL.debug
==== Case6 ====
# Adding debug point 'stop_cleanup_owned_gtids' to @@GLOBAL.debug
select @@binlog_order_commits;
@@binlog_order_commits
0
set global binlog_order_commits=1;
# exec 20 times 'insert into...'
set global binlog_order_commits=0;
# exec 20 times 'insert into...'
set global binlog_order_commits=1;
# exec 20 times 'insert into...'
set global binlog_order_commits=0;

######################################################################################################                                          
#
# ======  Test case for keyring_kms 3.0  ======
#
#######################################################################################################
#call mtr.add_suppression("Region field can not be null");

--replace_regex /\.dll/.so/
eval INSTALL PLUGIN keyring_kms SONAME '$KEYRING_KMS';

# 1.set kms with 3.0 config 
disable_query_log;
set global keyring_kms_config = '
{
    "kms_endpoint" : "your kms endpoint ,for example: kms.test.tencentcloudapi.com",
    "secret_id" : "your persisted kms secret_id",
    "secret_key" : "your persisted kms secret_key",
    "region" : "your kms region"
}';
enable_query_log;

# 2. rotate key
ALTER INSTANCE ROTATE INNODB MASTER KEY;


# 3. create and access table
CREATE TABLE `t1` (
  `c1` int(11) NOT NULL,
  PRIMARY KEY (`c1`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1 ENCRYPTION='Y' ;


insert into t1 values(1);
insert into t1 values(2);
insert into t1 values(3);
insert into t1 values(4);
select * from t1;

# 4. rotate binlog and innodb master key
ALTER INSTANCE ROTATE INNODB MASTER KEY;
set global binlog_encryption=ON;
ALTER INSTANCE ROTATE BINLOG MASTER KEY;

CREATE TABLE `t2` (
  `c1` int(11) NOT NULL,
  PRIMARY KEY (`c1`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1 ENCRYPTION='Y' ;
insert into t2 values(1);
insert into t2 values(2);
insert into t2 values(3);
insert into t2 values(4);
select * from t2;

# 5.cleanup
set global binlog_encryption=OFF;
drop table t1;
drop table t2;

UNINSTALL PLUGIN keyring_kms;

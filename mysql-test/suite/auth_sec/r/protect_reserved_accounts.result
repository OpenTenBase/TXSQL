# ----------------------------------------------------------------------
# CHECK ORDINARY USER

# CHECK INITIALIZATION OF RESERVED ACCOUNTS
SELECT user FROM mysql.user WHERE user LIKE 'mysql.%';
user
mysql.infoschema
mysql.session
mysql.sys

# TEST DROP RESERVED ACCOUNTS
DROP USER 'mysql.sys'@'localhost', 'mysql.infoschema'@'localhost', 'mysql.session'@'localhost';
ERROR HY000: Operation DROP USER failed for 'mysql.sys'@'localhost''mysql.infoschema'@'localhost''mysql.session'@'localhost'

# TEST RENAME RESERVED ACCOUNTS
RENAME USER 'mysql.sys'@'localhost' TO 'my.sys'@'localhost';
ERROR HY000: Operation RENAME USER failed for 'mysql.sys'@'localhost'
RENAME USER 'mysql.infoschema'@'localhost' TO 'my.infoschema'@'localhost';
ERROR HY000: Operation RENAME USER failed for 'mysql.infoschema'@'localhost'
RENAME USER 'mysql.session'@'localhost' TO 'my.session'@'localhost';
ERROR HY000: Operation RENAME USER failed for 'mysql.session'@'localhost'

# TEST ALTER RESERVED ACCOUNTS
ALTER USER 'mysql.sys'@'localhost', 'mysql.infoschema'@'localhost', 'mysql.session'@'localhost' IDENTIFIED BY 'auth_string';
ERROR HY000: Operation ALTER USER failed for 'mysql.sys'@'localhost''mysql.infoschema'@'localhost''mysql.session'@'localhost'

# TEST REVOKE ALL RESERVED ACCOUNTS
REVOKE ALL PRIVILEGES, GRANT OPTION FROM 'mysql.sys'@'localhost', 'mysql.infoschema'@'localhost', 'mysql.session'@'localhost';
ERROR HY000: Operation REVOKE ALL failed for 'mysql.sys'@'localhost''mysql.infoschema'@'localhost''mysql.session'@'localhost'

# TEST REVOKE RESERVED ACCOUNTS
REVOKE select ON *.* from 'mysql.sys'@'localhost', 'mysql.infoschema'@'localhost', 'mysql.session'@'localhost';
ERROR HY000: Operation REVOKE failed for 'mysql.sys'@'localhost''mysql.infoschema'@'localhost''mysql.session'@'localhost'

# TEST GRANT RESERVED ACCOUNTS
GRANT  ALL  ON  *.*  TO  'mysql.sys'@'localhost', 'mysql.infoschema'@'localhost', 'mysql.session'@'localhost';
ERROR HY000: Operation GRANT failed for 'mysql.sys'@'localhost''mysql.infoschema'@'localhost''mysql.session'@'localhost'
# ----------------------------------------------------------------------
# CHECK TENCENTROOT

# restart:--tencent-root-cnf=tmy.conf

# TEST RENAME RESERVED ACCOUNTS (TENCENTROOT)
RENAME USER 'mysql.sys'@'localhost' TO 'mysql.sys_bk'@'localhost';
Warnings:
Warning	4005	User 'mysql.sys'@'localhost' is referenced as a definer account in a view.
Warning	4005	User 'mysql.sys'@'localhost' is referenced as a definer account in a stored routine.
Warning	4005	User 'mysql.sys'@'localhost' is referenced as a definer account in a trigger.
RENAME USER 'mysql.infoschema'@'localhost' TO 'mysql.infoschema_bk'@'localhost';
RENAME USER 'mysql.session'@'localhost' TO 'mysql.session_bk'@'localhost';
SELECT user FROM mysql.user WHERE user LIKE 'mysql.%';
user
mysql.infoschema_bk
mysql.session_bk
mysql.sys_bk

# TEST CREATE RESERVED ACCOUNTS (TENCENTROOT)
CREATE USER 'mysql.sys'@'localhost', 'mysql.infoschema'@'localhost', 'mysql.session'@'localhost';
Warnings:
Warning	4005	User 'mysql.sys'@'localhost' is referenced as a definer account in a view.
Warning	4005	User 'mysql.sys'@'localhost' is referenced as a definer account in a stored routine.
Warning	4005	User 'mysql.sys'@'localhost' is referenced as a definer account in a trigger.
GRANT  ALL  ON  *.*  TO  'mysql.sys'@'localhost', 'mysql.infoschema'@'localhost', 'mysql.session'@'localhost';
SELECT user FROM mysql.user WHERE user LIKE 'mysql.%';
user
mysql.infoschema
mysql.infoschema_bk
mysql.session
mysql.session_bk
mysql.sys
mysql.sys_bk

# TEST ALTER RESERVED ACCOUNTS (TENCENTROOT)
ALTER USER 'mysql.sys'@'localhost', 'mysql.infoschema'@'localhost', 'mysql.session'@'localhost' COMMENT 'ALTER BY TENCENTROOT';
SELECT * FROM INFORMATION_SCHEMA.USER_ATTRIBUTES WHERE USER LIKE 'mysql.%';
USER	HOST	ATTRIBUTE
mysql.infoschema	localhost	{"comment": "ALTER BY TENCENTROOT"}
mysql.infoschema_bk	localhost	NULL
mysql.session	localhost	{"comment": "ALTER BY TENCENTROOT"}
mysql.session_bk	localhost	NULL
mysql.sys	localhost	{"comment": "ALTER BY TENCENTROOT"}
mysql.sys_bk	localhost	NULL


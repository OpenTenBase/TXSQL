--source include/have_log_bin.inc
--source include/have_binlog_format_row.inc
--source include/master-slave.inc
--source include/have_debug.inc

--echo #
--echo #  Prepare
--echo #

connect (con_root_master, 127.0.0.1, root, '', '', $MASTER_MYPORT);
--let $txsql_recycle_bin_enabled_default= `select @@txsql_recycle_bin_enabled`
--echo # open recycle bin on master
set global txsql_recycle_bin_enabled = on;

connect (con_root_slave, 127.0.0.1, root, '', '', $SLAVE_MYPORT);
--echo # open recycle bin on slave
set global txsql_recycle_bin_enabled = on;

--connection master 
create table t1(a int, b int);
create trigger trig after insert on t1 for each row insert into t1 set b=1;

--echo #
--echo # Run 
--echo #

--echo #
--echo # case1. rename table
--echo #

--connection master
rename table t1 to t2;
--replace_column 6 <CREATE_TIME>
show triggers;

--echo #
--echo # case2. drop triggers fail
--echo #

SET DEBUG= '+d, rb_execute_failure_alter_drop_triggers';

--error ER_RECYCLE_BIN_DROP_TRIGGERS_FAILURE
drop table t2;

--replace_column 6 <CREATE_TIME>
show triggers;

SET DEBUG= '-d, rb_execute_failure_alter_drop_triggers';

--echo #
--echo # case3. crash after drop triggers
--echo #

--connection master 
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SET DEBUG= '+d, rb_crash_alter_drop_triggers';

--error 2013
drop table t2;

--source include/wait_until_disconnected.inc

--enable_reconnect
--echo # Restart the master server
--let $rpl_server_number= 1
--source include/rpl_start_server.inc

--disable_reconnect

SET DEBUG= '-d, rb_crash_alter_drop_triggers';

--replace_column 6 <CREATE_TIME>
show triggers;

--echo #
--echo # case4. drop table with recycle_bin
--echo #

--disconnect con_root_slave
connect (con_root_slave, 127.0.0.1, root, '', '', $SLAVE_MYPORT);
--disconnect con_root_master
--connect (con_root_master, 127.0.0.1, root, '', '', $MASTER_MYPORT)

set global txsql_recycle_bin_enabled = on;

drop table t2;

--replace_column 6 <CREATE_TIME>
show triggers;

--sync_slave_with_master

--connection con_root_slave
--replace_column 6 <CREATE_TIME>
show triggers;

--echo #
--echo # case5. truncate table with recycle_bin
--echo #

--connection con_root_master
set global txsql_recycle_bin_enabled = on;

create table t3(a int, b int);
create trigger trig after insert on t3 for each row insert into t3 set b=1;

--error ER_RECYCLE_BIN_CAN_NOT_TRUNCATE_TABLE_WITH_TRIGGERS
truncate table t3;

--echo #
--echo # Cleanup 
--echo # 

--connection con_root_master
clear recycle_bin;

--connection con_root_slave
--eval set global txsql_recycle_bin_enabled=$txsql_recycle_bin_enabled_default


--connection con_root_master
--eval set global txsql_recycle_bin_enabled=$txsql_recycle_bin_enabled_default
drop table t3;

--source include/rpl_connection_master.inc
--source include/rpl_end.inc

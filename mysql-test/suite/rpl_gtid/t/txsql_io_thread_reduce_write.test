--source include/not_group_replication_plugin.inc
--source include/have_debug.inc
--source include/master-slave.inc

select @@global.gtid_mode;
set global gtid_mode = 'off_permissive';
set global gtid_mode = 'on_permissive';
set global gtid_mode = 'ON';
set gtid_next='automatic';

call mtr.add_suppression("Error reading relay log event for channel '': binlog truncated in the middle of event; consider out of disk space");
call mtr.add_suppression("Relay log read failure: Could not parse relay log event entry. The possible reasons are *");
call mtr.add_suppression("Error reading GTIDs from relaylog *");
call mtr.add_suppression("GTID_LOG_EVENT or ANONYMOUS_GTID_LOG_EVENT is not expected in an event stream in the middle of a DML *");
call mtr.add_suppression("An unexpected event sequence was detected by the IO thread while queuing the event received from master *");

#--source include/sync_slave_sql_with_master.inc
#--source include/stop_slave.inc

connection slave;
stop slave;
CHANGE MASTER TO MASTER_AUTO_POSITION= 1;
#show slave status;


connection master;
CREATE TABLE `t3` (
  `id` int  NOT NULL PRIMARY KEY AUTO_INCREMENT,
   info varchar(2000)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

begin;
insert into t3 values(0,repeat('a',1000));
insert into t3 values(0,repeat('a',1000));
insert into t3 values(0,repeat('a',1000));
insert into t3 values(0,repeat('a',1000));
insert into t3 values(0,repeat('a',1000));
insert into t3 values(0,repeat('a',1000));
insert into t3 values(0,repeat('a',1000));
insert into t3 values(0,repeat('a',1000));
commit;

select count(1) from t3;



connection slave;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.2.expect
set global debug="+d,check_have_write_partiton_relaylog";
#--enable_reconnect
start slave;
#--source include/start_slave.inc

--enable_reconnect
--source include/wait_until_disconnected.inc
--let $rpl_server_number= 2
--source include/rpl_start_server.inc
--disable_reconnect
--disable_warnings

--source include/start_slave.inc
start slave;
#show slave status ;

select sleep(3);
#now the slave will stoped(read partition relay log),re start
start slave;
#select now(),sleep(3);


connection master;
--source include/sync_slave_sql_with_master.inc

connection slave;
#select now(),sleep(10);
#--sleep 10
#show slave status ;
#show processlist;
#show master logs;

#show create table t3;
select count(1) from t3;
--enable_warnings


connection master;
drop table t3;

source include/rpl_end.inc;
set global gtid_mode = 'on_permissive';
set global gtid_mode = 'OFF_PERMISSIVE';

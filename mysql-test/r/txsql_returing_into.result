drop procedure if exists test_update_returing;
create procedure test_update_returing(
in arg_a int,
out err int,
out var_a int,
out var_b int,
out var_c varchar(100),
out var_b11 int
)
label:begin
declare exit HANDLER FOR NOT FOUND,SQLEXCEPTION
begin
set err = -1;
rollback;
end;
start transaction;
set err = 0;
update t1 set b = b + 1 where a = arg_a txsql_returning a,b,c into var_a,var_b,var_c;
update t1 set b = b + 1 where a = arg_a txsql_returning b+10 into @tmp_b;
select @tmp_b into var_b11;
if err = 0 then
commit;
end if;
end
$$
set @a = NULL;
set @b = NULL;
set @c = NULL;
set @err=0;
set @b11 = NULL;
call test_update_returing(2,@err,@a,@b,@c,@b11);
select @a,@b,@c,@b11;
@a	@b	@c	@b11
2	7	bcd	18
select * from t1;
a	b	c
1	4	abc
2	8	bcd
3	8	cde
4	10	def
begin;
select * from t1;
a	b	c
1	4	abc
2	8	bcd
3	8	cde
4	10	def
delete from t1 where a <= 2 txsql_returning a,b,c,a+b;
a	b	c	a+b
1	4	abc	5
2	8	bcd	10
rollback;
set @a = NULL;
set @b = NULL;
set @c = NULL;
set @d = NULL;
begin;
select * from t1;
a	b	c
1	4	abc
2	8	bcd
3	8	cde
4	10	def
delete from t1 limit 1 txsql_returning a,b,c,a+b;
a	b	c	a+b
1	4	abc	5
delete from t1 limit 1 txsql_returning a,b,c,a+b into @a,@b,@c,@d;
select @a,@b,@c,@d;
@a	@b	@c	@d
2	8	bcd	10
delete from t1 txsql_returning a,b,c,a+b into @a,@b,@c,@d;
ERROR 42000: Result consisted of more than one row
select found_rows();
found_rows()
1
rollback;
select  @a,@b,@c,@d;
@a	@b	@c	@d
3	8	cde	11
delete from t1 where a=10 txsql_returning a,b,c,a+b;
a	b	c	a+b
select found_rows();
found_rows()
0
drop procedure if exists test_delete_returing;
create procedure test_delete_returing(
in arg_a int,
out err int,
out var_a int,
out var_b int,
out var_c varchar(100),
out var_b11 int
)
label:begin
declare exit HANDLER FOR NOT FOUND,SQLEXCEPTION
begin
set err = -1;
rollback;
end;
start transaction;
set err = 0;
delete from t1  where a = arg_a txsql_returning a,b,c into var_a,var_b,var_c;
delete from t1  where a = arg_a + 1 txsql_returning b+10 into @tmp_b;
select @tmp_b into var_b11;
if err = 0 then
commit;
end if;
end
$$
select * from t1;
a	b	c
1	4	abc
2	8	bcd
3	8	cde
4	10	def
set @a = NULL;
set @b = NULL;
set @c = NULL;
set @err=0;
set @b11 = NULL;
call test_delete_returing(2,@err,@a,@b,@c,@b11);
select @a,@b,@c,@b11;
@a	@b	@c	@b11
2	8	bcd	18
select * from t1;
a	b	c
1	4	abc
4	10	def
set @a = NULL;
set @b = NULL;
set @c = NULL;
set @err=0;
set @b11 = NULL;
call test_delete_returing(3,@err,@a,@b,@c,@b11);
select @a,@b,@c,@b11;
@a	@b	@c	@b11
NULL	NULL	NULL	NULL
select * from t1;
a	b	c
1	4	abc
4	10	def
drop procedure test_update_returing;
drop procedure test_delete_returing;
drop table t1,t2;

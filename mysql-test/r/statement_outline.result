# 4. test table structure change, it's ok if add a column
#-----------------------------------------------------------
ALTER TABLE mysql.statement_outline_rules ADD col1 INT;
CALL dbms_admin.statement_outline_add_rule('outline_db', "SELECT /*+ ORDER_INDEX(t1 ind_1, ind_2) */ * FROM t1 WHERE col1 = 2 AND col2 = 'mysql'");
ID
#
CALL dbms_admin.statement_outline_flush_rules();
CALL dbms_admin.statement_outline_delete_rule(11111);
Warnings:
Warning	4142	Could not delete statement outline rule: "Rule 11111 is not found.".
ALTER TABLE mysql.statement_outline_rules DROP COLUMN col1;

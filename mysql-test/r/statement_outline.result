10.1 TDSQL subpartition basic
CREATE TABLE outline_db.t1_TDSQL_SUBp1(id INT AUTO_INCREMENT PRIMARY KEY,
col1 INT,
col2 VARCHAR(100),
KEY ind_1(col1),
KEY ind_2(col2));
INSERT INTO outline_db.t1_TDSQL_SUBp1 VALUES(1, 2, 'mysql');
CREATE TABLE outline_db.t3(a INT, b INT);
INSERT INTO outline_db.t3 values(1,1);

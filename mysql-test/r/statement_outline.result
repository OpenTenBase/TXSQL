CREATE DATABASE outline_db;
CREATE TABLE outline_db.t1(id INT AUTO_INCREMENT PRIMARY KEY,
col1 INT,
col2 VARCHAR(100),
KEY ind_1(col1),
KEY ind_2(col2));
CREATE TABLE outline_db.t2(id INT AUTO_INCREMENT PRIMARY KEY,
col1 INT,
col2 VARCHAR(100),
KEY ind_1(col1),
KEY ind_2(col2));
INSERT INTO outline_db.t1 VALUES(1, 2, 'mysql');
INSERT INTO outline_db.t2 VALUES(1, 2, 'mysql');
CREATE USER 'u1'@'%';
GRANT ALL PRIVILEGES ON outline_db.* to 'u1'@'%';
GRANT ALL PRIVILEGES ON mysql.* to 'u1'@'%';
#-----------------------------------------------------------
# 1. check the statement outline rules table structure
#-----------------------------------------------------------
DESC mysql.statement_outline_rules;
Field	Type	Null	Key	Default	Extra
id	int	NO	PRI	NULL	auto_increment
schema_name	varchar(64)	YES		NULL	
digest	varchar(64)	NO		NULL	
outline	json	NO		NULL	
enabled	enum('YES','NO')	NO		YES	
digest_text	varchar(5000)	YES		NULL	
#-----------------------------------------------------------

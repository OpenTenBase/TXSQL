Warnings:
Note	1003	/* select#1 */ select /*+ INDEX(`t1`@`select#1` `ind_1`) */ `outline_db`.`t1`.`id` AS `id`,`outline_db`.`t1`.`col1` AS `col1`,`outline_db`.`t1`.`col2` AS `col2` from `outline_db`.`t1` where ((`outline_db`.`t1`.`col2` = 'mysql') and (`outline_db`.`t1`.`col1` = 2)) order by `outline_db`.`t1`.`col1`
DELETE FROM mysql.statement_outline_rules;
COMMIT;

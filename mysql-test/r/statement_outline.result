CALL dbms_admin.statement_outline_show_rules();
ID	SCHEMA	DIGEST	ENABLED	HITS	OUTLINE	DIGEST_TEXT	HAS_APPLY_FAILURE
#	outline_db	b4369611be7ab2d27c85897632576a04bc08f50b928a1d735b62d0a140628c4c	YES	1	[{"hint": "/*+ INDEX(`t1`@`select#1` `ind_2`) */ ", "select_number": 1}]	select /*+ INDEX(`t1`@`select#1` `ind_2`) */ * from `outline_db`.`t1` where ((`t1`.`col1` = ?) and (`t1`.`col2` = ?))	0
SET @col1 = 1;
SET @col2 = 'mysql';
EXECUTE stmt USING @col1, @col2;
id	col1	col2
CALL dbms_admin.statement_outline_show_rules();
ID	SCHEMA	DIGEST	ENABLED	HITS	OUTLINE	DIGEST_TEXT	HAS_APPLY_FAILURE
#	outline_db	b4369611be7ab2d27c85897632576a04bc08f50b928a1d735b62d0a140628c4c	YES	1	[{"hint": "/*+ INDEX(`t1`@`select#1` `ind_2`) */ ", "select_number": 1}]	select /*+ INDEX(`t1`@`select#1` `ind_2`) */ * from `outline_db`.`t1` where ((`t1`.`col1` = ?) and (`t1`.`col2` = ?))	0

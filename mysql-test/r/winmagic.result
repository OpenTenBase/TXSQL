SET optimizer_switch='winmagic=default';
SET optimizer_switch='winmagic=on';
#
# 1. Tests for Check valid on multiple situations.
#
# situation.1 t2.b < 10 is not same as t2.b < 1.
explain format=tree select sum(t2.a) from t1, t2 where t1.a = t2.a and t2.a > 1 and t2.b < 10 and t2.c > 
(select max(t2.c) from t2 where t1.a = t2.a and t2.a > 1 and t2.b < 1);
EXPLAIN
-> Aggregate: sum(t2.a)  (cost=1.70 rows=1)
    -> Filter: (t2.c > (select #2))  (cost=1.60 rows=1)
        -> Inner hash join (t1.a = t2.a)  (cost=1.60 rows=1)
            -> Table scan on t1  (cost=0.35 rows=6)
            -> Hash
                -> Filter: ((t2.a > 1) and (t2.b < 10))  (cost=0.75 rows=1)
                    -> Table scan on t2  (cost=0.75 rows=5)
        -> Select #2 (subquery in condition; dependent)
            -> Aggregate: max(t2.c)  (cost=0.85 rows=1)
                -> Filter: ((t1.a = t2.a) and (t2.a > 1) and (t2.b < 1))  (cost=0.75 rows=1)
                    -> Table scan on t2  (cost=0.75 rows=5)

Warnings:
Note	1276	Field or reference 'tpch.t1.a' of SELECT #2 was resolved in SELECT #1
explain format=tree select sum(t2.a) from t1, t2 where t1.a = t2.a and t2.a > 1 and t2.b < 10 and t2.c > 
(select max(t2.c) from t2 where t1.a = t2.a and t2.a > 100 and t2.b < 3);
EXPLAIN
-> Aggregate: sum(t2.a)  (cost=1.70 rows=1)
    -> Filter: (t2.c > (select #2))  (cost=1.60 rows=1)
        -> Inner hash join (t1.a = t2.a)  (cost=1.60 rows=1)
            -> Table scan on t1  (cost=0.35 rows=6)
            -> Hash
                -> Filter: ((t2.a > 1) and (t2.b < 10))  (cost=0.75 rows=1)
                    -> Table scan on t2  (cost=0.75 rows=5)
        -> Select #2 (subquery in condition; dependent)
            -> Aggregate: max(t2.c)  (cost=0.85 rows=1)
                -> Filter: ((t1.a = t2.a) and (t2.a > 100) and (t2.b < 3))  (cost=0.75 rows=1)
                    -> Table scan on t2  (cost=0.75 rows=5)

Warnings:
Note	1276	Field or reference 'tpch.t1.a' of SELECT #2 was resolved in SELECT #1
# situation.2 inner query block more condition.
explain format=tree select sum(t2.a) from t1, t2 where t1.a = t2.a and t1.b = t2.b and t2.a > 1 and t2.c < 
(select avg(t2.c) from t2 where t1.a = t2.a and t1.b = t2.b and t2.a > 1 and t2.c < 100);
EXPLAIN
-> Aggregate: sum(t2.a)  (cost=2.17 rows=1)
    -> Filter: (t2.c < (select #2))  (cost=2.00 rows=2)
        -> Inner hash join (t1.b = t2.b), (t1.a = t2.a)  (cost=2.00 rows=2)
            -> Table scan on t1  (cost=0.21 rows=6)
            -> Hash
                -> Filter: (t2.a > 1)  (cost=0.75 rows=2)
                    -> Table scan on t2  (cost=0.75 rows=5)
        -> Select #2 (subquery in condition; dependent)
            -> Aggregate: avg(t2.c)  (cost=0.85 rows=1)
                -> Filter: ((t1.a = t2.a) and (t1.b = t2.b) and (t2.a > 1) and (t2.c < 100))  (cost=0.75 rows=1)
                    -> Table scan on t2  (cost=0.75 rows=5)

Warnings:
Note	1276	Field or reference 'tpch.t1.a' of SELECT #2 was resolved in SELECT #1
Note	1276	Field or reference 'tpch.t1.b' of SELECT #2 was resolved in SELECT #1

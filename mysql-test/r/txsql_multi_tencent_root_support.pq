# 5.base test

user1=tencentroot, user2=cdb_dumper, user3=cdb_ha

#1.test usage and gramar

#1.1 tencent_root_user not exist
tencentroot 'tencentrootcdb_dumpercdb_ha' set global tencent_root_whitelist='196.128.0.123';
ERROR HY000: The tencentroot user(tencentrootcdb_dumpercdb_ha) in the set statement does not exist.

#1.2 gramar error
tencent 'tencentroot' set global tencent_root_whitelist='196.128.0.123';
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'tencent 'tencentroot' set global tencent_root_whitelist='196.128.0.123'' at line 1

#1.3 test show tencentroot
#don't show anything for not exist user
show tencentroot 'tencentrootcdb_dumpercdb_ha';
tencent_root_user	tencent_root_whitelist	tencent_root_limit	tencent_root_count
show tencentroot '%';
tencent_root_user	tencent_root_whitelist	tencent_root_limit	tencent_root_count
tencentroot	localhost;127.0.0.1;::1	60	###
cdb_dumper	localhost;127.0.0.1;::1	60	###
cdb_ha	localhost;127.0.0.1;::1	60	###
show tencentroot;
tencent_root_user	tencent_root_whitelist	tencent_root_limit	tencent_root_count
tencentroot	localhost;127.0.0.1;::1	60	1
show tencentroot 'tencentroot';
tencent_root_user	tencent_root_whitelist	tencent_root_limit	tencent_root_count
tencentroot	localhost;127.0.0.1;::1	60	1
show tencentroot `cdb_dumper`;
tencent_root_user	tencent_root_whitelist	tencent_root_limit	tencent_root_count
cdb_dumper	localhost;127.0.0.1;::1	60	0
show tencentroot "cdb_ha";
tencent_root_user	tencent_root_whitelist	tencent_root_limit	tencent_root_count
cdb_ha	localhost;127.0.0.1;::1	60	0

#1.4 test tencentroot set

tencentroot set global tencent_root_whitelist='196.128.0.123';
tencentroot `tencentroot` set global tencent_root_whitelist='196.128.0.123';
show variables like 'tencent_root_whitelist';
Variable_name	Value
tencent_root_whitelist	localhost;127.0.0.1;::1;196.128.0.123
# reset
tencentroot set global tencent_root_whitelist='localhost;127.0.0.1;::1';

#2. test whitelist


#2.1 Automatic compensation 127.0.0.1; localhost; :: 1
tencentroot 'tencentroot' set global tencent_root_whitelist='196.128.0.1';
show variables like 'tencent_root_whitelist';
Variable_name	Value
tencent_root_whitelist	localhost;127.0.0.1;::1;196.128.0.1
embedded_tencent_root=ON
tencent_root_user=tencentroot#cdb_dumper#cdb_ha
tencent_root_pwd=##
tencent_root_whitelist=localhost;127.0.0.1;::1;196.128.0.1#localhost;127.0.0.1;::1#localhost;127.0.0.1;::1
tencent_root_limit=60#60#60
tencentroot 'tencentroot' set global tencent_root_whitelist='localhost;127.0.0.1;::1';

#2.2 modify other users whitelist
tencentroot 'cdb_dumper' set global tencent_root_whitelist='196.128.0.1';
show variables like 'tencent_root_whitelist';
Variable_name	Value
tencent_root_whitelist	localhost;127.0.0.1;::1
show tencentroot;
tencent_root_user	tencent_root_whitelist	tencent_root_limit	tencent_root_count
tencentroot	localhost;127.0.0.1;::1	60	1
tencentroot 'cdb_dumper' set global tencent_root_whitelist='localhost;127.0.0.1;::1';

#2.3 check the validity of IP address
tencentroot 'tencentroot' set global tencent_root_whitelist='196.128.0.257';
ERROR 42000: Variable 'tencent_root_whitelist' can't be set to the value of '196.128.0.257'
tencentroot 'tencentroot' set global tencent_root_whitelist='196.128.0.1;;';
ERROR 42000: Variable 'tencent_root_whitelist' can't be set to the value of '196.128.0.1;;'
tencentroot 'tencentroot' set global tencent_root_whitelist=NULL;
ERROR 42000: Variable 'tencent_root_whitelist' can't be set to the value of 'NULL'


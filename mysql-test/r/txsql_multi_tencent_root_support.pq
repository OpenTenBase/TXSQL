#reset
tencentroot 'tencentroot' set global tencent_root_whitelist='localhost;127.0.0.1;::1';

#3. test limit

#3.1 test format
tencentroot 'tencentroot' set global tencent_root_limit=0x2;
ERROR 42000: Incorrect argument type to variable 'tencent_root_limit'
tencentroot 'tencentroot' set global tencent_root_limit=23a;
ERROR 42000: Incorrect argument type to variable 'tencent_root_limit'
#Octal digits will be considered as decimal
tencentroot 'tencentroot' set global tencent_root_limit=09;
tencentroot 'tencentroot' set global tencent_root_limit=60;

#3.2 test link num
tencentroot 'cdb_dumper' set global tencent_root_limit=3;
connect(localhost,cdb_dumper,,test,PORT,SOCKET);
ERROR HY000: The count of connection for this user exceeds the user tencent_root_limit (current value: 3).
tencentroot 'cdb_dumper' set global tencent_root_limit=60;

#3.3 test upper limit and lower limit
limit1=60, limit2=60, limit3=60
set global extra_max_connections= 179;
ERROR 42000: Variable 'extra_max_connections' can't be set to the value of '179'
set global extra_max_connections= 180;
tencentroot 'tencentroot' set global tencent_root_limit= 61;
ERROR 42000: Variable 'tencent_root_limit' can't be set to the value of '61'
user1=cdb_dumper, user2=cdb_ha, user3=tencentroot

#1.test usage and gramar

#1.1 tencent_root_user not exist
tencentroot 'cdb_dumpercdb_hatencentroot' set global tencent_root_whitelist='196.128.0.123';
ERROR HY000: The tencentroot user(cdb_dumpercdb_hatencentroot) in the set statement does not exist.

#1.2 gramar error
tencent 'cdb_dumper' set global tencent_root_whitelist='196.128.0.123';
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'tencent 'cdb_dumper' set global tencent_root_whitelist='196.128.0.123'' at line 1

#1.3 test show tencentroot
#don't show anything for not exist user
show tencentroot 'cdb_dumpercdb_hatencentroot';
tencent_root_user	tencent_root_whitelist	tencent_root_limit	tencent_root_count
show tencentroot '%';
tencent_root_user	tencent_root_whitelist	tencent_root_limit	tencent_root_count
tencentroot	localhost;127.0.0.1;::1	60	###
cdb_dumper	localhost;127.0.0.1;::1	60	###
cdb_ha	localhost;127.0.0.1;::1	60	###
show tencentroot;
tencent_root_user	tencent_root_whitelist	tencent_root_limit	tencent_root_count
cdb_dumper	localhost;127.0.0.1;::1	60	1
show tencentroot 'cdb_dumper';
tencent_root_user	tencent_root_whitelist	tencent_root_limit	tencent_root_count
cdb_dumper	localhost;127.0.0.1;::1	60	1
show tencentroot `cdb_ha`;
tencent_root_user	tencent_root_whitelist	tencent_root_limit	tencent_root_count
cdb_ha	localhost;127.0.0.1;::1	60	0
show tencentroot "tencentroot";
tencent_root_user	tencent_root_whitelist	tencent_root_limit	tencent_root_count
tencentroot	localhost;127.0.0.1;::1	60	0

#1.4 test tencentroot set

tencentroot set global tencent_root_whitelist='196.128.0.123';
tencentroot `cdb_dumper` set global tencent_root_whitelist='196.128.0.123';
show variables like 'tencent_root_whitelist';
Variable_name	Value
tencent_root_whitelist	localhost;127.0.0.1;::1;196.128.0.123
# reset
tencentroot set global tencent_root_whitelist='localhost;127.0.0.1;::1';

#2. test whitelist


#2.1 Automatic compensation 127.0.0.1; localhost; :: 1
tencentroot 'cdb_dumper' set global tencent_root_whitelist='196.128.0.1';
show variables like 'tencent_root_whitelist';
Variable_name	Value
tencent_root_whitelist	localhost;127.0.0.1;::1;196.128.0.1
embedded_tencent_root=ON
tencent_root_user=tencentroot#cdb_dumper#cdb_ha
tencent_root_pwd=##
tencent_root_whitelist=localhost;127.0.0.1;::1#localhost;127.0.0.1;::1;196.128.0.1#localhost;127.0.0.1;::1
tencent_root_limit=60#60#60
tencentroot 'cdb_dumper' set global tencent_root_whitelist='localhost;127.0.0.1;::1';

#2.2 modify other users whitelist
tencentroot 'cdb_ha' set global tencent_root_whitelist='196.128.0.1';
show variables like 'tencent_root_whitelist';
Variable_name	Value
tencent_root_whitelist	localhost;127.0.0.1;::1
show tencentroot;
tencent_root_user	tencent_root_whitelist	tencent_root_limit	tencent_root_count
cdb_dumper	localhost;127.0.0.1;::1	60	1
tencentroot 'cdb_ha' set global tencent_root_whitelist='localhost;127.0.0.1;::1';


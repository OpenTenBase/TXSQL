# 1.test extra port

select '13009';
13009
13009
connect(127.0.0.1,root,,test,13009,SOCKET);
ERROR HY000: Ordinary users are not allowed to log in to admin_port.

# 2.test new syntax for non-tencentroot user

tencentroot 'tencentroot' set global tencent_root_whitelist='196.128.0.123';
ERROR 42000: This version of MySQL doesn't yet support 'tencentroot set'
show tencentroot 'tencentroot';
ERROR 42000: This version of MySQL doesn't yet support 'show tencentroot'
show tencentroot '%';
ERROR 42000: This version of MySQL doesn't yet support 'show tencentroot'
show tencentroot;
ERROR 42000: This version of MySQL doesn't yet support 'show tencentroot'

# 3.test fake tencentroot

flush privileges;
create user 'tencentroot'@'%' identified by "";
grant all PRIVILEGES on *.* to 'tencentroot'@'%' with grant option;
flush privileges;
show variables like 'tencent_root_user';
Variable_name	Value
tencent_root_user	tencentroot
drop user 'tencentroot'@'%';
flush privileges;


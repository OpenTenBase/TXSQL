#reset
tencentroot 'cdb_dumper' set global tencent_root_whitelist='localhost;127.0.0.1;::1';

#3. test limit

#3.1 test format
tencentroot 'cdb_dumper' set global tencent_root_limit=0x2;
ERROR 42000: Incorrect argument type to variable 'tencent_root_limit'
tencentroot 'cdb_dumper' set global tencent_root_limit=23a;
ERROR 42000: Incorrect argument type to variable 'tencent_root_limit'
#Octal digits will be considered as decimal
tencentroot 'cdb_dumper' set global tencent_root_limit=09;
tencentroot 'cdb_dumper' set global tencent_root_limit=60;

#3.2 test link num
tencentroot 'cdb_ha' set global tencent_root_limit=3;
connect(localhost,cdb_ha,,test,PORT,SOCKET);
ERROR HY000: The count of connection for this user exceeds the user tencent_root_limit (current value: 3).
tencentroot 'cdb_ha' set global tencent_root_limit=60;

#3.3 test upper limit and lower limit
limit1=60, limit2=60, limit3=60
set global extra_max_connections= 179;
ERROR 42000: Variable 'extra_max_connections' can't be set to the value of '179'
set global extra_max_connections= 180;
tencentroot 'cdb_dumper' set global tencent_root_limit= 61;
ERROR 42000: Variable 'tencent_root_limit' can't be set to the value of '61'

# 6.think of tencentrooot as a non-reserved keyword

create table tencentroot(tencentroot int);
create user tencentroot;
drop table tencentroot;
drop user tencentroot;
flush privileges;

#7.test parse tmy.conf error

# server is down

#7.1 tencent root user parse failure

#7.1.1 tencent root user length is 0

# restart server with tencent root user length is 0 in tmy.conf
DATE_TIME [Note] [MY-000000] [Server] TXSQL: tencent root user parse failure, please check username ("") is between 1 and 64 (including 1 and 64).

#7.1.2 tencent root user length is 65

# restart server with tencent root user length is 65 in tmy.conf
DATE_TIME [Note] [MY-000000] [Server] TXSQL: tencent root user parse failure, please check username ("1234567890-1234567890-1234567890-1234567890-1234567890-1234567890") is between 1 and 64 (including 1 and 64).

#7.2 tencent root pwd parse failure

#7.2.1 tencent root pwd format error

# restart server with tencent root pwd length is 17 in tmy.conf
DATE_TIME [Note] [MY-000000] [Server] TXSQL: tencent root pwd parse failure, please check whether the password length of each user is between 0 and 16 (including 0 and 16).

#7.2.2 tencent root pwd item greater than user num

# restart server with tencent root pwd greater than user num
DATE_TIME [Note] [MY-000000] [Server] TXSQL: tencent root pwd parse failure, first check whether each user has a corresponding password configuration item, that is, the password item number (4) and user item number (3) separated by '#' are equal.

#7.3 tencent root whitelist parse failure

#7.3.1 tencent root whitelist ip format error

# restart server with tencent root whitelist ip is 127.0.0.256 in tmy.conf
DATE_TIME [Note] [MY-000000] [Server] TXSQL: tencent root whitelist parse failure, ip: 127.0.0.256, error: invalid ip address.

#7.3.2 tencent root whitelist item error

# restart server with tencent root whitelist item less user num
DATE_TIME [Note] [MY-000000] [Server] TXSQL: tencent root whitelist parse failure, first check whether each user has a corresponding whitelist configuration item, that is, the whitelist item number (2) and user item (3) separated by '#' are equal.

#7.4 tencent root limit parse failure

#7.4.1 tencent root limit format error

# restart server with tencent root limit is -20 in tmy.conf
DATE_TIME [Note] [MY-000000] [Server] TXSQL: tencent root limit parse failure, please check that the tencent root limit of each user is a valid decimal number.

#7.4.2 the sum of tencent root limit greater than extra_max_connections

# restart server with the sum of tencent root limit in tmy.conf greater than extra_max_connections
DATE_TIME [Note] [MY-000000] [Server] TXSQL: tencent root limit parse failure,  please check that the sum (60) of the tencent root limit of all users is less than or equal to the system variable extra_max_connnections (59).

#7.4.3 the item of tencent root limit less than user num

# restart server with the item num of tencent root limit less than user num
DATE_TIME [Note] [MY-000000] [Server] TXSQL: tencent root limit parse failure, first check whether each user has a corresponding limit configuration item, that is, the limit item number (2) and user item number (3) separated by '#' are equal.

#7.5 test old tmy.conf

# restart server.
# link the tencentroot

# test set tencent_root_whitelist
set global tencent_root_whitelist='127.0.0.2;127.0.0.3;127.0.0.4';
show variables like 'tencent_root_whitelist';
Variable_name	Value
tencent_root_whitelist	localhost;127.0.0.1;::1;127.0.0.2;127.0.0.3;127.0.0.4
set @@global.tencent_root_whitelist= concat(@@global.tencent_root_whitelist,';','127.0.0.2;127.0.0.3;127.0.0.4');
select @@tencent_root_whitelist;
@@tencent_root_whitelist
localhost;127.0.0.1;::1;127.0.0.2;127.0.0.3;127.0.0.4

# test set tencent_root_limit
set global tencent_root_limit=3;
ERROR HY000: The old version of tmy.conf does not allow tencent_root_limit to be set.
show variables like 'tencent_root_limit';
Variable_name	Value
tencent_root_limit	
select @@tencent_root_limit;
@@tencent_root_limit


# shut server down
# Server is down
#
# 8. test tencentroot `user` have no effect on system var
#

# restart server.
tencentroot `tencentroot` set global max_connections= 10000;
show variables like 'max_connections';
Variable_name	Value
max_connections	10000
set global max_connections= 151;
#
# 9. test tencent root user conut problem
#
set global tencent_root_limit= 3;
connect(localhost,cdb_dumper,abc,test,PORT,SOCKET);
ERROR PORT: Access denied for user 'cdb_dumper'@'localhost' (using password: YES)
show variables like 'tencent_root_connected';
Variable_name	Value
tencent_root_connected	2
connect(localhost,cdb_dumper,abc,test,PORT,SOCKET);
ERROR PORT: Access denied for user 'cdb_dumper'@'localhost' (using password: YES)
show variables like 'tencent_root_connected';
Variable_name	Value
tencent_root_connected	2
connect(localhost,cdb_dumper,abc,test,PORT,SOCKET);
ERROR PORT: Access denied for user 'cdb_dumper'@'localhost' (using password: YES)
show variables like 'tencent_root_connected';
Variable_name	Value
tencent_root_connected	2
set global tencent_root_limit= 60;
#
# 10. test tencent root preempts the count of links of ordinary users
#
#
# 10.1. test tencent root not affect normal user
flush privileges;
create user 'test_user'@'%' identified by "";
flush privileges;
set global max_connections= 1;
connect(localhost,test_user,,test,PORT,SOCKET);
ERROR PORT: Too many connections
show processlist;
Id	User	Host	db	Command	Time	State	Info
###	event_scheduler	localhost	NULL	###	###	###	###
###	root	localhost	test	###	###	###	###
###	test_user	localhost	test	###	###	###	###
set global max_connections= 151;
drop user 'test_user'@'%';


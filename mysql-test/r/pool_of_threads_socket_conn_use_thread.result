# restart:--thread-handling=pool-of-threads --thread-pool-size=2 --thread-pool-max-threads=2000 --admin-address=127.0.0.1 --admin-port=ADMIN_PORT --loose-skip-mysqlx
call mtr.add_suppression("Threadpool could not create additional thread to handle queries");
SELECT 'connect normal connection ok';
connect normal connection ok
connect normal connection ok
show global status like 'Threads_connected';
